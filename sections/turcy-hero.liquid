{{ 'turcy-home.css' | asset_url | stylesheet_tag }}

<section class="turcy-section turcy-hero" id="TurcyHero-{{ section.id }}">
  <div class="turcy-shell turcy-hero__grid">
    <div class="turcy-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="turcy-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="turcy-display">{{ section.settings.heading | newline_to_br }}</h1>
      {% if section.settings.text != blank %}<div class="turcy-lead rte">{{ section.settings.text }}</div>{% endif %}
      <div class="turcy-hero__actions">
        {% if section.settings.primary_label != blank %}<a class="turcy-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }} <span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="turcy-button turcy-button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
      {% if section.settings.proof != blank %}
        <div class="turcy-hero__proof"><span class="turcy-stars" aria-label="Five stars">★★★★★</span><span>{{ section.settings.proof }}</span></div>
      {% endif %}
    </div>
    <div class="turcy-hero__visual">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'turcy-hero__image', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 1051px) 48vw, 90vw', loading: 'eager', fetchpriority: 'high' }}
      {% else %}
        <img class="turcy-hero__image" src="{{ 'turcy-serum.jpg' | asset_url }}" alt="Turcy skincare concept" width="1200" height="1500" fetchpriority="high">
      {% endif %}
      {% if section.settings.note_one_title != blank %}<div class="turcy-float turcy-float--one"><strong>{{ section.settings.note_one_title }}</strong><span>{{ section.settings.note_one_text }}</span></div>{% endif %}
      {% if section.settings.note_two_title != blank %}<div class="turcy-float turcy-float--two"><strong>{{ section.settings.note_two_title }}</strong><span>{{ section.settings.note_two_text }}</span></div>{% endif %}
      {% if section.settings.orbit_text != blank %}<div class="turcy-hero__orbit">{{ section.settings.orbit_text }}</div>{% endif %}
    </div>
  </div>
</section>

{% if section.blocks.size > 0 %}
  <div class="turcy-section turcy-usp">
    <div class="turcy-shell turcy-usp__grid">
      {% for block in section.blocks %}
        <div class="turcy-usp__item" {{ block.shopify_attributes }}>
          <span class="turcy-usp__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Turcy hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Thoughtful skin + hair care" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Care that fits\nreal life." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Focused essentials for cleansing, brightening, hydration, sun care and hair wellness—made to keep your routine clear and consistent.</p>" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop all products" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Build your routine" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "proof", "label": "Proof text", "default": "Everyday essentials at accessible prices" },
    { "type": "text", "id": "note_one_title", "label": "First note title", "default": "Targeted, not complicated" },
    { "type": "text", "id": "note_one_text", "label": "First note text", "default": "Familiar actives for practical daily routines." },
    { "type": "text", "id": "note_two_title", "label": "Second note title", "default": "Made for consistency" },
    { "type": "text", "id": "note_two_text", "label": "Second note text", "default": "Simple formats that are easy to keep using." },
    { "type": "text", "id": "orbit_text", "label": "Round label", "default": "Skin • Hair • Everyday care" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon or letters", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Focused formulas" },
        { "type": "text", "id": "text", "label": "Text", "default": "Routine-friendly essentials" }
      ]
    }
  ],
  "presets": [{ "name": "Turcy hero", "blocks": [{ "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }, { "type": "highlight" }] }]
}
{% endschema %}
