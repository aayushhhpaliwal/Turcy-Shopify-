{% comment %}
  ENICA: Brand Testimonials - Premium Fixed
  - No overlap issue
  - Better desktop spacing
  - Better mobile slider
  - Premium cards
  - Proper arrows position
  - Stable equal height layout
{% endcomment %}

<section id="enica-testi-{{ section.id }}" class="enica-testi">
  <div class="page-width">
    <div class="enica-testi__head">
      {% if section.settings.label != blank %}
        <div class="enica-testi__label">{{ section.settings.label }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="enica-testi__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="enica-testi__sub">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="enica-testi__slider" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_interval }}">
        <button class="enica-testi__nav enica-testi__nav--prev" type="button" aria-label="Previous testimonial">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 19.5L8 12l7.5-7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="enica-testi__viewport" role="region" aria-label="Testimonials slider" tabindex="0">
          <div class="enica-testi__track">
            {% for block in section.blocks %}
              <article class="enica-testi__card" {{ block.shopify_attributes }}>
                <div class="enica-testi__top">
                  <div class="enica-testi__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                    {% assign r = block.settings.rating | plus: 0 %}
                    {% for i in (1..5) %}
                      <span class="enica-testi__star {% if i <= r %}is-fill{% endif %}">★</span>
                    {% endfor %}
                  </div>

                  {% if block.settings.tag != blank %}
                    <span class="enica-testi__tag">{{ block.settings.tag }}</span>
                  {% endif %}
                </div>

                {% if block.settings.title != blank %}
                  <h3 class="enica-testi__cardTitle">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="enica-testi__text">{{ block.settings.text }}</div>
                {% endif %}

                <div class="enica-testi__meta">
                  <div class="enica-testi__avatar" aria-hidden="true">
                    {{ block.settings.name | slice: 0, 1 | upcase }}
                  </div>

                  <div class="enica-testi__who">
                    {% if block.settings.name != blank %}
                      <div class="enica-testi__name">{{ block.settings.name }}</div>
                    {% endif %}
                    {% if block.settings.location != blank %}
                      <div class="enica-testi__loc">{{ block.settings.location }}</div>
                    {% endif %}
                  </div>

                  {% if block.settings.verified %}
                    <div class="enica-testi__verified" aria-label="Verified buyer">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Verified
                    </div>
                  {% endif %}
                </div>
              </article>
            {% endfor %}
          </div>
        </div>

        <button class="enica-testi__nav enica-testi__nav--next" type="button" aria-label="Next testimonial">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5L16 12l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="enica-testi__dots" aria-label="Slider pagination"></div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #enica-testi-{{ section.id }}{
    --h2:#3E1F3F;
    --h3:#6B5A6E;
    --label:#8E3F79;

    --bg: {{ section.settings.bg }};
    --card: {{ section.settings.card }};
    --text: {{ section.settings.text }};
    --muted: {{ section.settings.muted }};

    --border: rgba(62,31,63,.12);
    --shadow: 0 16px 34px rgba(18, 10, 20, .08);

    --radius: 20px;
    --gap: 18px;
    --pad: {{ section.settings.section_padding }}px;

    --nav-size: 48px;
    --edge-space: 18px;
    --card-min-height: 270px;

    background: var(--bg);
    padding: var(--pad) 0;
    position: relative;
    overflow: hidden;
  }

  #enica-testi-{{ section.id }} .page-width{
    position: relative;
  }

  #enica-testi-{{ section.id }} .enica-testi__head{
    text-align: center;
    max-width: 860px;
    margin: 0 auto 28px;
    position: relative;
    z-index: 2;
  }

  #enica-testi-{{ section.id }} .enica-testi__label{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgb(226 226 226);
    color: #111111;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .02em;
    margin-bottom: 12px;
  }

  #enica-testi-{{ section.id }} .enica-testi__title{
    margin: 0 0 10px;
    color: #000;
    font-size: clamp(28px, 3vw, 35px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  #enica-testi-{{ section.id }} .enica-testi__sub{
    margin: 0 auto;
    max-width: 720px;
    color: #000;
    font-size: 15px;
    line-height: 1.7;
  }

  #enica-testi-{{ section.id }} .enica-testi__slider{
    position: relative;
    z-index: 1;
    padding: 0 28px;
  }

  #enica-testi-{{ section.id }} .enica-testi__slider::before,
  #enica-testi-{{ section.id }} .enica-testi__slider::after{
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 56px;
    z-index: 2;
    pointer-events: none;
  }

  #enica-testi-{{ section.id }} .enica-testi__slider::before{
    left: 28px;
    background: linear-gradient(90deg, var(--bg) 0%, rgba(248,246,249,0) 100%);
  }

  #enica-testi-{{ section.id }} .enica-testi__slider::after{
    right: 28px;
    background: linear-gradient(270deg, var(--bg) 0%, rgba(248,246,249,0) 100%);
  }

  #enica-testi-{{ section.id }} .enica-testi__viewport{
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 8px 0 18px;
    cursor: grab;
  }

  #enica-testi-{{ section.id }} .enica-testi__viewport::-webkit-scrollbar{
    display: none;
  }

  #enica-testi-{{ section.id }} .enica-testi__viewport.is-dragging{
    cursor: grabbing;
  }

  #enica-testi-{{ section.id }} .enica-testi__track{
    display: grid;
    grid-auto-flow: column;
    gap: var(--gap);
    grid-auto-columns: calc((100% - (var(--gap) * 3)) / 4);
    align-items: stretch;
  }

  #enica-testi-{{ section.id }} .enica-testi__card{
    position: relative;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 18px 18px 16px;
    min-height: var(--card-min-height);
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }

  #enica-testi-{{ section.id }} .enica-testi__card:hover{
    transform: translateY(-4px);
    box-shadow: 0 22px 42px rgba(18, 10, 20, .12);
    border-color: rgba(142,63,121,.18);
  }

  #enica-testi-{{ section.id }} .enica-testi__card::before{
    content: "";
    position: absolute;
    right: -70px;
    top: -70px;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgb(233 233 233 / 77%), #6b6b6b03 68%);
    pointer-events: none;
  }

  #enica-testi-{{ section.id }} .enica-testi__top{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  #enica-testi-{{ section.id }} .enica-testi__stars{
    display: flex;
    gap: 2px;
    font-size: 14px;
    line-height: 1;
    flex-wrap: nowrap;
  }

  #enica-testi-{{ section.id }} .enica-testi__star{
    color: rgba(142,63,121,.20);
  }

  #enica-testi-{{ section.id }} .enica-testi__star.is-fill{
    color: #000000ff;
  }

  #enica-testi-{{ section.id }} .enica-testi__tag{
    font-size: 12px;
    font-weight: 800;
    color: #000;
    background: rgb(226 226 226);
    border: 1px solid rgb(157 157 157);
    padding: 6px 10px;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  #enica-testi-{{ section.id }} .enica-testi__cardTitle{
    margin: 0 0 10px;
    color: #000;
    font-size: 17px;
    font-weight: 900;
    line-height: 1.3;
  }

  #enica-testi-{{ section.id }} .enica-testi__text{
    color: var(--text);
    font-size: 14px;
    line-height: 1.72;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  #enica-testi-{{ section.id }} .enica-testi__meta{
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed rgba(62,31,63,.16);
  }

  #enica-testi-{{ section.id }} .enica-testi__avatar{
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgb(0 0 0 / 22%), rgb(0 0 0 / 14%));
    color: var(--h2);
    display: grid;
    place-items: center;
    font-weight: 900;
    font-size: 18px;
    flex: 0 0 42px;
  }

  #enica-testi-{{ section.id }} .enica-testi__who{
    min-width: 0;
  }

  #enica-testi-{{ section.id }} .enica-testi__name{
    color: #000;
    font-size: 14px;
    font-weight: 900;
    line-height: 1.2;
  }

  #enica-testi-{{ section.id }} .enica-testi__loc{
    margin-top: 2px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.2;
  }

  #enica-testi-{{ section.id }} .enica-testi__verified{
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(31,122,74,.10);
    border: 1px solid rgba(31,122,74,.18);
    color: #1F7A4A;
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
    flex-shrink: 0;
  }

  #enica-testi-{{ section.id }} .enica-testi__verified svg{
    width: 15px;
    height: 15px;
  }

  #enica-testi-{{ section.id }} .enica-testi__nav{
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--nav-size);
    height: var(--nav-size);
    border: 1px solid rgba(62,31,63,.16);
    border-radius: 999px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 14px 28px rgba(0,0,0,.10);
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 4;
    transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
  }

  #enica-testi-{{ section.id }} .enica-testi__nav:hover{
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 18px 34px rgba(0,0,0,.14);
  }

  #enica-testi-{{ section.id }} .enica-testi__nav svg{
    width: 18px;
    height: 18px;
    color: var(--h2);
  }

  #enica-testi-{{ section.id }} .enica-testi__nav--prev{
    left: 0;
  }

  #enica-testi-{{ section.id }} .enica-testi__nav--next{
    right: 0;
  }

  #enica-testi-{{ section.id }} .enica-testi__dots{
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
  }

  #enica-testi-{{ section.id }} .enica-testi__dot{
    width: 8px;
    height: 8px;
    border: 0;
    border-radius: 999px;
    background: rgba(142,63,121,.22);
    cursor: pointer;
    transition: width .2s ease, background .2s ease;
  }

  #enica-testi-{{ section.id }} .enica-testi__dot.is-active{
    width: 26px;
    background: #000000ff;
  }

  @media (max-width: 989px){
    #enica-testi-{{ section.id }}{
      --card-min-height: 255px;
    }

    #enica-testi-{{ section.id }} .enica-testi__track{
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }

    #enica-testi-{{ section.id }} .enica-testi__slider{
      padding: 0 24px;
    }

    #enica-testi-{{ section.id }} .enica-testi__slider::before{
      left: 24px;
    }

    #enica-testi-{{ section.id }} .enica-testi__slider::after{
      right: 24px;
    }
  }

  @media (max-width: 749px){
    #enica-testi-{{ section.id }}{
      --nav-size: 40px;
      --card-min-height: 245px;
    }

    #enica-testi-{{ section.id }} .enica-testi__head{
      margin-bottom: 22px;
    }

    #enica-testi-{{ section.id }} .enica-testi__slider{
      padding: 0 16px;
    }

    #enica-testi-{{ section.id }} .enica-testi__slider::before{
      left: 16px;
      width: 34px;
    }

    #enica-testi-{{ section.id }} .enica-testi__slider::after{
      right: 16px;
      width: 34px;
    }

    #enica-testi-{{ section.id }} .enica-testi__viewport{
      padding: 8px 0 14px;
      scroll-padding-left: 8%;
      scroll-padding-right: 8%;
    }

    #enica-testi-{{ section.id }} .enica-testi__track{
      grid-auto-columns: 84%;
    }

    #enica-testi-{{ section.id }} .enica-testi__card{
      scroll-snap-align: center;
      transform: scale(.94);
      opacity: .82;
    }

    #enica-testi-{{ section.id }} .enica-testi__card.is-active{
      transform: scale(1);
      opacity: 1;
      box-shadow: 0 22px 48px rgba(18,10,20,.14);
    }

    #enica-testi-{{ section.id }} .enica-testi__top{
      gap: 8px;
    }

    #enica-testi-{{ section.id }} .enica-testi__tag{
      font-size: 11px;
      padding: 6px 9px;
    }

    #enica-testi-{{ section.id }} .enica-testi__meta{
      flex-wrap: wrap;
      align-items: center;
    }

    #enica-testi-{{ section.id }} .enica-testi__verified{
      margin-left: 0;
    }
  }
</style>

<script>
  (function(){
    const root = document.querySelector('#enica-testi-{{ section.id }}');
    if(!root || root.dataset.loaded === 'true') return;
    root.dataset.loaded = 'true';

    const slider = root.querySelector('.enica-testi__slider');
    const viewport = root.querySelector('.enica-testi__viewport');
    const track = root.querySelector('.enica-testi__track');
    const prev = root.querySelector('.enica-testi__nav--prev');
    const next = root.querySelector('.enica-testi__nav--next');
    const dotsWrap = root.querySelector('.enica-testi__dots');

    if(!slider || !viewport || !track) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getCards(){
      return Array.from(track.querySelectorAll('.enica-testi__card'));
    }

    function getGap(){
      const style = getComputedStyle(track);
      return parseFloat(style.columnGap || style.gap || 0);
    }

    function getStep(){
      const card = track.querySelector('.enica-testi__card');
      if(!card) return viewport.clientWidth;
      return card.getBoundingClientRect().width + getGap();
    }

    function scrollByDir(dir){
      viewport.scrollBy({
        left: dir * getStep(),
        behavior: prefersReduced ? 'auto' : 'smooth'
      });
    }

    if(prev) prev.addEventListener('click', function(){ scrollByDir(-1); });
    if(next) next.addEventListener('click', function(){ scrollByDir(1); });

    let isDown = false;
    let startX = 0;
    let startLeft = 0;

    viewport.addEventListener('pointerdown', function(e){
      isDown = true;
      startX = e.clientX;
      startLeft = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
      try { viewport.setPointerCapture(e.pointerId); } catch(err) {}
    });

    viewport.addEventListener('pointermove', function(e){
      if(!isDown) return;
      const dx = e.clientX - startX;
      viewport.scrollLeft = startLeft - dx;
    });

    function stopDrag(){
      isDown = false;
      viewport.classList.remove('is-dragging');
    }

    viewport.addEventListener('pointerup', stopDrag);
    viewport.addEventListener('pointercancel', stopDrag);
    viewport.addEventListener('mouseleave', stopDrag);

    function getPages(){
      const step = getStep();
      if(step <= 0) return 1;
      const count = getCards().length;
      const visible = Math.max(1, Math.round(viewport.clientWidth / step));
      return Math.max(1, count - visible + 1);
    }

    function buildDots(){
      if(!dotsWrap) return;
      dotsWrap.innerHTML = '';

      const pages = getPages();
      if(pages <= 1) return;

      for(let i = 0; i < pages; i++){
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'enica-testi__dot';
        if(i === 0) dot.classList.add('is-active');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', function(){
          viewport.scrollTo({
            left: i * getStep(),
            behavior: prefersReduced ? 'auto' : 'smooth'
          });
        });
        dotsWrap.appendChild(dot);
      }
    }

    function updateDots(){
      if(!dotsWrap) return;
      const dots = dotsWrap.querySelectorAll('.enica-testi__dot');
      if(!dots.length) return;

      const step = getStep();
      const index = Math.min(dots.length - 1, Math.round(viewport.scrollLeft / step));

      dots.forEach(function(dot, i){
        dot.classList.toggle('is-active', i === index);
      });
    }

    function setActiveCard(){
      const cards = getCards();
      if(!cards.length) return;

      if(window.matchMedia('(max-width: 749px)').matches){
        const viewportRect = viewport.getBoundingClientRect();
        const center = viewportRect.left + viewportRect.width / 2;

        let activeCard = null;
        let smallest = Infinity;

        cards.forEach(function(card){
          const rect = card.getBoundingClientRect();
          const cardCenter = rect.left + rect.width / 2;
          const dist = Math.abs(center - cardCenter);

          if(dist < smallest){
            smallest = dist;
            activeCard = card;
          }
        });

        cards.forEach(function(card){
          card.classList.remove('is-active');
        });

        if(activeCard) activeCard.classList.add('is-active');
      } else {
        cards.forEach(function(card){
          card.classList.remove('is-active');
        });
      }
    }

    viewport.addEventListener('scroll', function(){
      requestAnimationFrame(updateDots);
      requestAnimationFrame(setActiveCard);
    });

    let timer = null;

    function stopAutoplay(){
      if(timer){
        clearInterval(timer);
        timer = null;
      }
    }

    function startAutoplay(){
      const autoplay = slider.dataset.autoplay === 'true';
      const interval = parseInt(slider.dataset.interval || '4500', 10);

      if(!autoplay || prefersReduced) return;

      stopAutoplay();

      timer = setInterval(function(){
        const maxScroll = viewport.scrollWidth - viewport.clientWidth - 2;
        if(viewport.scrollLeft >= maxScroll){
          viewport.scrollTo({
            left: 0,
            behavior: prefersReduced ? 'auto' : 'smooth'
          });
        } else {
          scrollByDir(1);
        }
      }, Math.max(2500, interval));
    }

    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    slider.addEventListener('focusin', stopAutoplay);
    slider.addEventListener('focusout', startAutoplay);

    window.addEventListener('resize', function(){
      buildDots();
      updateDots();
      setActiveCard();
    });

    buildDots();
    updateDots();
    setActiveCard();
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "BT Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Loved by customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results. Real Reviews."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Honest feedback from people who added ENICA to their daily wellness routine."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval (ms)",
      "min": 2500,
      "max": 9000,
      "step": 500,
      "default": 4500
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Section background",
      "default": "#F8F6F9"
    },
    {
      "type": "color",
      "id": "card",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text color",
      "default": "#1E1B1F"
    },
    {
      "type": "color",
      "id": "muted",
      "label": "Muted text color",
      "default": "#6B5A6E"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 24,
      "max": 90,
      "step": 6,
      "default": 54
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (optional)",
          "default": "Daily Wellness"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Noticeable difference in energy"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review text",
          "default": "<p>Within two weeks, I felt steadier energy and better focus. It’s now part of my morning routine.</p>"
