<section class="bs-shop-category-{{ section.id }}">
  <div class="bs-shop-wrap">
    {% if section.settings.heading != blank %}
      <div class="bs-shop-heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    <button class="bs-arrow bs-prev" aria-label="Previous">‹</button>

    <div class="bs-category-slider">
      {% for block in section.blocks %}
        <a
          href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}"
          class="bs-category-card"
          {% if block.settings.open_new_tab %}
            target="_blank" rel="noopener"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="bs-img-box">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 400 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {% else %}
              <div class="bs-placeholder">
                {{ block.settings.title | slice: 0, 1 }}
              </div>
            {% endif %}
          </div>

          <div class="bs-title">
            {{ block.settings.title }}
          </div>
        </a>
      {% endfor %}
    </div>

    <button class="bs-arrow bs-next" aria-label="Next">›</button>
  </div>
</section>

<style>
.bs-shop-category-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  overflow: hidden;
}

.bs-shop-category-{{ section.id }} .bs-shop-wrap {
  position: relative;
  max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
  margin: 0 auto;
  padding: 0 {{ section.settings.side_padding_desktop }}px;
}

.bs-shop-category-{{ section.id }} .bs-shop-heading {
  width: max-content;
  max-width: 90%;
  {% comment %} margin: -{{ section.settings.heading_top_overlap }}px auto {{ section.settings.heading_bottom_space }}px; {% endcomment %}
  margin: auto ;
  padding: {{ section.settings.heading_pad_y }}px {{ section.settings.heading_pad_x }}px;
  background: {{ section.settings.heading_bg }};
  border-radius: {{ section.settings.heading_radius }}px {{ section.settings.heading_radius }}px 0 0;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_font_desktop }}px;
  font-weight: {{ section.settings.heading_weight }};
  line-height: 1;
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  text-transform: {{ section.settings.heading_transform }};
  text-align: center;
}

.bs-shop-category-{{ section.id }} .bs-category-slider {
  display: flex;
  gap: {{ section.settings.gap_desktop }}px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scrollbar-width: none;
  padding-bottom: 4px;
  margin-top: 60px;
}

.bs-shop-category-{{ section.id }} .bs-category-slider::-webkit-scrollbar {
  display: none;
}

.bs-shop-category-{{ section.id }} .bs-category-card {
  flex: 0 0 {{ section.settings.item_width_desktop }}px;
  text-align: center;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: transform .25s ease;
}

{% if section.settings.enable_hover %}
.bs-shop-category-{{ section.id }} .bs-category-card:hover {
  transform: translateY(-5px);
}
{% endif %}

.bs-shop-category-{{ section.id }} .bs-img-box {
  height: {{ section.settings.image_box_height_desktop }}px;
  display: flex;
  align-items: end;
  justify-content: center;
}

.bs-shop-category-{{ section.id }} .bs-img-box img {
  max-width: {{ section.settings.image_max_size_desktop }}px;
  max-height: {{ section.settings.image_max_size_desktop }}px;
  object-fit: contain;
  {% if section.settings.enable_image_shadow %}
    filter: drop-shadow(0 8px 7px rgba(0,0,0,{{ section.settings.image_shadow_opacity | times: 0.01 }}));
  {% endif %}
}

.bs-shop-category-{{ section.id }} .bs-placeholder {
  width: {{ section.settings.image_max_size_desktop }}px;
  height: {{ section.settings.image_max_size_desktop }}px;
  border-radius: 50%;
  background: {{ section.settings.card_bg }};
  color: {{ section.settings.heading_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.bs-shop-category-{{ section.id }} .bs-title {
  background: {{ section.settings.card_bg }};
  min-height: {{ section.settings.card_height_desktop }}px;
  padding: 12px 8px;
  font-size: {{ section.settings.card_font_desktop }}px;
  font-weight: {{ section.settings.card_font_weight }};
  line-height: 1.2;
  border-radius: {{ section.settings.card_radius }}px;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: .3px;
}

.bs-shop-category-{{ section.id }} .bs-arrow {
  position: absolute;
  top: {{ section.settings.arrow_top }}%;
  transform: translateY(-50%);
  z-index: 5;
  width: {{ section.settings.arrow_size }}px;
  height: {{ section.settings.arrow_size }}px;
  border: none;
  border-radius: 50%;
  background: {{ section.settings.arrow_bg }};
  color: {{ section.settings.arrow_color }};
  font-size: {{ section.settings.arrow_font_size }}px;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 3px 12px rgba(0,0,0,.12);
  display: {% if section.settings.show_arrows %}flex{% else %}none{% endif %};
  align-items: center;
  justify-content: center;
}

.bs-shop-category-{{ section.id }} .bs-prev {
  left: {{ section.settings.arrow_side_offset }}px;
}

.bs-shop-category-{{ section.id }} .bs-next {
  right: {{ section.settings.arrow_side_offset }}px;
}

@media(max-width: 768px) {
  .bs-shop-category-{{ section.id }} {
    padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-shop-wrap {
    padding: 0 {{ section.settings.side_padding_mobile }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-shop-heading {
    font-size: {{ section.settings.heading_font_mobile }}px;
    {% comment %} margin: -{{ section.settings.mobile_heading_top_overlap }}px auto {{ section.settings.mobile_heading_bottom_space }}px; {% endcomment %}
    margin: auto ;
    padding: {{ section.settings.mobile_heading_pad_y }}px {{ section.settings.mobile_heading_pad_x }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-category-slider {
    gap: {{ section.settings.gap_mobile }}px;
    margin-top: 30px;
  }

  .bs-shop-category-{{ section.id }} .bs-category-card {
    flex: 0 0 {{ section.settings.item_width_mobile }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-img-box {
    height: {{ section.settings.image_box_height_mobile }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-img-box img {
    max-width: {{ section.settings.image_max_size_mobile }}px;
    max-height: {{ section.settings.image_max_size_mobile }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-placeholder {
    width: {{ section.settings.image_max_size_mobile }}px;
    height: {{ section.settings.image_max_size_mobile }}px;
    font-size: 22px;
  }

  .bs-shop-category-{{ section.id }} .bs-title {
    font-size: {{ section.settings.card_font_mobile }}px;
    min-height: {{ section.settings.card_height_mobile }}px;
  }

  .bs-shop-category-{{ section.id }} .bs-arrow {
    display: {% if section.settings.show_mobile_arrows and section.settings.show_arrows %}flex{% else %}none{% endif %};
  }
}
</style>

<script>
(function () {
  function initCategorySlider{{ section.id | replace: '-', '_' }}() {
    const section = document.querySelector(".bs-shop-category-{{ section.id }}");
    if (!section || section.dataset.sliderInit === "true") return;

    section.dataset.sliderInit = "true";

    const slider = section.querySelector(".bs-category-slider");
    const prev = section.querySelector(".bs-prev");
    const next = section.querySelector(".bs-next");

    if (!slider) return;

    const scrollAmount = {{ section.settings.scroll_amount }};

    if (prev) {
      prev.addEventListener("click", function () {
        slider.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });
    }

    if (next) {
      next.addEventListener("click", function () {
        slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    }

    {% if section.settings.enable_autoplay %}
      setInterval(function () {
        if (!slider.matches(":hover")) {
          const maxScroll = slider.scrollWidth - slider.clientWidth;

          if (slider.scrollLeft >= maxScroll - 5) {
            slider.scrollTo({ left: 0, behavior: "smooth" });
          } else {
            slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
          }
        }
      }, {{ section.settings.autoplay_speed | times: 1000 }});
    {% endif %}
  }

  document.addEventListener("DOMContentLoaded", initCategorySlider{{ section.id | replace: '-', '_' }});
  document.addEventListener("shopify:section:load", initCategorySlider{{ section.id | replace: '-', '_' }});
})();
</script>

