{%- capture sh_collection_list_3 -%}
  <style>
    #sh-{{ section.id }}.sh-collection-list-3 {padding: {{section.settings.padding_top}}px 0 {{section.settings.padding_bottom}}px 0; background-color: {{section.settings.bg_color}};}
    #sh-{{ section.id }} .sp-page-with {max-width: {{ section.settings.section_max_width }}px; width: 100%; padding: 0 20px; margin: 0 auto;}
    #sh-{{ section.id }} .sh-collection-list-3-title {margin: 0 auto 30px;}
    #sh-{{ section.id }} .sh-collection-list-3-title h2 {font-size: {{ section.settings.title_font_size }}px; color:{{section.settings.title_color}}; font-weight: 500;margin:0 0 20px 0;}
    #sh-{{ section.id }} .sh-collection-list-3-description p {font-size: {{ section.settings.content_font_size }}px; color:{{section.settings.content_color}};margin:0;line-height: 1.4;}  
    #sh-{{ section.id }} .sh-coll-list-3-wrapper {display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;}
    #sh-{{ section.id }} .sh-coll-list-3-item {background-color: {{ section.settings.category_bg_color }}; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);}
    #sh-{{ section.id }} .sh-coll-list-3-content {display: flex; align-items: center; gap: 15px;}
    #sh-{{ section.id }} .sh-coll-list-3-media{width: 50%; }   
    #sh-{{ section.id }} .sh-coll-list-3-image {height: 100%;width: 100%;object-fit: cover; border-radius: 4px; aspect-ratio: 4 / 5;}
    #sh-{{ section.id }} .sh-coll-list-3-text {width: 50%;}   
    #sh-{{ section.id }} .sh-coll-list-3-title {font-size: {{ section.settings.category_title_font_size }}px; color:{{section.settings.category_title_color}}; font-weight: 500; margin:0 0 10px 0;}
    #sh-{{ section.id }} .sh-coll-list-3-list {list-style: none; padding: 0; margin: 0 0 10px 0;}
    #sh-{{ section.id }} .sh-coll-list-3-list li {font-size: {{ section.settings.subcategory_text_font_size }}px; line-height: 1.3;color: {{section.settings.subcategory_text_color}}; margin-bottom: 5px;}
    #sh-{{ section.id }} .sh-view-all {color: {{section.settings.view_all_color}}; font-size: {{ section.settings.viewall_text_font_size }}px; font-weight: 500; text-decoration: none;text-decoration: underline;}
  
    @media only screen and (max-width: 991px){
       #sh-{{ section.id }} .sh-coll-list-3-wrapper {grid-template-columns: repeat(2, 1fr); gap: 15px;}  
    } 
    
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }}.sh-collection-list-3 {padding: {{section.settings.mob_padding_top}}px 0 {{section.settings.mob_padding_bottom}}px 0;} 
      #sh-{{ section.id }} .sh-collection-list-3-title h2 {font-size: 26px; margin: 0 0 10px;}   
      #sh-{{ section.id }} .sh-collection-list-3-description p{font-size: 14px;}  
      #sh-{{ section.id }} .sh-coll-list-3-wrapper {grid-template-columns: repeat(1, 1fr); } 
      #sh-{{ section.id }} .sh-coll-list-3-image{aspect-ratio: 4 / 4;} 
      #sh-{{ section.id }} .sh-coll-list-3-title{font-size: 18px;} 
      #sh-{{ section.id }} .sh-coll-list-3-list li{font-size: 13px; line-height: 1.2;}  
      #sh-{{ section.id }} .sh-view-all {font-size: 14px;}
    }
  </style> 
{%- endcapture -%}
{{- sh_collection_list_3 | strip_newlines -}}

<div id="sh-{{ section.id }}" class="sh-collection-list-3">
  <div class="sp-page-with">
    {% if section.settings.heading != blank or section.settings.content != blank %}
      <div class="sh-collection-list-3-title sh-title-align-{{ section.settings.text_alignment }}">
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.content != blank %}
          <div class="sh-collection-list-3-description sh-section-desc">{{ section.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="sh-coll-list-3-wrapper">
      {% for block in section.blocks %}

        {% capture collection_data %}
          {% if block.settings.title != blank %}
            <h3 class="sh-coll-list-3-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% capture data %}
            {% for i in (1..4) %}
              {% capture title %}title{{ i }}{% endcapture %}
              {% capture collection %}collection{{ i }}{% endcapture %}
              {% if block.settings[collection] != blank %}
                <li>
                  <a href="{{ block.settings[collection].url }}">{{ block.settings[title] | default: block.settings[collection].title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          {% endcapture %}
          {% if data != blank %}<ul class="sh-coll-list-3-list">{{ data }}</ul>{% endif %}
          {% if block.settings.title != blank and block.settings.view_all_button_link != blank and block.settings.view_all_button_text != blank %}
            <a href="{{ block.settings.view_all_button_link }}" class="sh-view-all">{{- block.settings.view_all_button_text -}}</a>
          {% endif %}
        {% endcapture %}

        {% if collection_data != blank %}
          <div class="sh-coll-list-3-item">
            <div class="sh-coll-list-3-content">
              <div class="sh-coll-list-3-media">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url }}" class="sh-coll-list-3-image" height="" width="" alt="{{ block.settings.title }}" loading="lazy">
                {% else %}
                  <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" class="sh-coll-list-3-image" height="" loading="lazy" alt="Collection list">
                {% endif %}
              </div>
              <div class="sh-coll-list-3-text">{{ collection_data }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

