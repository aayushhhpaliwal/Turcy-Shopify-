<section id="bt-hiw-{{ section.id }}" class="bt-hiw-section">
  <div class="bt-hiw-container">
    {% if section.settings.heading != blank %}
      <h2 class="bt-hiw-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="bt-hiw-grid">
      {% for block in section.blocks %}
        <div class="bt-hiw-box" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="bt-hiw-text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

{% if section.settings.button_label != blank %}
  <div class="bt-hiw-button-wrap">
    <button type="button" class="bt-hiw-button" data-bt-hiw-open>
      {{ section.settings.button_label }}
    </button>
  </div>
{% endif %}
  </div>



  {% assign bt_form_id = 'BtHiwJoinForm-' | append: section.id %}

<div class="bt-hiw-modal" data-bt-hiw-modal hidden>
  <div class="bt-hiw-modal__overlay" data-bt-hiw-close></div>

  <div class="bt-hiw-modal__box">
    <button type="button" class="bt-hiw-modal__close" data-bt-hiw-close aria-label="Close form">
      ×
    </button>

    <div class="bt-hiw-modal__header">
      <h3>{{ section.settings.form_heading | default: 'Join Now' }}</h3>
      {% if section.settings.form_text != blank %}
        <p>{{ section.settings.form_text }}</p>
      {% endif %}
    </div>

    {% form 'contact', id: bt_form_id, class: 'bt-hiw-form' %}
      {% if form.posted_successfully? %}
        <div class="bt-hiw-form-message bt-hiw-form-message--success">
          Thank you. Your form has been submitted successfully.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="bt-hiw-form-message bt-hiw-form-message--error">
          Please check the required fields and try again.
        </div>
      {% endif %}

      <input type="hidden" name="contact[Form Type]" value="Affiliate Join Form">

      <div class="bt-hiw-form__grid">
        <div class="bt-hiw-form__field">
          <label for="BtName-{{ section.id }}">Name</label>
          <input
            id="BtName-{{ section.id }}"
            type="text"
            name="contact[name]"
            placeholder="Enter your name"
            required
          >
        </div>

        <div class="bt-hiw-form__field">
          <label for="BtEmail-{{ section.id }}">Email</label>
          <input
            id="BtEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="Enter your email"
            required
          >
        </div>

        <div class="bt-hiw-form__field">
          <label for="BtPhone-{{ section.id }}">Mobile No.</label>
          <input
            id="BtPhone-{{ section.id }}"
            type="tel"
            name="contact[phone]"
            placeholder="Enter your mobile number"
            required
          >
        </div>

        <div class="bt-hiw-form__field">
          <label for="BtCountry-{{ section.id }}">Country</label>
          <input
            id="BtCountry-{{ section.id }}"
            type="text"
            name="contact[Country]"
            placeholder="Enter your country"
            required
          >
        </div>

        <div class="bt-hiw-form__field bt-hiw-form__field--full">
          <label for="BtCity-{{ section.id }}">City</label>
          <input
            id="BtCity-{{ section.id }}"
            type="text"
            name="contact[City]"
            placeholder="Enter your city"
            required
          >
        </div>
      </div>

      <button type="submit" class="bt-hiw-form__submit">
        Submit
      </button>
    {% endform %}
  </div>
</div>



