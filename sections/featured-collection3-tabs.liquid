{% liquid
  assign section_id = section.id
%}

<section class="fc-tabs fc-tabs--{{ section_id }}">
  <div class="{% if section.settings.full_width %}fc-tabs__full{% else %}page-width{% endif %}">
    {% if section.settings.heading != blank %}
      <div class="fc-tabs__head">
        <h2 class="fc-tabs__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="fc-tabs__nav-wrap">
        <div class="fc-tabs__nav" role="tablist" aria-label="Featured collections tabs">
          {% for block in section.blocks %}
            {% assign tab_collection = block.settings.collection %}
            <button
              class="fc-tabs__tab {% if forloop.first %}is-active{% endif %}"
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="fc-panel-{{ section_id }}-{{ block.id }}"
              id="fc-tab-{{ section_id }}-{{ block.id }}"
              data-target="fc-panel-{{ section_id }}-{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <span class="fc-tabs__tab-inner">
                {% if block.settings.icon != blank %}
                  <span class="fc-tabs__tab-icon">
                    {{
                      block.settings.icon
                      | image_url: width: 100
                      | image_tag:
                        loading: 'lazy',
                        widths: '40,60,80,100',
                        alt: block.settings.title | escape
                    }}
                  </span>
                {% elsif tab_collection.featured_image != blank %}
                  <span class="fc-tabs__tab-icon">
                    {{
                      tab_collection.featured_image
                      | image_url: width: 100
                      | image_tag:
                        loading: 'lazy',
                        widths: '40,60,80,100',
                        alt: block.settings.title | escape
                    }}
                  </span>
                {% endif %}

                <span class="fc-tabs__tab-text">
                  {% if block.settings.title != blank %}
                    {{ block.settings.title }}
                  {% elsif tab_collection.title != blank %}
                    {{ tab_collection.title }}
                  {% else %}
                    Tab
                  {% endif %}
                </span>
              </span>
            </button>
          {% endfor %}
        </div>
      </div>

      <div class="fc-tabs__panels">
        {% for block in section.blocks %}
          {% assign tab_collection = block.settings.collection %}
          <div
            id="fc-panel-{{ section_id }}-{{ block.id }}"
            class="fc-tabs__panel {% if forloop.first %}is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="fc-tab-{{ section_id }}-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="fc-tabs__slider-wrap">
              <button
                type="button"
                class="fc-tabs__arrow fc-tabs__arrow--prev"
                aria-label="Previous products"
                data-slider-prev
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M14.5 5L7.5 12L14.5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div
                class="fc-tabs__slider"
                data-slider
                style="--desktop-columns: {{ section.settings.columns_desktop }}; --mobile-columns: {{ section.settings.columns_mobile }};"
              >
                {% if tab_collection != blank and tab_collection.products_count > 0 %}
                  {% for product in tab_collection.products limit: section.settings.products_to_show %}
                    <div class="fc-tabs__slide" data-slide>
                      <div class="fc-card">
                        <a href="{{ product.url }}" class="fc-card__image-wrap fc-card__image-wrap--{{ section.settings.image_ratio }}">
                          {% if product.featured_image != blank %}
                            {{
                              product.featured_image
                              | image_url: width: 900
                              | image_tag:
                                loading: 'lazy',
                                widths: '220,320,420,520,620,720,820,900',
                                class: 'fc-card__image',
                                alt: product.title | escape
                            }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'fc-card__image placeholder-svg' }}
                          {% endif %}
                        </a>

                        <div class="fc-card__content">
                          <h3 class="fc-card__title">
                            <a href="{{ product.url }}">{{ product.title }}</a>
                          </h3>

                          <div class="fc-card__price">
                            {% if product.compare_at_price > product.price %}
                              <span class="fc-card__price-sale">{{ product.price | money }}</span>
                              <span class="fc-card__price-compare">{{ product.compare_at_price | money }}</span>
                            {% else %}
                              <span class="fc-card__price-regular">{{ product.price | money }}</span>
                            {% endif %}
                          </div>

                          {% if section.settings.show_button %}
                            <a href="{{ product.url }}" class="fc-card__btn">
                              {{ section.settings.button_label }}
                            </a>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                {% else %}
                  {% for i in (1..section.settings.products_to_show) %}
                    <div class="fc-tabs__slide" data-slide>
                      <div class="fc-card">
                        <div class="fc-card__image-wrap fc-card__image-wrap--{{ section.settings.image_ratio }}">
                          {{ 'product-1' | placeholder_svg_tag: 'fc-card__image placeholder-svg' }}
                        </div>
                        <div class="fc-card__content">
                          <h3 class="fc-card__title">Collection product</h3>
                          <div class="fc-card__price">
                            <span class="fc-card__price-regular">{{ 1999 | money }}</span>
                          </div>
                          {% if section.settings.show_button %}
                            <span class="fc-card__btn">{{ section.settings.button_label }}</span>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                {% endif %}
              </div>

              <button
                type="button"
                class="fc-tabs__arrow fc-tabs__arrow--next"
                aria-label="Next products"
                data-slider-next
              >
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M9.5 5L16.5 12L9.5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>

            {% if section.settings.show_view_all and tab_collection != blank %}
              <div class="fc-tabs__view-all-wrap">
                <a href="{{ tab_collection.url }}" class="fc-tabs__view-all">
                  {{ section.settings.view_all_label }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .fc-tabs--{{ section_id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__full {
    width: 100%;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__head {
    text-align: center;
    margin-bottom: 18px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__heading {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
    font-weight: 700;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__nav-wrap {
    margin-bottom: 24px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__nav {
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    {% comment %} border: 1px solid {{ section.settings.tab_border_color }}; {% endcomment %}
    border-radius: {{ section.settings.tab_radius }}px;
    background: {{ section.settings.tab_bg }};
  }

  .fc-tabs--{{ section_id }} .fc-tabs__nav::-webkit-scrollbar {
    display: none;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 10px 16px;
    min-width: {{ section.settings.tab_min_width }}px;
    flex: 0 0 auto;
    position: relative;
    transition: all 0.25s ease;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab + .fc-tabs__tab {
    border-left: 1px solid {{ section.settings.tab_border_color }};
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab.is-active {
    background: {{ section.settings.active_tab_bg }};
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    flex: 0 0 auto;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    {% comment %} border-radius: 50%; {% endcomment %}
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab-text {
    font-size: {{ section.settings.tab_text_size }}px;
    line-height: 1.2;
    color: {{ section.settings.tab_text_color }};
    font-weight: 500;
    white-space: nowrap;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__tab.is-active .fc-tabs__tab-text {
    color: {{ section.settings.active_tab_text_color }};
    font-weight: 600;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__panel {
    animation: fcFade .25s ease;
  }

  @keyframes fcFade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fc-tabs--{{ section_id }} .fc-tabs__slider-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__slider {
    flex: 1 1 auto;
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__slider::-webkit-scrollbar {
    display: none;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__slide {
    flex: 0 0 calc((100% - ({{ section.settings.card_gap }}px * (var(--desktop-columns) - 1))) / var(--desktop-columns));
    min-width: calc((100% - ({{ section.settings.card_gap }}px * (var(--desktop-columns) - 1))) / var(--desktop-columns));
    scroll-snap-align: start;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__arrow {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.arrow_border_color }};
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all .2s ease;
    padding: 0;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__arrow:hover {
    background: {{ section.settings.arrow_hover_bg }};
    color: {{ section.settings.arrow_hover_color }};
    border-color: {{ section.settings.arrow_hover_bg }};
  }

  .fc-tabs--{{ section_id }} .fc-tabs__arrow[disabled] {
    opacity: .45;
    cursor: not-allowed;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__arrow svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .fc-tabs--{{ section_id }} .fc-card {
    height: 100%;
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .fc-tabs--{{ section_id }} .fc-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  }

  .fc-tabs--{{ section_id }} .fc-card__image-wrap {
    position: relative;
    overflow: hidden;
    display: block;
    width: 100%;
    background: #fff;
  }

  .fc-tabs--{{ section_id }} .fc-card__image-wrap--square {
    aspect-ratio: 1 / 1;
  }

  .fc-tabs--{{ section_id }} .fc-card__image-wrap--portrait {
    aspect-ratio: 4 / 5;
  }

  .fc-tabs--{{ section_id }} .fc-card__image-wrap--landscape {
    aspect-ratio: 4 / 3;
  }

  .fc-tabs--{{ section_id }} .fc-card__image-wrap--adapt .fc-card__image {
    position: relative;
    height: auto;
  }

  .fc-tabs--{{ section_id }} .fc-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .fc-tabs--{{ section_id }} .fc-card__content {
    padding: 14px 14px 16px;
  }

  .fc-tabs--{{ section_id }} .fc-card__title {
    margin: 0 0 8px;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 600;
    color: {{ section.settings.card_title_color }};
  }

  .fc-tabs--{{ section_id }} .fc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .fc-tabs--{{ section_id }} .fc-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .fc-tabs--{{ section_id }} .fc-card__price-sale,
  .fc-tabs--{{ section_id }} .fc-card__price-regular {
    color: {{ section.settings.price_color }};
    font-weight: 700;
    font-size: 15px;
  }

  .fc-tabs--{{ section_id }} .fc-card__price-compare {
    color: {{ section.settings.compare_price_color }};
    text-decoration: line-through;
    font-size: 13px;
  }

  .fc-tabs--{{ section_id }} .fc-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px 16px;
    border-radius: 999px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: opacity .2s ease;
  }

  .fc-tabs--{{ section_id }} .fc-card__btn:hover {
    opacity: .88;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__view-all-wrap {
    margin-top: 20px;
    text-align: center;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.view_all_border }};
    background: {{ section.settings.view_all_bg }};
    color: {{ section.settings.view_all_text }};
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all .2s ease;
  }

  .fc-tabs--{{ section_id }} .fc-tabs__view-all:hover {
    background: {{ section.settings.view_all_hover_bg }};
    color: {{ section.settings.view_all_hover_text }};
    border-color: {{ section.settings.view_all_hover_bg }};
  }

  @media screen and (max-width: 989px) {
    .fc-tabs--{{ section_id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__full {
      padding-left: 12px;
      padding-right: 12px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__nav {
      {% comment %} justify-content: flex-start; {% endcomment %}
      border-radius: 12px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__tab {
      min-width: {{ section.settings.tab_min_width_mobile }}px;
      padding: 10px 12px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__tab-icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__tab-text {
      font-size: {{ section.settings.tab_text_size_mobile }}px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__slider-wrap {
      gap: 8px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__slide {
      flex: 0 0 calc((100% - {{ section.settings.card_gap_mobile }}px) / var(--mobile-columns));
      min-width: calc((100% - {{ section.settings.card_gap_mobile }}px) / var(--mobile-columns));
    }

    .fc-tabs--{{ section_id }} .fc-tabs__slider {
      gap: {{ section.settings.card_gap_mobile }}px;
    }

    .fc-tabs--{{ section_id }} .fc-tabs__arrow {
      width: 36px;
      height: 36px;
      min-width: 36px;
    }

    .fc-tabs--{{ section_id }} .fc-card__content {
      padding: 12px;
    }

    .fc-tabs--{{ section_id }} .fc-card__title {
      font-size: 14px;
    }

    .fc-tabs--{{ section_id }} .fc-card__price-sale,
    .fc-tabs--{{ section_id }} .fc-card__price-regular {
      font-size: 14px;
    }

    .fc-tabs--{{ section_id }} .fc-card__btn {
      width: 100%;
      min-height: 38px;
      padding: 8px 12px;
      font-size: 12px;
    }
  }

  @media screen and (max-width: 749px) {
    .fc-tabs--{{ section_id }} .fc-tabs__tab-text {
      white-space: normal;
    }
    .fc-tabs__arrow--next{
    right: 0;
    }
    .fc-tabs__arrow{
    position: absolute;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.fc-tabs--{{ section_id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.fc-tabs__tab');
    const panels = section.querySelectorAll('.fc-tabs__panel');

    function updateSliderButtons(panel) {
      const slider = panel.querySelector('[data-slider]');
      const prev = panel.querySelector('[data-slider-prev]');
      const next = panel.querySelector('[data-slider-next]');
      if (!slider || !prev || !next) return;

      const maxScrollLeft = slider.scrollWidth - slider.clientWidth;
      prev.disabled = slider.scrollLeft <= 2;
      next.disabled = slider.scrollLeft >= maxScrollLeft - 2;
    }

    function getScrollAmount(slider) {
      const firstSlide = slider.querySelector('[data-slide]');
      if (!firstSlide) return slider.clientWidth;
      const slideWidth = firstSlide.getBoundingClientRect().width;
      const sliderStyles = window.getComputedStyle(slider);
      const gap = parseFloat(sliderStyles.columnGap || sliderStyles.gap || 0);

      return slideWidth + gap;
    }

    function initPanelSlider(panel) {
      const slider = panel.querySelector('[data-slider]');
      const prev = panel.querySelector('[data-slider-prev]');
      const next = panel.querySelector('[data-slider-next]');
      if (!slider || !prev || !next) return;

      prev.addEventListener('click', function () {
        slider.scrollBy({ left: -getScrollAmount(slider), behavior: 'smooth' });
      });

      next.addEventListener('click', function () {
        slider.scrollBy({ left: getScrollAmount(slider), behavior: 'smooth' });
      });

      slider.addEventListener('scroll', function () {
        updateSliderButtons(panel);
      });

      window.addEventListener('resize', function () {
        updateSliderButtons(panel);
      });

      updateSliderButtons(panel);
    }

    panels.forEach((panel) => {
      initPanelSlider(panel);
    });

    tabs.forEach((tab) => {
      tab.addEventListener('click', function () {
        const targetId = this.getAttribute('data-target');

        tabs.forEach((btn) => {
          btn.classList.remove('is-active');
          btn.setAttribute('aria-selected', 'false');
        });

        panels.forEach((panel) => {
          panel.classList.remove('is-active');
          panel.setAttribute('hidden', 'hidden');
        });

        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');

        const targetPanel = section.querySelector('#' + targetId);
        if (targetPanel) {
          targetPanel.classList.add('is-active');
          targetPanel.removeAttribute('hidden');
          setTimeout(function () {
            updateSliderButtons(targetPanel);
          }, 50);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured collection tabs",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by category"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Enable full width",
      "default": false
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop products per view",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile products per view",
      "default": "2",
      "options": [
        { "value": "1", "label": "1 product" },
        { "value": "2", "label": "2 products" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "default": "square",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show product button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Product button label",
      "default": "Shop now"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All label",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size desktop",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size mobile",
      "default": 22
    },
    {
      "type": "range",
      "id": "tab_min_width",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Tab min width desktop",
      "default": 120
    },
