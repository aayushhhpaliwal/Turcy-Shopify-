{% liquid
  assign section_id = 'suroskie-founder-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="suroskie-section-wrapper"
  style="
    --suroskie-panel-bg: {{ section.settings.panel_color }};
    --suroskie-heading-color: {{ section.settings.heading_color }};
    --suroskie-highlight-color: {{ section.settings.highlight_color }};
    --suroskie-text-color: {{ section.settings.text_color }};
    --suroskie-button-bg: {{ section.settings.button_bg_color }};
    --suroskie-button-text: {{ section.settings.button_text_color }};
    --suroskie-arrow-bg: {{ section.settings.arrow_bg_color }};
    --suroskie-arrow-color: {{ section.settings.arrow_color }};
    --suroskie-max-width: {{ section.settings.max_width }}px;
    --suroskie-padding-top: {{ section.settings.padding_top }}px;
    --suroskie-padding-bottom: {{ section.settings.padding_bottom }}px;
    --suroskie-heading-size: {{ section.settings.heading_size }}px;
    --suroskie-highlight-size: {{ section.settings.highlight_size }}px;
    --suroskie-body-size: {{ section.settings.body_size }}px;
  "
>
  <div class="suroskie-swiper swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% liquid
          assign desktop_alt = block.settings.desktop_image.alt | default: block.settings.founder_name
          assign mobile_alt = block.settings.mobile_image.alt | default: block.settings.founder_name
          assign bg_alt = block.settings.background_image.alt | default: block.settings.founder_name
          assign mobile_bg_alt = block.settings.mobile_background_image.alt | default: bg_alt
          if mobile_alt == blank
            assign mobile_alt = desktop_alt
          endif
        %}
        <div
          class="swiper-slide{% if forloop.first %} swiper-slide-active swiper-slide-visible{% endif %}"
          role="group"
          aria-label="{{ forloop.index }} / {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.background_image != blank %}
            {{
              block.settings.background_image
              | image_url: width: 2200
              | image_tag:
                class: 'suroskie-bg-image suroskie-bg-image--desktop',
                widths: '900, 1200, 1600, 2000, 2200',
                sizes: '100vw',
                loading: 'lazy',
                alt: bg_alt
            }}
          {% endif %}
          {% if block.settings.mobile_background_image != blank %}
            {{
              block.settings.mobile_background_image
              | image_url: width: 900
              | image_tag:
                class: 'suroskie-bg-image suroskie-bg-image--mobile',
                widths: '360, 540, 720, 900',
                sizes: '(max-width: 767px) 100vw, 0px',
                loading: 'lazy',
                alt: mobile_bg_alt
            }}
          {% elsif block.settings.background_image != blank %}
            {{
              block.settings.background_image
              | image_url: width: 900
              | image_tag:
                class: 'suroskie-bg-image suroskie-bg-image--mobile',
                widths: '360, 540, 720, 900',
                sizes: '(max-width: 767px) 100vw, 0px',
                loading: 'lazy',
                alt: bg_alt
            }}
          {% endif %}
          <div class="suroskie-container">
            <div class="suroskie-left">
              {% if block.settings.heading != blank or block.settings.highlight_text != blank %}
                <h2>
                  {% if block.settings.heading != blank %}
                    <span>{{ block.settings.heading }}</span>
                  {% endif %}
                  {% if block.settings.highlight_text != blank %}
                    <strong>{{ block.settings.highlight_text }}</strong>
                  {% endif %}
                </h2>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  href="{{ block.settings.button_link | default: 'javascript:void(0)' }}"
                  class="suroskie-button"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="suroskie-description rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.founder_name != blank %}
                <div class="founder-name">{{ block.settings.founder_name }}</div>
              {% endif %}

              <div class="founder-nav">
                <button class="swiper-button-prev" type="button" aria-label="Previous slide">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="20" cy="20" r="20" fill="currentColor"></circle>
                    <path d="M23 14L17 20L23 26" stroke="var(--suroskie-arrow-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
                <button class="swiper-button-next" type="button" aria-label="Next slide">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="20" cy="20" r="20" fill="currentColor"></circle>
                    <path d="M17 26L23 20L17 14" stroke="var(--suroskie-arrow-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="suroskie-right">
              {% if block.settings.desktop_image != blank %}
                {{
                  block.settings.desktop_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'desktopimage',
                    widths: '600, 800, 1000, 1200, 1400',
                    sizes: '(max-width: 767px) 0px, 60vw',
                    loading: 'lazy',
                    alt: desktop_alt
                }}
              {% else %}
                <div class="suroskie-placeholder desktopimage">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.mobile_image != blank %}
                {{
                  block.settings.mobile_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'mobileimage',
                    widths: '360, 540, 720, 900',
                    sizes: '(max-width: 767px) 100vw, 0px',
                    loading: 'lazy',
                    alt: mobile_alt
                }}
              {% elsif block.settings.desktop_image != blank %}
                {{
                  block.settings.desktop_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'mobileimage',
                    widths: '360, 540, 720, 900',
                    sizes: '(max-width: 767px) 100vw, 0px',
                    loading: 'lazy',
                    alt: desktop_alt
                }}
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    padding: var(--suroskie-padding-top) 20px var(--suroskie-padding-bottom);
    overflow: hidden;
  }

  #{{ section_id }} .suroskie-swiper {
    max-width: var(--suroskie-max-width);
    margin: 0 auto;
    overflow: visible;
  }

  #{{ section_id }} .swiper-wrapper {
    position: relative;
  }

  #{{ section_id }} .swiper-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .55s ease, visibility .55s ease;
  }

  #{{ section_id }} .swiper-slide-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #{{ section_id }} .suroskie-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  #{{ section_id }} .suroskie-bg-image--mobile {
    display: none;
  }

  #{{ section_id }} .suroskie-container {
    min-height: {{ section.settings.section_height }}px;
    position: relative;
    display: flex;
    align-items: stretch;
    max-width: var(--suroskie-max-width);
    margin: 0 auto;
    z-index: 1;
  }

  #{{ section_id }} .suroskie-left {
    width: 50%;
    min-height: {{ section.settings.section_height }}px;
    margin: 0;
    padding: 42px 48px 38px;
    background: var(--suroskie-panel-bg);
    color: var(--suroskie-text-color);
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
  }

  #{{ section_id }} .suroskie-left h2 {
    margin: 0 0 24px;
    color: var(--suroskie-heading-color);
    font-size: var(--suroskie-heading-size);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: 0;
  }

  #{{ section_id }} .suroskie-left h2 span,
  #{{ section_id }} .suroskie-left h2 strong {
    display: block;
  }

  #{{ section_id }} .suroskie-left h2 strong {
    margin-top: 14px;
    color: var(--suroskie-highlight-color);
    font-size: var(--suroskie-highlight-size);
  }

  #{{ section_id }} .suroskie-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 17px;
    margin-bottom: 20px;
    background: var(--suroskie-button-bg);
    color: var(--suroskie-button-text);
    font-size: 16px;
    line-height: 1.2;
    font-weight: 600;
    text-decoration: none;
  }

  #{{ section_id }} .suroskie-description {
    max-width: 620px;
    margin: 0 auto;
    color: var(--suroskie-text-color);
    font-size: var(--suroskie-body-size);
    line-height: 1.45;
  }

  #{{ section_id }} .suroskie-description p {
    margin: 0;
  }

  #{{ section_id }} .founder-name {
    margin-top: 18px;
    color: var(--suroskie-heading-color);
    font-size: 18px;
    line-height: 1.3;
    font-weight: 700;
  }

  #{{ section_id }} .founder-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  #{{ section_id }} .founder-nav .swiper-button-prev,
  #{{ section_id }} .founder-nav .swiper-button-next {
    position: static;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--suroskie-arrow-bg);
    cursor: pointer;
  }

  #{{ section_id }} .founder-nav .swiper-button-prev::after,
  #{{ section_id }} .founder-nav .swiper-button-next::after {
    content: none;
  }

  #{{ section_id }} .founder-nav .swiper-button-disabled {
    opacity: .45;
    cursor: default;
  }

  #{{ section_id }} .suroskie-right {
    position: relative;
    width: 50%;
    min-height: {{ section.settings.section_height }}px;
    z-index: 1;
  }

  #{{ section_id }} .suroskie-right img,
  #{{ section_id }} .suroskie-placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #{{ section_id }} .mobileimage {
    display: none;
  }

  #{{ section_id }} .suroskie-placeholder {
    background: #f2f2f2;
  }

  #{{ section_id }} .suroskie-placeholder svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .suroskie-left {
      padding: 34px 28px;
    }

    #{{ section_id }} .suroskie-left h2 {
      font-size: calc(var(--suroskie-heading-size) * .76);
    }

    #{{ section_id }} .suroskie-left h2 strong {
      font-size: calc(var(--suroskie-highlight-size) * .76);
    }
  }

  @media screen and (max-width: 767px) {
    #{{ section_id }} {
      padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .suroskie-container {
      min-height: 0;
      display: flex;
      flex-direction: column-reverse;
    }

    #{{ section_id }} .suroskie-left {
      width: calc(100% - 32px);
      min-height: 0;
      max-width: none;
      margin: -48px auto 0;
      padding: 26px 18px 24px;
    }

    #{{ section_id }} .suroskie-left h2 {
      margin-bottom: 18px;
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #{{ section_id }} .suroskie-left h2 strong {
      margin-top: 8px;
      font-size: {{ section.settings.mobile_highlight_size }}px;
    }

    #{{ section_id }} .suroskie-button {
      min-height: 38px;
      margin-bottom: 16px;
      padding: 8px 14px;
      font-size: 14px;
    }

    #{{ section_id }} .suroskie-description {
      font-size: {{ section.settings.mobile_body_size }}px;
    }

    #{{ section_id }} .founder-name {
      margin-top: 14px;
      font-size: 15px;
    }

    #{{ section_id }} .founder-nav {
      margin-top: 20px;
    }

    #{{ section_id }} .suroskie-right {
      position: relative;
      width: 100%;
      min-height: 0;
      aspect-ratio: 1 / 1.08;
    }

    #{{ section_id }} .desktopimage {
      display: none;
    }

    #{{ section_id }} .mobileimage {
      display: block;
    }

    #{{ section_id }} .suroskie-bg-image--desktop {
      display: none;
    }

    #{{ section_id }} .suroskie-bg-image--mobile {
      display: block;
    }
  }
</style>

<script>
  (function() {
    var root = document.getElementById({{ section_id | json }});
    if (!root) return;

    function initSuroskieSlider() {
      var slides = Array.prototype.slice.call(root.querySelectorAll('.swiper-slide'));
      var nextButtons = Array.prototype.slice.call(root.querySelectorAll('.swiper-button-next'));
      var prevButtons = Array.prototype.slice.call(root.querySelectorAll('.swiper-button-prev'));
      var activeIndex = 0;

      if (!slides.length) return;

      function setSlide(index) {
        activeIndex = Math.max(0, Math.min(index, slides.length - 1));

        slides.forEach(function(slide, slideIndex) {
          var isActive = slideIndex === activeIndex;
          slide.classList.toggle('swiper-slide-active', isActive);
          slide.classList.toggle('swiper-slide-visible', isActive);
          slide.classList.toggle('swiper-slide-next', slideIndex === activeIndex + 1);
          slide.classList.toggle('swiper-slide-prev', slideIndex === activeIndex - 1);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });

        prevButtons.forEach(function(button) {
          button.disabled = activeIndex === 0;
          button.classList.toggle('swiper-button-disabled', activeIndex === 0);
          button.setAttribute('aria-disabled', activeIndex === 0 ? 'true' : 'false');
        });

        nextButtons.forEach(function(button) {
          button.disabled = activeIndex === slides.length - 1;
          button.classList.toggle('swiper-button-disabled', activeIndex === slides.length - 1);
          button.setAttribute('aria-disabled', activeIndex === slides.length - 1 ? 'true' : 'false');
        });
      }

      nextButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          setSlide(activeIndex + 1);
        });
      });

      prevButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          setSlide(activeIndex - 1);
        });
      });

      setSlide(0);
    }

    initSuroskieSlider();

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === {{ section.id | json }}) initSuroskieSlider();
    });
  })();
</script>

{% schema %}
{
  "name": "Suroskie founder slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1800,
