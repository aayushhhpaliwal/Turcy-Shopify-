    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 55
