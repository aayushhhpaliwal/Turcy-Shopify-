      "max": 1100,
      "step": 20,
      "unit": "px",
      "label": "Mobile section height",
      "default": 820
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 36,
      "max": 86,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 56
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#17211E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description",
      "default": "#596762"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow and button",
