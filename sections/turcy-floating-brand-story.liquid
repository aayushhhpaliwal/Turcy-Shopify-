          "id": "mobile_y",
          "min": 30,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 72
        },
        {
          "type": "range",
          "id": "mobile_width",
          "min": 70,
          "max": 280,
          "step": 10,
          "unit": "px",
          "label": "Mobile image width",
          "default": 150
        },
        {
          "type": "header",
          "content": "Image styling"
        },
        {
