<section class="bs-people-section-{{ section.id }}">
  <div class="bs-bg-overlay"></div>

  <div class="bs-people-inner">
    <div class="bs-people-slider">
      {% for block in section.blocks %}
        <div class="bs-people-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
          
          <div class="bs-content-card">
            {% if block.settings.heading_top != blank %}
              <h2>
                {{ block.settings.heading_top }}
                {% if block.settings.heading_highlight != blank %}
                  <span>{{ block.settings.heading_highlight }}</span>
                {% endif %}
              </h2>
            {% endif %}

            {% if block.settings.role != blank %}
              <div class="bs-role">{{ block.settings.role }}</div>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="bs-description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            {% if block.settings.name != blank %}
              <div class="bs-name">{{ block.settings.name }}</div>
            {% endif %}

            {% if section.blocks.size > 1 %}
              <div class="bs-slider-buttons">
                <button class="bs-people-prev" aria-label="Previous">‹</button>
                <button class="bs-people-next" aria-label="Next">›</button>
              </div>
            {% endif %}
          </div>

<div
  class="bs-image-area"
  {% if block.settings.person_image != blank %}
    style="--person-bg-image: url('{{ block.settings.person_image | image_url: width: 1200 }}');"
  {% endif %}
>
</div>

        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.bs-people-section-{{ section.id }} {
  position: relative;
  background-color: {{ section.settings.section_bg }};
  {% if section.settings.background_image != blank %}
    background-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');
  {% endif %}
  background-size: {{ section.settings.background_size }};
  background-position: {{ section.settings.background_position }};
  background-repeat: no-repeat;
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  overflow: hidden;
}

.bs-people-section-{{ section.id }} .bs-bg-overlay {
  position: absolute;
  inset: 0;
  background: {{ section.settings.bg_overlay_color }};
  opacity: {{ section.settings.bg_overlay_opacity | times: 0.01 }};
  pointer-events: none;
  z-index: 0;
}

.bs-people-section-{{ section.id }} .bs-people-inner {
  position: relative;
  z-index: 2;
  max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
  min-height: {{ section.settings.section_height }}px;
  margin: 0 auto;
}

.bs-people-section-{{ section.id }} .bs-people-slider {
  position: relative;
  z-index: 2;
}

.bs-people-section-{{ section.id }} .bs-people-slide {
  display: none;
  grid-template-columns: {{ section.settings.content_width }}% 1fr;
  align-items: end;
  min-height: {{ section.settings.section_height }}px;
}

.bs-people-section-{{ section.id }} .bs-people-slide.active {
  display: grid;
}

.bs-people-section-{{ section.id }} .bs-content-card {
  background: {{ section.settings.card_bg }};
  min-height: {{ section.settings.card_height }}px;
  margin-left: {{ section.settings.card_left_spacing }}px;
  margin-bottom: {{ section.settings.card_bottom_spacing }}px;
  padding: {{ section.settings.card_padding_top }}px {{ section.settings.card_padding_x }}px {{ section.settings.card_padding_bottom }}px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: {{ section.settings.card_radius }}px;
  box-shadow: {% if section.settings.enable_card_shadow %}0 18px 45px rgba(0,0,0,0.06){% else %}none{% endif %};
}

.bs-people-section-{{ section.id }} .bs-content-card h2 {
  margin: 0 0 {{ section.settings.heading_bottom_spacing }}px;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: {{ section.settings.heading_letter_spacing }}px;
}

.bs-people-section-{{ section.id }} .bs-content-card h2 span {
  display: block;
  margin-top: 8px;
  color: {{ section.settings.accent_color }};
  font-size: {{ section.settings.highlight_size }}px;
  font-weight: 700;
  letter-spacing: {{ section.settings.highlight_letter_spacing }}px;
  text-transform: uppercase;
}

.bs-people-section-{{ section.id }} .bs-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: {{ section.settings.role_width }}px;
  margin-bottom: {{ section.settings.role_bottom_spacing }}px;
  padding: 11px 22px;
  background: {{ section.settings.accent_color }};
  color: {{ section.settings.role_text_color }};
  font-size: {{ section.settings.role_font_size }}px;
  font-weight: 500;
  line-height: 1;
  border-radius: {{ section.settings.role_radius }}px;
}

.bs-people-section-{{ section.id }} .bs-description {
  max-width: {{ section.settings.text_width }}px;
  margin: 0 auto {{ section.settings.name_top_spacing }}px;
  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.text_size }}px;
  font-weight: 400;
  line-height: 1.55;
}

.bs-people-section-{{ section.id }} .bs-name {
  color: {{ section.settings.name_color }};
  font-size: {{ section.settings.name_size }}px;
  font-weight: 700;
  line-height: 1.3;
}

.bs-people-section-{{ section.id }} .bs-slider-buttons {
  display: flex;
  gap: 12px;
  margin-top: {{ section.settings.arrow_top_spacing }}px;
}

.bs-people-section-{{ section.id }} .bs-slider-buttons button {
  width: {{ section.settings.arrow_size }}px;
  height: {{ section.settings.arrow_size }}px;
  border: none;
  border-radius: 50%;
  background: {{ section.settings.arrow_bg }};
  color: {{ section.settings.arrow_color }};
  font-size: {{ section.settings.arrow_font_size }}px;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: .25s ease;
}

.bs-people-section-{{ section.id }} .bs-slider-buttons button:hover {
  background: {{ section.settings.accent_color }};
  color: #ffffff;
}

{% comment %} .bs-people-section-{{ section.id }} .bs-image-area {
  position: relative;
  min-height: {{ section.settings.section_height }}px;
  display: flex;
  align-items: end;
  justify-content: center;
}

.bs-people-section-{{ section.id }} .bs-image-area img {
  display: block;
  max-width: {{ section.settings.image_width }}px;
  max-height: {{ section.settings.image_height }}px;
  width: 100%;
  object-fit: contain;
  position: relative;
  z-index: 3;
} {% endcomment %}
.bs-people-section-{{ section.id }} .bs-image-area {
  position: relative;
  min-height: {{ section.settings.section_height }}px;
  background-image: var(--person-bg-image);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: bottom center;
  z-index: 3;
}

@media screen and (max-width: 989px) {
  .bs-people-section-{{ section.id }} {
    {% if section.settings.mobile_background_image != blank %}
      background-image: url('{{ section.settings.mobile_background_image | image_url: width: 1000 }}');
    {% endif %}
    background-position: {{ section.settings.mobile_background_position }};
    padding: {{ section.settings.mobile_padding_top }}px 0 {{ section.settings.mobile_padding_bottom }}px;
  }

  .bs-people-section-{{ section.id }} .bs-people-inner {
    min-height: auto;
  }

  .bs-people-section-{{ section.id }} .bs-people-slide,
  .bs-people-section-{{ section.id }} .bs-people-slide.active {
    display: flex;
    flex-direction: column-reverse;
    min-height: auto;
  }

  .bs-people-section-{{ section.id }} .bs-content-card {
    width: calc(100% - 32px);
    min-height: auto;
    margin: -20px auto 0;
    padding: {{ section.settings.mobile_card_padding_top }}px {{ section.settings.mobile_card_padding_x }}px {{ section.settings.mobile_card_padding_bottom }}px;
    position: relative;
    z-index: 5;
  }

  .bs-people-section-{{ section.id }} .bs-content-card h2 {
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  .bs-people-section-{{ section.id }} .bs-content-card h2 span {
    font-size: {{ section.settings.mobile_highlight_size }}px;
  }

  .bs-people-section-{{ section.id }} .bs-description {
    font-size: {{ section.settings.mobile_text_size }}px;
  }

  {% comment %} .bs-people-section-{{ section.id }} .bs-image-area {
    min-height: auto;
    width: 100%;
  }

  .bs-people-section-{{ section.id }} .bs-image-area img {
    max-width: {{ section.settings.mobile_image_width }}px;
    max-height: {{ section.settings.mobile_image_height }}px;
  } {% endcomment %}
  .bs-people-section-{{ section.id }} .bs-image-area {
  min-height: {{ section.settings.mobile_image_height }}px;
  width: 100%;
  background-image: var(--person-bg-image);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: bottom center;
}
}
</style>

<script>
(function () {
  function initPeopleSlider{{ section.id | replace: '-', '_' }}() {
    const section = document.querySelector('.bs-people-section-{{ section.id }}');
    if (!section || section.dataset.peopleInit === 'true') return;

    section.dataset.peopleInit = 'true';

    const slides = section.querySelectorAll('.bs-people-slide');
    const prevButtons = section.querySelectorAll('.bs-people-prev');
    const nextButtons = section.querySelectorAll('.bs-people-next');

    if (!slides.length) return;

    let current = 0;

    function showSlide(index) {
      slides.forEach(function (slide) {
        slide.classList.remove('active');
      });

      slides[index].classList.add('active');
    }

    function nextSlide() {
      current = current + 1 >= slides.length ? 0 : current + 1;
      showSlide(current);
    }

    function prevSlide() {
      current = current - 1 < 0 ? slides.length - 1 : current - 1;
      showSlide(current);
    }

    nextButtons.forEach(function (button) {
      button.addEventListener('click', nextSlide);
    });

    prevButtons.forEach(function (button) {
      button.addEventListener('click', prevSlide);
    });

    {% if section.settings.enable_autoplay %}
      setInterval(nextSlide, {{ section.settings.autoplay_speed | times: 1000 }});
    {% endif %}
  }

  document.addEventListener('DOMContentLoaded', initPeopleSlider{{ section.id | replace: '-', '_' }});
  document.addEventListener('shopify:section:load', initPeopleSlider{{ section.id | replace: '-', '_' }});
})();
</script>

