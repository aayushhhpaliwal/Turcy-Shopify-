{%- if section.blocks.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav-spacer {
      display: block;
      height: calc({{ section.settings.bar_height }}px + env(safe-area-inset-bottom));
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav {
      --rr-mobile-bottom-nav-text: {{ section.settings.text_color }};
      --rr-mobile-bottom-nav-active: {{ section.settings.active_color }};
      --rr-mobile-bottom-nav-divider: {{ section.settings.divider_color }};
      --rr-mobile-bottom-nav-icon-size: {{ section.settings.icon_size }}px;
      --rr-mobile-bottom-nav-label-size: {{ section.settings.label_size }}px;
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 110;
      height: calc({{ section.settings.bar_height }}px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: {{ section.settings.background_color }};
      border-top: 1px solid {{ section.settings.divider_color }};
      box-shadow: 0 -10px 24px -16px rgba(18, 18, 18, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__list {
      display: grid;
      grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__item {
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__item + .rr-mobile-bottom-nav__item {
      {% if section.settings.show_separators %}
        border-left: 1px dashed {{ section.settings.divider_color }};
      {% else %}
        border-left: 0;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__link {
      display: block;
      height: 100%;
      min-height: {{ section.settings.bar_height }}px;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.8rem 0.4rem;
      color: var(--rr-mobile-bottom-nav-text);
      text-align: center;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__link--static {
      cursor: default;
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__item.is-active .rr-mobile-bottom-nav__link,
    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__link:focus-visible,
    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__link:hover {
      color: var(--rr-mobile-bottom-nav-active);
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__icon {
      display: inline-flex;
      width: var(--rr-mobile-bottom-nav-icon-size);
      height: var(--rr-mobile-bottom-nav-icon-size);
      align-items: center;
      justify-content: center;
      flex: 0 0 var(--rr-mobile-bottom-nav-icon-size);
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__icon svg,
    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    #shopify-section-{{ section.id }} .rr-mobile-bottom-nav__label {
      display: block;
      max-width: 100%;
      overflow: hidden;
      font-size: var(--rr-mobile-bottom-nav-label-size);
      line-height: 1.1;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .rr-mobile-bottom-nav-spacer,
      #shopify-section-{{ section.id }} .rr-mobile-bottom-nav {
        display: none;
      }
    }
  {%- endstyle -%}

  <div class="rr-mobile-bottom-nav-spacer" aria-hidden="true"></div>

  <nav class="rr-mobile-bottom-nav" aria-label="{{ section.settings.accessibility_label | escape }}">
    <ul class="rr-mobile-bottom-nav__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_url = block.settings.link

          if item_url == blank
            case block.settings.icon
              when 'logo', 'home'
                assign item_url = routes.root_url
              when 'categories', 'offers'
                assign item_url = routes.collections_url
              when 'account'
                if customer
                  assign item_url = routes.account_url
                else
                  assign item_url = routes.account_login_url
                endif
              when 'cart'
                assign item_url = routes.cart_url
              when 'search'
                assign item_url = routes.search_url
            endcase
          endif

          assign request_path = request.path | split: '?' | first
          assign item_path = item_url | split: '#' | first | split: '?' | first
          assign is_active = false

          if item_url != blank
            if item_path == routes.root_url and template.name == 'index'
              assign is_active = true
            elsif item_path != blank and item_path != routes.root_url and request_path == item_path
              assign is_active = true
            elsif block.settings.highlight_child_paths and item_path != blank and item_path != routes.root_url and request_path contains item_path
              assign is_active = true
            endif
          endif
        -%}

        <li class="rr-mobile-bottom-nav__item{% if is_active %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if item_url != blank -%}
            <a
              class="rr-mobile-bottom-nav__link"
              href="{{ item_url }}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
          {%- else -%}
            <div class="rr-mobile-bottom-nav__link rr-mobile-bottom-nav__link--static">
          {%- endif -%}
              <span class="rr-mobile-bottom-nav__icon" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  <img
                    src="{{ block.settings.icon_image | image_url: width: 80 }}"
                    alt=""
                    loading="lazy"
                    width="80"
                    height="80"
                  >
                {%- else -%}
                  {%- case block.settings.icon -%}
                    {%- when 'logo' -%}
                      {%- if settings.logo != blank -%}
                        <img
                          src="{{ settings.logo | image_url: width: 80 }}"
                          alt=""
                          loading="lazy"
                          width="80"
                          height="80"
                        >
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 10.5 12 3l9 7.5"></path>
                          <path d="M5 9.8V21h14V9.8"></path>
                          <path d="M9.5 21v-6h5v6"></path>
                        </svg>
                      {%- endif -%}
                    {%- when 'home' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9.8V21h14V9.8"></path>
                        <path d="M9.5 21v-6h5v6"></path>
                      </svg>
                    {%- when 'categories' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="4" width="6" height="6" rx="1.2"></rect>
                        <rect x="14" y="4" width="6" height="6" rx="1.2"></rect>
                        <rect x="4" y="14" width="6" height="6" rx="1.2"></rect>
                        <rect x="14" y="14" width="6" height="6" rx="1.2"></rect>
                      </svg>
                    {%- when 'offers' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 10.6V6.8c0-.9-.4-1.8-1.1-2.3l-2.1-1.6c-.5-.4-1.2-.6-1.8-.4L6.2 4.8c-.7.2-1.2.7-1.4 1.4l-2.3 8.8c-.2.7 0 1.4.4 1.9l1.6 2.1c.6.7 1.4 1.1 2.3 1.1h3.8"></path>
                        <path d="m8.5 8.5 7 7"></path>
                        <path d="M9 14a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path>
                        <path d="M15 10a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path>
                      </svg>
                    {%- when 'account' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="7.25" r="3.25"></circle>
                        <path d="M5 20c1.6-3.2 4.1-4.8 7-4.8S17.4 16.8 19 20"></path>
                      </svg>
                    {%- when 'download' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 4v10"></path>
                        <path d="m8 10.5 4 4 4-4"></path>
                        <path d="M4 20h16"></path>
                      </svg>
                    {%- when 'cart' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="19" r="1.25"></circle>
                        <circle cx="17" cy="19" r="1.25"></circle>
                        <path d="M3 4h2l2.2 9.2a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 7H7"></path>
                      </svg>
                    {%- when 'search' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="6"></circle>
                        <path d="m20 20-4.2-4.2"></path>
                      </svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20.5 4.7 13.3a4.7 4.7 0 0 1 6.6-6.6L12 7.4l.7-.7a4.7 4.7 0 0 1 6.6 6.6Z"></path>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9.8V21h14V9.8"></path>
                        <path d="M9.5 21v-6h5v6"></path>
                      </svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <span class="rr-mobile-bottom-nav__label">{{ block.settings.label | escape }}</span>
          {%- if item_url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Mobile sticky navigation",
  "tag": "section",
  "class": "section section-mobile-sticky-navigation",
  "max_blocks": 5,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Mobile navigation"
    },
    {
      "type": "checkbox",
      "id": "show_separators",
      "label": "Show item dividers",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icon color",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#14a3ff"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 22
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 9,
      "max": 14,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 12
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 56,
      "max": 88,
      "step": 2,
      "unit": "px",
      "label": "Bar height",
      "default": 64
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "label": "Shadow opacity",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Navigation item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Menu"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in icon",
          "default": "home",
          "options": [
            {
              "value": "logo",
              "label": "Logo"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "categories",
              "label": "Categories"
            },
            {
              "value": "offers",
              "label": "Offers"
            },
            {
              "value": "account",
              "label": "Account"
            },
            {
              "value": "download",
              "label": "Download"
            },
            {
              "value": "cart",
              "label": "Cart"
            },
            {
              "value": "search",
              "label": "Search"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "highlight_child_paths",
          "label": "Keep active on child pages",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile sticky navigation",
      "blocks": [
        {
          "type": "nav_item"
        },
        {
          "type": "nav_item"
        },
        {
          "type": "nav_item"
        },
        {
          "type": "nav_item"
        },
        {
          "type": "nav_item"
        }
      ]
    }
  ]
}
{% endschema %}
