{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign custom_author = article.metafields.custom.author.value
  if custom_author == blank
    assign custom_author = article.author
  endif

  assign article_words = article.content | strip_html | split: ' ' | size
  assign reading_time = article_words | divided_by: 200
  if reading_time < 1
    assign reading_time = 1
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ap-blog-bg: #ffffff;
    --ap-blog-surface: #f7f7f7;
    --ap-blog-text: rgba(var(--color-foreground), 0.92);
    --ap-blog-muted: rgba(var(--color-foreground), 0.62);
    --ap-blog-border: rgba(var(--color-foreground), 0.11);
    --ap-blog-radius: 22px;
    --ap-blog-small-radius: 14px;
  }

  #shopify-section-{{ section.id }} .article-template {
    background: var(--ap-blog-bg);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ap-article-width {
    width: min(100% - 3rem, 860px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .ap-article-wide {
    width: min(100% - 3rem, 1240px);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .article-template__hero-container {
    max-width: 1240px;
    margin: 3rem auto 0;
    padding-inline: 1.5rem;
  }

  #shopify-section-{{ section.id }} .article-template__hero-container .media {
    border-radius: var(--ap-blog-radius);
    overflow: hidden;
    background: var(--ap-blog-surface);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.07);
  }

  #shopify-section-{{ section.id }} .article-template__hero-container img {
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .article-template__hero-container:hover img {
      transform: scale(1.015);
    }
  }

  #shopify-section-{{ section.id }} .ap-article-header {
    padding-top: clamp(4rem, 7vw, 7.5rem);
    padding-bottom: clamp(2.6rem, 5vw, 4.6rem);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ap-article-kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.2rem;
    margin: 0 0 1.8rem;
    padding: 0.65rem 1.25rem;
    border: 1px solid var(--ap-blog-border);
    border-radius: 999px;
    color: var(--ap-blog-muted);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    background: rgba(var(--color-foreground), 0.025);
  }

  #shopify-section-{{ section.id }} .article-template__title {
    max-width: 900px;
    margin: 0 auto;
    color: var(--ap-blog-text);
    font-size: clamp(3.2rem, 5vw, 6.4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .ap-article-excerpt {
    max-width: 720px;
    margin: 2rem auto 0;
    color: var(--ap-blog-muted);
    font-size: clamp(1.6rem, 2vw, 1.9rem);
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .ap-article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem 1.2rem;
    margin-top: 2.3rem;
    color: var(--ap-blog-muted);
    font-size: 1.3rem;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .ap-article-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  #shopify-section-{{ section.id }} .ap-article-meta__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.55;
  }

  #shopify-section-{{ section.id }} .ap-article-author {
    color: var(--ap-blog-text);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .article-template__content {
    width: min(100% - 3rem, 820px);
    max-width: none;
    margin: 0 auto;
    padding-top: clamp(3.4rem, 5vw, 5.5rem);
    padding-bottom: 1rem;
    color: var(--ap-blog-text);
    font-size: clamp(1.6rem, 1.45vw, 1.85rem);
    line-height: 1.82;
  }

  #shopify-section-{{ section.id }} .article-template__content > *:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .article-template__content p {
    margin: 0 0 1.75em;
  }

  #shopify-section-{{ section.id }} .article-template__content h2,
  #shopify-section-{{ section.id }} .article-template__content h3,
  #shopify-section-{{ section.id }} .article-template__content h4 {
    color: var(--ap-blog-text);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .article-template__content h2 {
    margin: 2.2em 0 0.75em;
    font-size: clamp(2.6rem, 3vw, 3.8rem);
  }

  #shopify-section-{{ section.id }} .article-template__content h3 {
    margin: 2em 0 0.7em;
    font-size: clamp(2.1rem, 2.3vw, 2.8rem);
  }

  #shopify-section-{{ section.id }} .article-template__content h4 {
    margin: 1.8em 0 0.6em;
    font-size: clamp(1.8rem, 2vw, 2.2rem);
  }

  #shopify-section-{{ section.id }} .article-template__content a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  #shopify-section-{{ section.id }} .article-template__content img {
    height: auto;
    margin: 2.8rem auto;
    border-radius: var(--ap-blog-small-radius);
    box-shadow: 0 12px 34px rgba(0, 0, 0, 0.06);
  }

  #shopify-section-{{ section.id }} .article-template__content blockquote {
    position: relative;
    margin: 3.5rem 0;
    padding: 2.4rem 2.5rem 2.4rem 3rem;
    border: 0;
    border-left: 3px solid rgba(var(--color-foreground), 0.72);
    border-radius: 0 var(--ap-blog-small-radius) var(--ap-blog-small-radius) 0;
    background: var(--ap-blog-surface);
    color: var(--ap-blog-text);
    font-size: 1.08em;
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .article-template__content blockquote p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .article-template__content ul,
  #shopify-section-{{ section.id }} .article-template__content ol {
    margin: 1.5rem 0 2.5rem;
    padding-left: 2.4rem;
  }

  #shopify-section-{{ section.id }} .article-template__content li {
    margin-bottom: 0.75rem;
    padding-left: 0.45rem;
  }

  #shopify-section-{{ section.id }} .article-template__content hr {
    height: 1px;
    margin: 4.5rem 0;
    border: 0;
    background: var(--ap-blog-border);
  }

  #shopify-section-{{ section.id }} .article-template__content table {
    width: 100%;
    margin: 3rem 0;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border: 1px solid var(--ap-blog-border);
    border-radius: var(--ap-blog-small-radius);
    font-size: 0.92em;
  }

  #shopify-section-{{ section.id }} .article-template__content th,
  #shopify-section-{{ section.id }} .article-template__content td {
    padding: 1.25rem 1.4rem;
    border-right: 1px solid var(--ap-blog-border);
    border-bottom: 1px solid var(--ap-blog-border);
    text-align: left;
    vertical-align: top;
  }

  #shopify-section-{{ section.id }} .article-template__content th {
    background: var(--ap-blog-surface);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .article-template__content tr:last-child td {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .article-template__content th:last-child,
  #shopify-section-{{ section.id }} .article-template__content td:last-child {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .article-template__social-sharing {
    width: min(100% - 3rem, 820px);
    max-width: none;
    margin: 3.5rem auto 0;
    padding: 2.2rem 0;
    border-top: 1px solid var(--ap-blog-border);
    border-bottom: 1px solid var(--ap-blog-border);
  }

  #shopify-section-{{ section.id }} .article-template__back {
    width: min(100% - 3rem, 820px);
    margin: 3rem auto clamp(5rem, 8vw, 8rem);
  }

  #shopify-section-{{ section.id }} .article-template__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 4.6rem;
    padding: 0.9rem 1.7rem;
    border: 1px solid var(--ap-blog-border);
    border-radius: 999px;
    color: var(--ap-blog-text);
    text-decoration: none;
    background: #fff;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  @media (hover: hover) {
    #shopify-section-{{ section.id }} .article-template__link:hover {
      transform: translateY(-2px);
      border-color: rgba(var(--color-foreground), 0.28);
      background: var(--ap-blog-surface);
    }
  }

  #shopify-section-{{ section.id }} .article-template__comment-wrapper {
    margin-top: 0;
    padding: clamp(5rem, 8vw, 8rem) 0;
    border-top: 1px solid var(--ap-blog-border);
    background: var(--ap-blog-surface);
  }

  #shopify-section-{{ section.id }} .article-template__comment-wrapper .page-width--narrow {
    max-width: 820px;
  }

  #shopify-section-{{ section.id }} .article-template__comment-wrapper h2 {
    margin-top: 0;
    margin-bottom: 2.4rem;
    font-size: clamp(2.5rem, 3vw, 3.4rem);
    letter-spacing: -0.025em;
  }

  #shopify-section-{{ section.id }} .article-template__comments-comment {
    margin-bottom: 1.5rem;
    padding: 2rem;
    border: 1px solid var(--ap-blog-border);
    border-radius: var(--ap-blog-small-radius);
    background: #fff;
  }

  #shopify-section-{{ section.id }} .article-template__comments-comment footer {
    margin-top: 1.4rem;
    color: var(--ap-blog-muted);
  }

  #shopify-section-{{ section.id }} .article-template__comment-wrapper .field__input,
  #shopify-section-{{ section.id }} .article-template__comment-wrapper .text-area {
    border-radius: 10px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .article-template__comment-wrapper .button {
    min-height: 4.8rem;
    border-radius: 999px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --ap-blog-radius: 16px;
      --ap-blog-small-radius: 12px;
    }

    #shopify-section-{{ section.id }} .ap-article-width,
    #shopify-section-{{ section.id }} .ap-article-wide,
    #shopify-section-{{ section.id }} .article-template__content,
    #shopify-section-{{ section.id }} .article-template__social-sharing,
    #shopify-section-{{ section.id }} .article-template__back {
      width: min(100% - 2.4rem, 860px);
    }

    #shopify-section-{{ section.id }} .article-template__hero-container {
      margin-top: 1.2rem;
      padding-inline: 1.2rem;
    }

    #shopify-section-{{ section.id }} .ap-article-header {
      padding-top: 3.2rem;
      padding-bottom: 2.5rem;
    }

    #shopify-section-{{ section.id }} .ap-article-kicker {
      margin-bottom: 1.4rem;
      font-size: 1.05rem;
    }

    #shopify-section-{{ section.id }} .article-template__title {
      font-size: clamp(3rem, 10vw, 4.4rem);
      line-height: 1.08;
    }

    #shopify-section-{{ section.id }} .ap-article-excerpt {
      margin-top: 1.6rem;
      font-size: 1.55rem;
    }

    #shopify-section-{{ section.id }} .ap-article-meta {
      margin-top: 1.8rem;
      gap: 0.6rem 0.9rem;
      font-size: 1.2rem;
    }

    #shopify-section-{{ section.id }} .article-template__content {
      padding-top: 2.5rem;
      font-size: 1.6rem;
      line-height: 1.75;
    }

    #shopify-section-{{ section.id }} .article-template__content h2 {
      margin-top: 1.9em;
    }

    #shopify-section-{{ section.id }} .article-template__content img {
      margin: 2.2rem auto;
    }

    #shopify-section-{{ section.id }} .article-template__content blockquote {
      margin: 2.5rem 0;
      padding: 1.8rem 1.8rem 1.8rem 2.1rem;
    }

    #shopify-section-{{ section.id }} .article-template__content table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .article-template__social-sharing {
      margin-top: 2.5rem;
    }

    #shopify-section-{{ section.id }} .article-template__back {
      margin-top: 2.4rem;
      margin-bottom: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .article-template__hero-container img,
    #shopify-section-{{ section.id }} .article-template__link {
      transition: none;
    }
  }
</style>

<article class="article-template">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="page-width page-width--narrow">
          {% render block %}
        </div>

      {%- when 'featured_image' -%}
        {%- if article.image -%}
          <div
            class="article-template__hero-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div
              class="article-template__hero-{{ block.settings.image_height }} media"
              {% if block.settings.image_height == 'adapt' and article.image %}
                style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              <img
                srcset="
                  {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                  {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                  {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                  {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                  {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                  {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                  {{ article.image | image_url }} {{ article.image.width }}w
                "
                sizes="(min-width: {{ settings.page_width }}px) 1240px, (min-width: 750px) calc(100vw - 6rem), calc(100vw - 2.4rem)"
                src="{{ article.image | image_url: width: 1500 }}"
                loading="eager"
                fetchpriority="high"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
              >
            </div>
          </div>
        {%- endif -%}

      {%- when 'title' -%}
        <header
          class="ap-article-header ap-article-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if blog.title != blank -%}
            <div class="ap-article-kicker">{{ blog.title | escape }}</div>
          {%- endif -%}

          <h1 class="article-template__title">
            {{ article.title | escape }}
          </h1>

          {%- if article.excerpt != blank -%}
            <div class="ap-article-excerpt">
              {{ article.excerpt | strip_html }}
            </div>
          {%- endif -%}

          {%- if block.settings.blog_show_date or block.settings.blog_show_author -%}
            <div class="ap-article-meta">
              {%- if block.settings.blog_show_author -%}
                <span class="ap-article-meta__item">
                  <span>By</span>
                  <span class="ap-article-author">{{ custom_author | escape }}</span>
                </span>
              {%- endif -%}

              {%- if block.settings.blog_show_author and block.settings.blog_show_date -%}
                <span class="ap-article-meta__dot" aria-hidden="true"></span>
              {%- endif -%}

              {%- if block.settings.blog_show_date -%}
                <span class="ap-article-meta__item">
                  {{- article.published_at | time_tag: format: 'date' -}}
                </span>
              {%- endif -%}

              <span class="ap-article-meta__dot" aria-hidden="true"></span>
              <span class="ap-article-meta__item">{{ reading_time }} min read</span>
            </div>
          {%- endif -%}
        </header>

      {%- when 'content' -%}
        <div
          class="article-template__content rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ article.content }}
        </div>

      {%- when 'share' -%}
        <div
          class="article-template__social-sharing{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% assign share_url = request.origin | append: article.url %}
          {% render 'share-button', block: block, share_link: share_url %}
        </div>
    {%- endcase -%}
  {%- endfor -%}

  <div class="article-template__back center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
      <span class="icon-wrap">
        <span class="svg-wrapper">
          {{- 'icon-arrow.svg' | inline_asset_content -}}
        </span>
      </span>
      {{ 'blogs.article.back_to_blog' | t: title: blog.title | escape }}
    </a>
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>

          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                    <span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}

              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}

        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}

          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>

          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>

            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div{% if blog.moderated? == false %} class="article-template__comments-fields"{% endif %}>
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span>
                </label>

                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.
                    </span>
                  </small>
                {%- endif -%}
              </div>

              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>

                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.
                    </span>
                  </small>
                {%- endif -%}
              </div>
            </div>

            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span>
              </label>
            </div>

            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.
                </span>
              </small>
            {%- endif -%}
          </div>

          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}

          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

