{% style %}
  #shopify-section-{{ section.id }} .simple-available {
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .simple-available__inner {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .simple-available__heading {
    margin: 0 0 24px;
    text-align: center;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .simple-available__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.logo_gap }}px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .simple-available__slider {
    display: flex !important;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: {{ section.settings.logo_gap }}px;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  #shopify-section-{{ section.id }} .simple-available__slider::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .simple-available__slider .simple-available__item {
    flex: 0 0 calc((100% - ({{ section.settings.logo_gap }}px * {{ section.settings.desktop_slider_items | minus: 1 }})) / {{ section.settings.desktop_slider_items }});
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .simple-available__item {
    min-height: {{ section.settings.card_height }}px;
    padding: 14px 18px;
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: {{ section.settings.card_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .simple-available__item:hover {
    transform: translateY(-2px);
    border-color: {{ section.settings.card_hover_border }};
  }

  #shopify-section-{{ section.id }} .simple-available__logo {
    display: block;
    max-width: {{ section.settings.logo_max_width }}px;
    max-height: {{ section.settings.logo_max_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .simple-available__text {
    color: {{ section.settings.text_logo_color }};
    font-size: 18px;
    font-weight: 600;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .simple-available__arrows {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .simple-available__arrow {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.card_border }};
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.text_logo_color }};
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  #shopify-section-{{ section.id }} .simple-available__arrow:hover {
    border-color: {{ section.settings.card_hover_border }};
    transform: translateY(-2px);
  }

  {% if section.settings.layout_type == 'grid' %}
    #shopify-section-{{ section.id }} .simple-available__arrows {
      display: none;
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .simple-available__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .simple-available__slider .simple-available__item {
      flex: 0 0 calc((100% - ({{ section.settings.logo_gap }}px * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .simple-available {
      padding: {{ section.settings.mobile_padding_top }}px 14px {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .simple-available__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      margin-bottom: 18px;
    }

    #shopify-section-{{ section.id }} .simple-available__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: {{ section.settings.mobile_logo_gap }}px;
    }

    #shopify-section-{{ section.id }} .simple-available__slider {
      gap: {{ section.settings.mobile_logo_gap }}px;
    }

    #shopify-section-{{ section.id }} .simple-available__slider .simple-available__item {
      flex: 0 0 calc((100% - ({{ section.settings.mobile_logo_gap }}px * {{ section.settings.mobile_slider_items | minus: 1 }})) / {{ section.settings.mobile_slider_items }});
    }

    #shopify-section-{{ section.id }} .simple-available__item {
      min-height: {{ section.settings.mobile_card_height }}px;
      padding: 12px;
      border-radius: {{ section.settings.mobile_card_radius }}px;
    }

    #shopify-section-{{ section.id }} .simple-available__logo {
      max-width: {{ section.settings.mobile_logo_max_width }}px;
      max-height: {{ section.settings.mobile_logo_max_height }}px;
    }

    #shopify-section-{{ section.id }} .simple-available__text {
      font-size: 15px;
    }
  }
{% endstyle %}

<section class="simple-available">
  <div class="simple-available__inner">
    {% if section.settings.heading != blank %}
      <h2 class="simple-available__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="simple-available__grid{% if section.settings.layout_type == 'slider' %} simple-available__slider{% endif %}">
      {% for block in section.blocks %}
        {% assign alt_text = block.settings.logo_alt | default: block.settings.platform_name %}

        {% if block.settings.platform_link != blank %}
          <a
            href="{{ block.settings.platform_link }}"
            class="simple-available__item"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
        {% else %}
          <div class="simple-available__item" {{ block.shopify_attributes }}>
        {% endif %}

          {% if block.settings.logo_image != blank %}
            {{
              block.settings.logo_image
              | image_url: width: 360
              | image_tag:
                class: 'simple-available__logo',
                loading: 'lazy',
                alt: alt_text
            }}
          {% elsif block.settings.logo_external_url != blank %}
            <img
              src="{{ block.settings.logo_external_url | escape }}"
              alt="{{ alt_text | escape }}"
              class="simple-available__logo"
              loading="lazy"
            >
          {% elsif block.settings.platform_name != blank %}
            <span class="simple-available__text">
              {{ block.settings.platform_name }}
            </span>
          {% endif %}

        {% if block.settings.platform_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.layout_type == 'slider' and section.settings.show_arrows %}
      <div class="simple-available__arrows">
        <button type="button" class="simple-available__arrow simple-available__arrow--prev" aria-label="Previous">
          &#10094;
        </button>
        <button type="button" class="simple-available__arrow simple-available__arrow--next" aria-label="Next">
          &#10095;
        </button>
      </div>
    {% endif %}
  </div>
</section>

{% if section.settings.layout_type == 'slider' %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      const slider = section.querySelector('.simple-available__slider');
      const nextBtn = section.querySelector('.simple-available__arrow--next');
      const prevBtn = section.querySelector('.simple-available__arrow--prev');

      if (!slider) return;

      const getScrollStep = function () {
        const item = slider.querySelector('.simple-available__item');
        if (!item) return 200;

        const gap = window.innerWidth <= 749
          ? {{ section.settings.mobile_logo_gap }}
          : {{ section.settings.logo_gap }};

        return item.offsetWidth + gap;
      };

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          slider.scrollBy({
            left: getScrollStep(),
            behavior: 'smooth'
          });
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          slider.scrollBy({
            left: -getScrollStep(),
            behavior: 'smooth'
          });
        });
      }

      {% if section.settings.enable_autoplay %}
        let autoplayTimer;

        const startAutoplay = function () {
          autoplayTimer = setInterval(function () {
            const maxScroll = slider.scrollWidth - slider.clientWidth;

            if (slider.scrollLeft >= maxScroll - 5) {
              slider.scrollTo({
                left: 0,
                behavior: 'smooth'
              });
            } else {
              slider.scrollBy({
                left: getScrollStep(),
                behavior: 'smooth'
              });
            }
          }, {{ section.settings.slider_speed | times: 1000 }});
        };

        const stopAutoplay = function () {
          clearInterval(autoplayTimer);
        };

        slider.addEventListener('mouseenter', stopAutoplay);
        slider.addEventListener('mouseleave', startAutoplay);
        slider.addEventListener('touchstart', stopAutoplay, { passive: true });
        slider.addEventListener('touchend', startAutoplay);

        startAutoplay();
      {% endif %}
    });
  </script>
{% endif %}

