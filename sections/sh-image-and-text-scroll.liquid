{% capture sh_image_and_text_scroll_css %}
  <style>
    #sh-{{ section.id }}.sh-img-text-scroll-section {padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;background: {{ section.settings.bg_color }};overflow: hidden;}
    #sh-{{ section.id }} .sh-page-width.sh-page-full-width {max-width: 100%;padding: 0;}
    #sh-{{ section.id }} .sh-img-text-scroll-wrapper {position: relative;}
    #sh-{{ section.id }} .sh-img-scroll-item {min-width: 300px; padding:0 10px;}
    #sh-{{ section.id }} .sh-img-scroll-item-wrapper {white-space: nowrap;position: relative;transform: translate3d(0%, 0, 0);animation-name: sh-img-marquee;animation-timing-function: linear; animation-iteration-count: infinite;animation-duration: {{ section.settings.image_scroll_time }}s;display: flex;align-items: center;}
    #sh-{{ section.id }} .sh-img-scroll-item img {width: 300px;height: 300px;object-fit: cover; cursor: pointer;}
    #sh-{{ section.id }} .sh-img-scroll-block {display: flex;align-items: center;}
    #sh-{{ section.id }} .sh-img-scroll-block.sh-hover-pause-scroll:hover .sh-img-scroll-item-wrapper {animation-play-state: paused !important;}
    #sh-{{ section.id }} .sh-text-scroll-block {display: inline-flex;align-items: center;position: absolute;top: 50%;transform: translateY(-50%);z-index: 1;background: transparent;padding: 10px 0;}
    #sh-{{ section.id }} .sh-text-scroll-item-wrapper {white-space: nowrap;position: relative;animation-name: sh-img-marquee;animation-direction: reverse;animation-timing-function: linear;animation-iteration-count: infinite;animation-duration: {{ section.settings.text_scroll_time }}s;display: flex;align-items: center;}
    #sh-{{ section.id }} .sh-text-scroll-item {cursor: pointer;min-width: 300px;padding: 0 10px;display: flex;gap: 30px;align-items: center;justify-content: center; padding-right: 60px;}
    #sh-{{ section.id }} .sh-text-scroll-item h3 {font-size: {{ section.settings.title_font_size }}px;line-height: 1.3;margin: 0;color: {{ section.settings.title_color }};}
    #sh-{{ section.id }} .sh-text-scroll-item h3.sh-text-outline {-webkit-text-fill-color: transparent;-webkit-text-stroke-color: {{ section.settings.title_color }};-webkit-text-stroke-width: 0.03em;}
    #sh-{{ section.id }} .sh-text-scroll-item img {width: 40px;height: auto;object-fit: contain;}
    #sh-{{ section.id }} .sh-text-scroll-block.sh-hover-pause-scroll:hover .sh-text-scroll-item-wrapper {animation-play-state: paused !important;}
    @keyframes sh-img-marquee {
      0% { transform: translate3d(0%, 0, 0); }
      100% {transform: translate3d(-100%, 0, 0);} 
    }
  
    @media only screen and (max-width: 767px){
      #sh-{{ section.id }}.sh-img-text-scroll-section {padding: {{ section.settings.mobile_padding_top }}px 0px {{ section.settings.mobile_padding_bottom }}px;}
      #sh-{{ section.id }} .sh-img-scroll-item img {width: 180px;height: 180px;}
      #sh-{{ section.id }} .sh-img-scroll-item {min-width: 180px;padding: 0 5px;}
      #sh-{{ section.id }} .sh-text-scroll-item {gap: 20px;padding-right: 30px;} 
      #sh-{{ section.id }} .sh-text-scroll-item h3 {font-size: 26px;} 
      #sh-{{ section.id }} .sh-text-scroll-item img {width: 26px;}    
    }
  </style>
{% endcapture %}
{{ sh_image_and_text_scroll_css | strip_newlines }}

{% if section.blocks.size > 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'text' %}
      
      {% capture scroll_text_list %}
        {% for i in (1..20) %}
          {% capture title_id %}title_{{ i }}{% endcapture %}
          {% capture icon_id %}icon_{{ i }}{% endcapture %}
          {% assign title = block.settings[title_id] %}
          {% assign icon = block.settings[icon_id] %}
          {% if title != blank %}
            <div class="sh-text-scroll-item">
              <h3 {% if section.settings.outline_text %}class="sh-text-outline"{% endif %}>{{ title }}</h3>
              {% if icon != blank %}
                <img src="{{ icon | image_url: width: icon.width }}" alt="{{ icon.alt | default: "Image and text scroll icon" }}" loading="lazy" width="" height="">
              {% else %}
                <img src="https://img.icons8.com/?size=100&id=7789&format=png&color=000000" alt="{{ title }}" loading="lazy" width="" height="">
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      
    {% elsif block.type == 'image' %}
      {% capture scroll_image_list %}
        {% assign has_image = false %}
        
        {% for i in (1..20) %}
          {% capture image_id %}image_{{ i }}{% endcapture %}
          {% assign image = block.settings[image_id] %}
  
          {% if image != blank %}
            <div class="sh-img-scroll-item">
              <img src="{{ image | image_url: width: image.width }}" alt="{{ image.alt | default: "Image scroll Media" }}" loading="lazy" width="" height="">
            </div>
            {% assign has_image = true %}
          {% endif %}
        {% endfor %}
        
        {% if has_image == false %}
          {% for i in (1..3) %}
            <div class="sh-img-scroll-item">
              <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" height="" alt="empty-image"/>
            </div>
          {% endfor %}  
        {% endif %}
      {% endcapture %}
    {% endif %}
  {% endfor %}
  
  <div id="sh-{{ section.id }}" class="sh-img-text-scroll-section">
    <div class="sh-page-with sh-page-full-width">
      <div class="sh-img-text-scroll-wrapper">
        <div class="sh-text-scroll-block{% if section.settings.hover_pause %} sh-hover-pause-scroll{% endif %}">
          {% for i in (0..2) %}
            <div class="sh-text-scroll-item-wrapper">{{ scroll_text_list }}</div>
          {% endfor %}
        </div> 
        <div class="sh-img-scroll-block{% if section.settings.hover_pause %} sh-hover-pause-scroll{% endif %}">
          {% for i in (0..2) %}
            <div class="sh-img-scroll-item-wrapper">{{ scroll_image_list }}</div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

