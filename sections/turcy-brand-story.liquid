{% comment %}
  Turcy Brand Story Section
  Premium customizable Shopify section
{% endcomment %}

<section
  id="TurcyStory-{{ section.id }}"
  class="turcy-story"
  style="
    --turcy-bg: {{ section.settings.bg_color }};
    --turcy-card: {{ section.settings.card_color }};
    --turcy-primary: {{ section.settings.primary_color }};
    --turcy-accent: {{ section.settings.accent_color }};
    --turcy-soft: {{ section.settings.soft_color }};
    --turcy-text: {{ section.settings.text_color }};
    --turcy-muted: {{ section.settings.muted_color }};
    --turcy-border: {{ section.settings.border_color }};
    --turcy-radius: {{ section.settings.radius }}px;
    --turcy-max-width: {{ section.settings.max_width }}px;
    --turcy-padding-top: {{ section.settings.padding_top }}px;
    --turcy-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="turcy-story__wrap">

    {% if section.settings.show_hero %}
      <div class="turcy-story__hero">
        <div class="turcy-story__hero-content">
          {% if section.settings.eyebrow != blank %}
            <p class="turcy-story__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1>{{ section.settings.heading }}</h1>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <div class="turcy-story__subheading rte">
              {{ section.settings.subheading }}
            </div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="turcy-story__button">
              {{ section.settings.button_label }}
              <span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>

        <div class="turcy-story__hero-visual">
          {% if section.settings.hero_image != blank %}
            {{
              section.settings.hero_image
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                class: 'turcy-story__hero-img',
                alt: section.settings.heading
            }}
          {% else %}
            <div class="turcy-story__botanical-card">
              <div class="turcy-story__circle turcy-story__circle--one"></div>
              <div class="turcy-story__circle turcy-story__circle--two"></div>
              <div class="turcy-story__seed">
                <span>Tur</span>
                <strong>+</strong>
                <span>Cy</span>
              </div>
              <p>Turn · Catalyst · Transformation</p>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_meaning %}
      <div class="turcy-story__meaning">
        <div class="turcy-story__meaning-card">
          <span>Tur</span>
          <h3>Turn</h3>
          <p>{{ section.settings.tur_text }}</p>
        </div>

        <div class="turcy-story__meaning-plus">+</div>

        <div class="turcy-story__meaning-card">
          <span>Cy</span>
          <h3>Catalyst</h3>
          <p>{{ section.settings.cy_text }}</p>
        </div>

        <div class="turcy-story__meaning-result">
          <span>Turcy</span>
          <h3>Transformation</h3>
          <p>{{ section.settings.result_text }}</p>
        </div>
      </div>
    {% endif %}

    <div class="turcy-story__blocks">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when 'story_text' %}
            <article class="turcy-story__section turcy-story__section--{{ block.settings.layout }}" {{ block.shopify_attributes }}>
              <div class="turcy-story__section-content">
                {% if block.settings.kicker != blank %}
                  <p class="turcy-story__kicker">{{ block.settings.kicker }}</p>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h2>{{ block.settings.heading }}</h2>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="turcy-story__richtext rte">
                    {{ block.settings.text }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.image != blank %}
                <div class="turcy-story__section-image">
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'turcy-story__img',
                      alt: block.settings.heading
                  }}
                </div>
              {% endif %}
            </article>

          {% when 'highlight' %}
            <div class="turcy-story__highlight" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>

          {% when 'values_grid' %}
            <div class="turcy-story__values" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <div class="turcy-story__values-head">
                  <p class="turcy-story__kicker">{{ block.settings.kicker }}</p>
                  <h2>{{ block.settings.heading }}</h2>
                </div>
              {% endif %}

              <div class="turcy-story__values-grid">
                {% if block.settings.value_1_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>01</span>
                    <h3>{{ block.settings.value_1_title }}</h3>
                    <p>{{ block.settings.value_1_text }}</p>
                  </div>
                {% endif %}

                {% if block.settings.value_2_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>02</span>
                    <h3>{{ block.settings.value_2_title }}</h3>
                    <p>{{ block.settings.value_2_text }}</p>
                  </div>
                {% endif %}

                {% if block.settings.value_3_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>03</span>
                    <h3>{{ block.settings.value_3_title }}</h3>
                    <p>{{ block.settings.value_3_text }}</p>
                  </div>
                {% endif %}

                {% if block.settings.value_4_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>04</span>
                    <h3>{{ block.settings.value_4_title }}</h3>
                    <p>{{ block.settings.value_4_text }}</p>
                  </div>
                {% endif %}

                {% if block.settings.value_5_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>05</span>
                    <h3>{{ block.settings.value_5_title }}</h3>
                    <p>{{ block.settings.value_5_text }}</p>
                  </div>
                {% endif %}

                {% if block.settings.value_6_title != blank %}
                  <div class="turcy-story__value-card">
                    <span>06</span>
                    <h3>{{ block.settings.value_6_title }}</h3>
                    <p>{{ block.settings.value_6_text }}</p>
                  </div>
                {% endif %}
              </div>
            </div>

          {% when 'mission_list' %}
            <div class="turcy-story__mission" {{ block.shopify_attributes }}>
              <div>
                {% if block.settings.kicker != blank %}
                  <p class="turcy-story__kicker">{{ block.settings.kicker }}</p>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <h2>{{ block.settings.heading }}</h2>
                {% endif %}
              </div>

              <div class="turcy-story__mission-list">
                {% if block.settings.item_1 != blank %}
                  <div><span></span>{{ block.settings.item_1 }}</div>
                {% endif %}
                {% if block.settings.item_2 != blank %}
                  <div><span></span>{{ block.settings.item_2 }}</div>
                {% endif %}
                {% if block.settings.item_3 != blank %}
                  <div><span></span>{{ block.settings.item_3 }}</div>
                {% endif %}
                {% if block.settings.item_4 != blank %}
                  <div><span></span>{{ block.settings.item_4 }}</div>
                {% endif %}
                {% if block.settings.item_5 != blank %}
                  <div><span></span>{{ block.settings.item_5 }}</div>
                {% endif %}
                {% if block.settings.item_6 != blank %}
                  <div><span></span>{{ block.settings.item_6 }}</div>
                {% endif %}
              </div>
            </div>

          {% when 'philosophy' %}
            <div class="turcy-story__philosophy" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              <div class="turcy-story__flow">
                <div>
                  <span>01</span>
                  <strong>{{ block.settings.step_1 }}</strong>
                </div>
                <em></em>
                <div>
                  <span>02</span>
                  <strong>{{ block.settings.step_2 }}</strong>
                </div>
                <em></em>
                <div>
                  <span>03</span>
                  <strong>{{ block.settings.step_3 }}</strong>
                </div>
              </div>

              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>

          {% when 'final_cta' %}
            <div class="turcy-story__final" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a href="{{ block.settings.button_link | default: '#' }}" class="turcy-story__button turcy-story__button--light">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #TurcyStory-{{ section.id }} {
    background:
      radial-gradient(circle at 12% 8%, rgba(231, 129, 61, 0.16), transparent 26%),
      radial-gradient(circle at 88% 20%, rgba(220, 232, 215, 0.8), transparent 30%),
      var(--turcy-bg);
    padding: var(--turcy-padding-top) 20px var(--turcy-padding-bottom);
    color: var(--turcy-text);
  }

  #TurcyStory-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TurcyStory-{{ section.id }} .turcy-story__wrap {
    max-width: var(--turcy-max-width);
    margin: 0 auto;
  }

  #TurcyStory-{{ section.id }} .turcy-story__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(320px, 0.78fr);
    gap: 44px;
    align-items: center;
    min-height: 620px;
    padding: 52px;
    background: linear-gradient(135deg, #fffaf3 0%, #f7ead8 100%);
    border: 1px solid rgba(25, 61, 53, 0.12);
    border-radius: calc(var(--turcy-radius) + 18px);
    overflow: hidden;
    position: relative;
  }

  #TurcyStory-{{ section.id }} .turcy-story__hero::before {
    content: "";
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    background: rgba(231, 129, 61, 0.14);
    top: -110px;
    right: -100px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__hero-content,
  #TurcyStory-{{ section.id }} .turcy-story__hero-visual {
    position: relative;
    z-index: 2;
  }

  #TurcyStory-{{ section.id }} .turcy-story__eyebrow,
  #TurcyStory-{{ section.id }} .turcy-story__kicker {
    margin: 0 0 12px;
    color: var(--turcy-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #TurcyStory-{{ section.id }} h1,
  #TurcyStory-{{ section.id }} h2,
  #TurcyStory-{{ section.id }} h3 {
    color: var(--turcy-primary);
    margin: 0;
    letter-spacing: -0.035em;
  }

  #TurcyStory-{{ section.id }} h1 {
    font-size: clamp(42px, 6vw, 82px);
    line-height: 0.95;
    max-width: 760px;
  }

  #TurcyStory-{{ section.id }} h2 {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.04;
  }

  #TurcyStory-{{ section.id }} h3 {
    font-size: 22px;
    line-height: 1.15;
  }

  #TurcyStory-{{ section.id }} .rte,
  #TurcyStory-{{ section.id }} p {
    color: var(--turcy-text);
    font-size: 16px;
    line-height: 1.8;
  }

  #TurcyStory-{{ section.id }} .turcy-story__subheading {
    max-width: 700px;
    margin-top: 22px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__button {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--turcy-primary);
    color: #ffffff;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    transition: transform 0.25s ease, background 0.25s ease;
  }

  #TurcyStory-{{ section.id }} .turcy-story__button:hover {
    background: var(--turcy-accent);
    transform: translateY(-2px);
  }

  #TurcyStory-{{ section.id }} .turcy-story__button span {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255,255,255,0.14);
  }

  #TurcyStory-{{ section.id }} .turcy-story__hero-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--turcy-radius);
    object-fit: cover;
  }

  #TurcyStory-{{ section.id }} .turcy-story__botanical-card {
    min-height: 420px;
    border-radius: 999px 999px 36px 36px;
    background:
      radial-gradient(circle at 50% 18%, rgba(231,129,61,0.28), transparent 24%),
      linear-gradient(180deg, #fff 0%, var(--turcy-soft) 100%);
    border: 1px solid rgba(25,61,53,0.12);
    display: grid;
    place-items: center;
    text-align: center;
    padding: 38px;
    position: relative;
    box-shadow: 0 22px 70px rgba(25, 61, 53, 0.12);
  }

  #TurcyStory-{{ section.id }} .turcy-story__seed {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: var(--turcy-primary);
    color: #fff;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 4px;
    font-size: 42px;
    font-weight: 900;
    line-height: 1;
  }

  #TurcyStory-{{ section.id }} .turcy-story__seed strong {
    color: var(--turcy-accent);
  }

  #TurcyStory-{{ section.id }} .turcy-story__botanical-card p {
    margin: 18px 0 0;
    color: var(--turcy-primary);
    font-weight: 700;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1fr auto 1fr 1.1fr;
    gap: 16px;
    align-items: stretch;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-card,
  #TurcyStory-{{ section.id }} .turcy-story__meaning-result {
    background: var(--turcy-card);
    border: 1px solid var(--turcy-border);
    border-radius: var(--turcy-radius);
    padding: 26px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-card span,
  #TurcyStory-{{ section.id }} .turcy-story__meaning-result span {
    display: inline-flex;
    color: var(--turcy-accent);
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-card p,
  #TurcyStory-{{ section.id }} .turcy-story__meaning-result p {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.65;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-plus {
    display: grid;
    place-items: center;
    color: var(--turcy-accent);
    font-size: 34px;
    font-weight: 900;
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-result {
    background: var(--turcy-primary);
  }

  #TurcyStory-{{ section.id }} .turcy-story__meaning-result h3,
  #TurcyStory-{{ section.id }} .turcy-story__meaning-result p {
    color: #ffffff;
  }

  #TurcyStory-{{ section.id }} .turcy-story__blocks {
    display: grid;
    gap: 30px;
    margin-top: 34px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__section {
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    gap: 34px;
    align-items: center;
    padding: 44px;
    background: var(--turcy-card);
    border: 1px solid var(--turcy-border);
    border-radius: var(--turcy-radius);
  }

  #TurcyStory-{{ section.id }} .turcy-story__section--image_left {
    grid-template-columns: 0.82fr 1fr;
  }

  #TurcyStory-{{ section.id }} .turcy-story__section--image_left .turcy-story__section-image {
    order: -1;
  }

  #TurcyStory-{{ section.id }} .turcy-story__richtext {
    margin-top: 18px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__richtext strong,
  #TurcyStory-{{ section.id }} .rte strong {
    color: var(--turcy-primary);
  }

  #TurcyStory-{{ section.id }} .turcy-story__section-image {
    overflow: hidden;
    border-radius: calc(var(--turcy-radius) - 6px);
    background: var(--turcy-soft);
  }

  #TurcyStory-{{ section.id }} .turcy-story__img {
    width: 100%;
    min-height: 360px;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  #TurcyStory-{{ section.id }} .turcy-story__section:hover .turcy-story__img {
    transform: scale(1.04);
  }

  #TurcyStory-{{ section.id }} .turcy-story__highlight {
    padding: 54px;
    border-radius: var(--turcy-radius);
    background:
      linear-gradient(135deg, rgba(231,129,61,0.13), rgba(220,232,215,0.75)),
      #fffaf3;
    border: 1px solid var(--turcy-border);
    text-align: center;
  }

  #TurcyStory-{{ section.id }} .turcy-story__highlight .rte {
    max-width: 850px;
    margin: 16px auto 0;
  }

  #TurcyStory-{{ section.id }} .turcy-story__values {
    padding: 44px;
    border-radius: var(--turcy-radius);
    background: var(--turcy-primary);
  }

  #TurcyStory-{{ section.id }} .turcy-story__values-head {
    max-width: 760px;
    margin-bottom: 28px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__values h2,
  #TurcyStory-{{ section.id }} .turcy-story__values h3,
  #TurcyStory-{{ section.id }} .turcy-story__values p {
    color: #ffffff;
  }

  #TurcyStory-{{ section.id }} .turcy-story__values-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__value-card {
    padding: 24px;
    border-radius: calc(var(--turcy-radius) - 8px);
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
  }

  #TurcyStory-{{ section.id }} .turcy-story__value-card span {
    color: var(--turcy-accent);
    font-weight: 900;
    font-size: 13px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__value-card h3 {
    margin-top: 12px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__value-card p {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.65;
    opacity: 0.9;
  }

  #TurcyStory-{{ section.id }} .turcy-story__mission {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: 34px;
    padding: 44px;
    background: #fffaf3;
    border: 1px solid var(--turcy-border);
    border-radius: var(--turcy-radius);
  }

  #TurcyStory-{{ section.id }} .turcy-story__mission-list {
    display: grid;
    gap: 12px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__mission-list div {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    border-radius: 16px;
    background: #ffffff;
    color: var(--turcy-text);
    font-size: 15px;
    line-height: 1.55;
    border: 1px solid rgba(25,61,53,0.08);
  }

  #TurcyStory-{{ section.id }} .turcy-story__mission-list span {
    width: 10px;
    height: 10px;
    margin-top: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--turcy-accent);
  }

  #TurcyStory-{{ section.id }} .turcy-story__philosophy {
    padding: 54px;
    border-radius: var(--turcy-radius);
    background: var(--turcy-card);
    border: 1px solid var(--turcy-border);
    text-align: center;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin: 30px 0;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow div {
    width: 210px;
    min-height: 118px;
    display: grid;
    place-items: center;
    align-content: center;
    border-radius: 999px;
    background: var(--turcy-soft);
    border: 1px solid var(--turcy-border);
    padding: 20px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow span {
    color: var(--turcy-accent);
    font-size: 12px;
    font-weight: 900;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow strong {
    color: var(--turcy-primary);
    font-size: 18px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow em {
    width: 52px;
    height: 2px;
    background: var(--turcy-accent);
    display: block;
    position: relative;
  }

  #TurcyStory-{{ section.id }} .turcy-story__flow em::after {
    content: "";
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--turcy-accent);
    border-right: 2px solid var(--turcy-accent);
    transform: rotate(45deg);
    position: absolute;
    right: 0;
    top: -3px;
  }

  #TurcyStory-{{ section.id }} .turcy-story__final {
    padding: 64px 40px;
    text-align: center;
    border-radius: var(--turcy-radius);
    background:
      radial-gradient(circle at 20% 20%, rgba(231,129,61,0.26), transparent 28%),
      linear-gradient(135deg, #193D35, #102820);
  }

  #TurcyStory-{{ section.id }} .turcy-story__final h2,
  #TurcyStory-{{ section.id }} .turcy-story__final .rte,
  #TurcyStory-{{ section.id }} .turcy-story__final p {
    color: #ffffff;
  }

  #TurcyStory-{{ section.id }} .turcy-story__final .rte {
    max-width: 780px;
    margin: 18px auto 0;
  }

  #TurcyStory-{{ section.id }} .turcy-story__button--light {
    background: #ffffff;
    color: var(--turcy-primary);
  }

  @media screen and (max-width: 989px) {
    #TurcyStory-{{ section.id }} .turcy-story__hero,
    #TurcyStory-{{ section.id }} .turcy-story__section,
    #TurcyStory-{{ section.id }} .turcy-story__section--image_left,
    #TurcyStory-{{ section.id }} .turcy-story__mission {
      grid-template-columns: 1fr;
    }

    #TurcyStory-{{ section.id }} .turcy-story__section--image_left .turcy-story__section-image {
      order: 0;
    }

    #TurcyStory-{{ section.id }} .turcy-story__meaning {
      grid-template-columns: 1fr;
    }

    #TurcyStory-{{ section.id }} .turcy-story__meaning-plus {
      display: none;
    }

    #TurcyStory-{{ section.id }} .turcy-story__values-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #TurcyStory-{{ section.id }} .turcy-story__flow {
      flex-direction: column;
    }

    #TurcyStory-{{ section.id }} .turcy-story__flow em {
      width: 2px;
      height: 34px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__flow em::after {
      right: -3px;
      top: auto;
      bottom: 0;
      transform: rotate(135deg);
    }
  }

  @media screen and (max-width: 749px) {
    #TurcyStory-{{ section.id }} {
      padding-left: 14px;
      padding-right: 14px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__hero,
    #TurcyStory-{{ section.id }} .turcy-story__section,
    #TurcyStory-{{ section.id }} .turcy-story__highlight,
    #TurcyStory-{{ section.id }} .turcy-story__values,
    #TurcyStory-{{ section.id }} .turcy-story__mission,
    #TurcyStory-{{ section.id }} .turcy-story__philosophy {
      padding: 26px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__hero {
      min-height: auto;
      gap: 26px;
    }

    #TurcyStory-{{ section.id }} h1 {
      font-size: 42px;
    }

    #TurcyStory-{{ section.id }} h2 {
      font-size: 30px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__values-grid {
      grid-template-columns: 1fr;
    }

    #TurcyStory-{{ section.id }} .turcy-story__img {
      min-height: 260px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__botanical-card {
      min-height: 340px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__seed {
      width: 170px;
      height: 170px;
      font-size: 34px;
    }

    #TurcyStory-{{ section.id }} .turcy-story__flow div {
      width: 100%;
    }
  }
</style>

{% schema %}
{
