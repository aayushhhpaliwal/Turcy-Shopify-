{% comment %}
  Trust Highlights / USP Bar
{% endcomment %}

<section class="trust-highlights section-{{ section.id }}">
  <div class="trust-highlights__inner page-width{% if section.settings.full_width %} trust-highlights__inner--full{% endif %}">
    <div class="trust-highlights__grid trust-highlights__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="trust-highlights__item" {{ block.shopify_attributes }}>
          <div class="trust-highlights__content">
            {%- if block.settings.icon != blank -%}
              <div class="trust-highlights__icon">
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '40,60,80,100,120',
                    alt: block.settings.heading | escape
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <div class="trust-highlights__text">
                {{ block.settings.heading }}
              </div>
            {%- endif -%}
          </div>

          {%- unless forloop.last -%}
            <div class="trust-highlights__divider">
              {%- if section.settings.divider_icon != blank -%}
                {{
                  section.settings.divider_icon
                  | image_url: width: 60
                  | image_tag:
                    loading: 'lazy',
                    widths: '24,36,48,60',
                    alt: 'divider'
                }}
              {%- else -%}
                <span>✦</span>
              {%- endif -%}
            </div>
          {%- endunless -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .section-{{ section.id }} .trust-highlights__inner {
    max-width: {% if section.settings.full_width %}100%{% else %}{{ section.settings.section_width }}px{% endif %};
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .section-{{ section.id }} .trust-highlights__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
    align-items: center;
    gap: 0;
  }

  .section-{{ section.id }} .trust-highlights__item {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: 0;
  }

  .section-{{ section.id }} .trust-highlights__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    width: 100%;
    padding: 8px 18px;
  }

  .section-{{ section.id }} .trust-highlights__icon {
    flex: 0 0 auto;
    line-height: 0;
  }

  .section-{{ section.id }} .trust-highlights__icon img {
    display: block;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
  }

  .section-{{ section.id }} .trust-highlights__text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.3;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: 0;
    font-family: var(--font-heading-family);
    white-space: nowrap;
  }

  .section-{{ section.id }} .trust-highlights__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.divider_color }};
    opacity: 0.8;
    padding: 0 8px;
    flex: 0 0 auto;
  }

  .section-{{ section.id }} .trust-highlights__divider img {
    width: {{ section.settings.divider_size }}px;
    height: {{ section.settings.divider_size }}px;
    object-fit: contain;
    display: block;
  }

  .section-{{ section.id }} .trust-highlights__divider span {
    font-size: {{ section.settings.divider_size }}px;
    line-height: 1;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .trust-highlights__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px 0;
    }

    .section-{{ section.id }} .trust-highlights__item {
      justify-content: center;
      padding: 0 8px;
    }

    .section-{{ section.id }} .trust-highlights__content {
      padding: 8px 10px;
      gap: 8px;
    }

    .section-{{ section.id }} .trust-highlights__text {
      white-space: normal;
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    .section-{{ section.id }} .trust-highlights__icon img {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }

    .section-{{ section.id }} .trust-highlights__divider {
      display: none;
    }
  }

  @media screen and (max-width: 575px) {
    .section-{{ section.id }} .trust-highlights__inner {
      padding-left: 14px;
      padding-right: 14px;
    }

    .section-{{ section.id }} .trust-highlights__content {
      flex-direction: row;
      align-items: center;
      justify-content: center;
    }

    .section-{{ section.id }} .trust-highlights__text {
      line-height: 0.35;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Highlights",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Enable full width",
      "default": true
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Section width",
      "default": 1400
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#730018"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f8f0ea"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#b89099"
    },
    {
      "type": "image_picker",
      "id": "divider_icon",
      "label": "Divider image"
    },
    {
      "type": "range",
      "id": "divider_size",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Divider size",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Text size desktop",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size mobile",
      "default": 15
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "default": "600",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Icon size desktop",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size mobile",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Item icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Text",
          "default": "BIS Hallmarked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Highlights",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "heading": "BIS Hallmarked"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "heading": "18kt Real Gold"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "heading": "925 Sterling Silver"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "heading": "Secure and Insured Shipping"
          }
        }
      ]
    }
  ]
}
{% endschema %}