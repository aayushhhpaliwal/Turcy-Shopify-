<section class="flux-feature flux-feature-{{ section.id }}">
  <div class="flux-feature__container">

    <div class="flux-feature__image">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="flux-feature__side-text">
      {{ section.settings.vertical_text }}
    </div>

    <div class="flux-feature__content">
      {% if section.settings.shape_image != blank %}
        <div class="flux-feature__shape">
          <img
            src="{{ section.settings.shape_image | image_url: width: 600 }}"
            alt=""
            loading="lazy"
            width="{{ section.settings.shape_image.width }}"
            height="{{ section.settings.shape_image.height }}"
          >
        </div>
      {% endif %}

      <p class="flux-feature__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="flux-feature__desc">{{ section.settings.description }}</div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="flux-feature__btn">
          {{ section.settings.button_label }}
          <span>›</span>
        </a>
      {% endif %}
    </div>

  </div>
</section>

<style>
  .flux-feature-{{ section.id }} {
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .flux-feature-{{ section.id }} .flux-feature__container {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 46% 70px 1fr;
    align-items: center;
    gap: 28px;
  }

  .flux-feature-{{ section.id }} .flux-feature__image {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: {{ section.settings.image_bg }};
    height: {{ section.settings.image_height }}px;
  }

  .flux-feature-{{ section.id }} .flux-feature__image img,
  .flux-feature-{{ section.id }} .flux-feature__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .flux-feature-{{ section.id }} .flux-feature__side-text {
    height: {{ section.settings.image_height }}px;
    border-right: 1px solid {{ section.settings.divider_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 13px;
    letter-spacing: 8px;
    text-transform: uppercase;
    color: {{ section.settings.vertical_color }};
    font-weight: 500;
  }

  .flux-feature-{{ section.id }} .flux-feature__content {
    position: relative;
    padding: 42px 30px 42px 28px;
    min-height: {{ section.settings.image_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .flux-feature-{{ section.id }} .flux-feature__shape {
    position: absolute;
    right: {{ section.settings.shape_right }}px;
    top: {{ section.settings.shape_top }}px;
    width: {{ section.settings.shape_width }}px;
    opacity: {{ section.settings.shape_opacity | divided_by: 100.0 }};
    z-index: 1;
    pointer-events: none;
  }

  .flux-feature-{{ section.id }} .flux-feature__shape img {
    width: 100%;
    height: auto;
    display: block;
  }

  .flux-feature-{{ section.id }} .flux-feature__eyebrow,
  .flux-feature-{{ section.id }} h2,
  .flux-feature-{{ section.id }} .flux-feature__desc,
  .flux-feature-{{ section.id }} .flux-feature__btn {
    position: relative;
    z-index: 2;
  }

  .flux-feature-{{ section.id }} .flux-feature__eyebrow {
    margin: 0 0 6px;
    font-size: 11px;
    letter-spacing: 7px;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
  }

  .flux-feature-{{ section.id }} h2 {
    margin: 0 0 22px;
    font-size: clamp(36px, 4vw, {{ section.settings.heading_size }}px);
    line-height: 1.04;
    color: {{ section.settings.heading_color }};
    font-weight: 800;
    letter-spacing: -1px;
  }

  .flux-feature-{{ section.id }} .flux-feature__desc {
    max-width: 620px;
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.9;
    color: {{ section.settings.text_color }};
  }

  .flux-feature-{{ section.id }} .flux-feature__desc p {
    margin: 0;
  }

  .flux-feature-{{ section.id }} .flux-feature__btn {
    margin-top: 28px;
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    padding: 12px 18px;
    border-radius: 9px;
    font-size: 14px;
    line-height: 1;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 9px 18px rgba(0,0,0,.18);
  }

  .flux-feature-{{ section.id }} .flux-feature__btn span {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(255,255,255,.18);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  @media screen and (max-width: 989px) {
    .flux-feature-{{ section.id }} .flux-feature__container {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .flux-feature-{{ section.id }} .flux-feature__image {
      height: {{ section.settings.mobile_image_height }}px;
    }

    .flux-feature-{{ section.id }} .flux-feature__side-text {
      height: auto;
      writing-mode: horizontal-tb;
      transform: none;
      border-right: 0;
      border-top: 1px solid {{ section.settings.divider_color }};
      border-bottom: 1px solid {{ section.settings.divider_color }};
      padding: 14px 0;
      letter-spacing: 6px;
    }

    .flux-feature-{{ section.id }} .flux-feature__content {
      min-height: auto;
      text-align: center;
      padding: 34px 10px;
      align-items: center;
    }

    .flux-feature-{{ section.id }} .flux-feature__shape {
      left: 50%;
      right: auto;
      top: {{ section.settings.mobile_shape_top }}px;
      width: {{ section.settings.mobile_shape_width }}px;
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 600px) {
    .flux-feature-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .flux-feature-{{ section.id }} .flux-feature__container {
      padding: 0 16px;
    }

    .flux-feature-{{ section.id }} h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .flux-feature-{{ section.id }} .flux-feature__desc {
      font-size: {{ section.settings.mobile_text_size }}px;
      line-height: 1.7;
    }

    .flux-feature-{{ section.id }} .flux-feature__eyebrow {
      letter-spacing: 4px;
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Flux Image Feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "shape_image",
      "label": "Right shape image GIF SVG PNG"
    },
    {
      "type": "text",
      "id": "vertical_text",
      "label": "Vertical text",
      "default": "NEW SUMMER COLLECTION"
    },
    {
      "type": "text",
      "id": "eyebrow",
