{% liquid
  assign section_id = 'pureely-testimonials-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="pureely-testimonials-section color-{{ section.settings.color_scheme }}"
  style="
    --pt-bg: {{ section.settings.bg_color }};
    --pt-card-bg: {{ section.settings.card_bg }};
    --pt-heading: {{ section.settings.heading_color }};
    --pt-accent: {{ section.settings.accent_color }};
    --pt-text: {{ section.settings.text_color }};
    --pt-subtext: {{ section.settings.subtext_color }};
    --pt-stars: {{ section.settings.star_color }};
    --pt-avatar-text: {{ section.settings.avatar_text_color }};
    --pt-border-radius: {{ section.settings.card_radius }}px;
    --pt-section-radius: {{ section.settings.section_radius }}px;
    --pt-max-width: {% if section.settings.page_width == 'full' %}100%{% else %}{{ section.settings.max_width }}px{% endif %};
    --pt-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --pt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --pt-text-size: {{ section.settings.text_size }}px;
    --pt-name-size: {{ section.settings.name_size }}px;
    --pt-meta-size: {{ section.settings.meta_size }}px;
    --pt-top-space: {{ section.settings.padding_top }}px;
    --pt-bottom-space: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pureely-testimonials__outer {% if section.settings.page_width == 'boxed' %}page-width{% endif %}">
    <div class="pureely-testimonials__inner">
      {% if section.settings.show_eyebrow and section.settings.eyebrow != blank %}
        <div class="pureely-testimonials__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pureely-testimonials__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="pureely-testimonials__slider-wrap">
        <div class="pureely-testimonials__viewport">
          <div class="pureely-testimonials__track" data-slider-track>
            {% for block in section.blocks %}
              {% assign initials = block.settings.initials %}
              {% if initials == blank %}
                {% assign words = block.settings.name | strip | split: ' ' %}
                {% assign first_initial = words[0] | slice: 0 %}
                {% assign last_initial = '' %}
                {% if words.size > 1 %}
                  {% assign last_index = words.size | minus: 1 %}
                  {% assign last_initial = words[last_index] | slice: 0 %}
                {% endif %}
                {% assign initials = first_initial | append: last_initial | upcase %}
              {% endif %}

              <div
                class="pureely-testimonials__slide"
                {{ block.shopify_attributes }}
                data-slide
              >
                <div class="pureely-testimonials__card">
                  {% if section.settings.show_quote_icon %}
                    <div class="pureely-testimonials__quote-mark" aria-hidden="true">
                      <svg viewBox="0 0 48 40" fill="none">
                        <path d="M18.683 0C9.31 4.79 4 13.683 4 24.425C4 34.146 10.044 40 18.034 40C24.506 40 29.07 35.436 29.07 28.964C29.07 22.643 24.73 18.456 18.484 18.456C17.584 18.456 16.834 18.531 15.86 18.83C16.535 12.335 20.503 6.994 27.05 2.281L18.683 0ZM37.613 0C28.24 4.79 22.93 13.683 22.93 24.425C22.93 34.146 28.974 40 36.964 40C43.436 40 48 35.436 48 28.964C48 22.643 43.66 18.456 37.414 18.456C36.514 18.456 35.764 18.531 34.79 18.83C35.465 12.335 39.433 6.994 45.98 2.281L37.613 0Z" fill="currentColor"/>
                      </svg>
                    </div>
                  {% endif %}

                  {% if section.settings.show_stars %}
                    <div class="pureely-testimonials__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                      {% assign star_count = block.settings.stars | default: 5 %}
                      {% for i in (1..5) %}
                        <span class="pureely-testimonials__star {% if i <= star_count %}is-active{% endif %}">★</span>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if block.settings.review != blank %}
                    <div class="pureely-testimonials__review rte">
                      {{ block.settings.review }}
                    </div>
                  {% endif %}

                  <div class="pureely-testimonials__author">
                    {% if block.settings.author_image != blank %}
                      <div class="pureely-testimonials__avatar pureely-testimonials__avatar--image">
                        {{
                          block.settings.author_image
                          | image_url: width: 120
                          | image_tag:
                            loading: 'lazy',
                            widths: '60, 90, 120',
                            class: 'pureely-testimonials__avatar-img',
                            alt: block.settings.name
                        }}
                      </div>
                    {% else %}
                      <div
                        class="pureely-testimonials__avatar pureely-testimonials__avatar--text"
                        style="background: {{ block.settings.avatar_bg }};"
                      >
                        {{ initials }}
                      </div>
                    {% endif %}

                    <div class="pureely-testimonials__author-info">
                      {% if block.settings.name != blank %}
                        <div class="pureely-testimonials__author-name">{{ block.settings.name }}</div>
                      {% endif %}
                      {% if block.settings.meta != blank %}
                        <div class="pureely-testimonials__author-meta">{{ block.settings.meta }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {% if section.settings.show_dots %}
        <div class="pureely-testimonials__dots" data-slider-dots></div>
      {% endif %}
    </div>
  </div>

  <style>
    #{{ section_id }} {
      background: var(--pt-bg);
      padding-top: var(--pt-top-space);
      padding-bottom: var(--pt-bottom-space);
      border-radius: var(--pt-section-radius);
      overflow: hidden;
      content-visibility: auto;
      contain-intrinsic-size: 1px 420px;
    }

    #{{ section_id }} .pureely-testimonials__outer {
      max-width: var(--pt-max-width);
      margin: 0 auto;
    }

    #{{ section_id }} .pureely-testimonials__inner {
      position: relative;
    }

    #{{ section_id }} .pureely-testimonials__eyebrow {
      font-size: 12px;
      line-height: 1.2;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--pt-accent);
      margin-bottom: 14px;
      font-weight: 700;
    }

    #{{ section_id }} .pureely-testimonials__heading {
      margin: 0 0 34px;
      color: var(--pt-heading);
      font-size: var(--pt-heading-size-desktop);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.03em;
      max-width: 780px;
    }

    #{{ section_id }} .pureely-testimonials__heading em,
    #{{ section_id }} .pureely-testimonials__heading i {
      color: var(--pt-accent);
      font-style: italic;
      font-weight: 700;
    }

    #{{ section_id }} .pureely-testimonials__slider-wrap {
      position: relative;
    }

    #{{ section_id }} .pureely-testimonials__viewport {
      overflow: hidden;
    }

    #{{ section_id }} .pureely-testimonials__track {
      display: flex;
      gap: {{ section.settings.desktop_gap }}px;
      transition: transform 0.4s ease;
      will-change: transform;
      touch-action: pan-y;
      cursor: grab;
    }

    #{{ section_id }} .pureely-testimonials__track.is-dragging {
      cursor: grabbing;
      transition: none;
      user-select: none;
    }

    #{{ section_id }} .pureely-testimonials__slide {
      flex: 0 0 calc((100% - ({{ section.settings.desktop_gap }}px * 2)) / 3);
      min-width: 0;
      box-sizing: border-box;
    }

    #{{ section_id }} .pureely-testimonials__card {
      background: var(--pt-card-bg);
      border-radius: var(--pt-border-radius);
      padding: 26px 28px 28px;
      height: 100%;
      min-height: {{ section.settings.card_min_height }}px;
      display: flex;
      flex-direction: column;
    }

    #{{ section_id }} .pureely-testimonials__quote-mark {
      color: var(--pt-accent);
      width: 30px;
      height: 24px;
      margin-bottom: 24px;
      line-height: 0;
    }

    #{{ section_id }} .pureely-testimonials__quote-mark svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    #{{ section_id }} .pureely-testimonials__stars {
      display: flex;
      align-items: center;
      gap: 3px;
      margin-bottom: 20px;
      font-size: 17px;
      line-height: 1;
    }

    #{{ section_id }} .pureely-testimonials__star {
      color: rgba(0,0,0,0.14);
    }

    #{{ section_id }} .pureely-testimonials__star.is-active {
      color: var(--pt-stars);
    }

    #{{ section_id }} .pureely-testimonials__review {
      color: var(--pt-text);
      font-size: var(--pt-text-size);
      line-height: 1.65;
      font-style: italic;
      margin-bottom: 28px;
      flex: 1 1 auto;
    }

    #{{ section_id }} .pureely-testimonials__review p {
      margin: 0;
    }

    #{{ section_id }} .pureely-testimonials__author {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: auto;
    }

    #{{ section_id }} .pureely-testimonials__avatar {
      width: 44px;
      height: 44px;
      min-width: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #{{ section_id }} .pureely-testimonials__avatar--text {
      color: var(--pt-avatar-text);
      font-size: 16px;
      font-weight: 700;
      line-height: 1;
    }

    #{{ section_id }} .pureely-testimonials__avatar-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #{{ section_id }} .pureely-testimonials__author-name {
      color: var(--pt-heading);
      font-size: var(--pt-name-size);
      line-height: 1.3;
      font-weight: 700;
      margin-bottom: 2px;
    }

    #{{ section_id }} .pureely-testimonials__author-meta {
      color: var(--pt-subtext);
      font-size: var(--pt-meta-size);
      line-height: 1.4;
    }

    #{{ section_id }} .pureely-testimonials__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 24px;
    }

    #{{ section_id }} .pureely-testimonials__dot {
      width: 10px;
      height: 10px;
      border: 0;
      border-radius: 50%;
      background: rgba(0,0,0,0.18);
      cursor: pointer;
      padding: 0;
      transition: transform 0.2s ease, background 0.2s ease;
    }

    #{{ section_id }} .pureely-testimonials__dot.is-active {
      background: var(--pt-accent);
      transform: scale(1.15);
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .pureely-testimonials__heading {
        font-size: calc(var(--pt-heading-size-mobile) + 6px);
        margin-bottom: 28px;
      }

      #{{ section_id }} .pureely-testimonials__track {
        gap: {{ section.settings.tablet_gap }}px;
      }

      #{{ section_id }} .pureely-testimonials__slide {
        flex: 0 0 calc((100% - {{ section.settings.tablet_gap }}px) / 2);
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #{{ section_id }} .pureely-testimonials__heading {
        font-size: var(--pt-heading-size-mobile);
        line-height: 1.02;
        margin-bottom: 22px;
        max-width: 100%;
      }

      #{{ section_id }} .pureely-testimonials__track {
        gap: {{ section.settings.mobile_gap }}px;
      }

      #{{ section_id }} .pureely-testimonials__slide {
        flex: 0 0 100%;
      }

      #{{ section_id }} .pureely-testimonials__card {
        padding: 22px 20px 22px;
        min-height: auto;
      }

      #{{ section_id }} .pureely-testimonials__review {
        font-size: calc(var(--pt-text-size) - 1px);
      }
    }
  </style>

  <script>
    (function() {
      const section = document.getElementById('{{ section_id }}');
      if (!section) return;

      const track = section.querySelector('[data-slider-track]');
      const slides = Array.from(section.querySelectorAll('[data-slide]'));
      const dotsWrap = section.querySelector('[data-slider-dots]');

      if (!track || !slides.length) return;

      let currentIndex = 0;
      let slidesPerView = getSlidesPerView();
      let maxIndex = Math.max(0, slides.length - slidesPerView);
      let slideWidth = slides[0].getBoundingClientRect().width;
      let gap = getGap();
      let startX = 0;
      let currentTranslate = 0;
      let prevTranslate = 0;
      let isDragging = false;
      let animationId = null;
      let prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let autoPlay = {{ section.settings.autoplay | json }} && !prefersReducedMotion;
      let autoPlaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};
      let autoPlayTimer = null;

      function getSlidesPerView() {
        if (window.innerWidth <= 749) return 1;
        if (window.innerWidth <= 989) return 2;
        return 3;
      }

      function getGap() {
        if (window.innerWidth <= 749) return {{ section.settings.mobile_gap }};
        if (window.innerWidth <= 989) return {{ section.settings.tablet_gap }};
        return {{ section.settings.desktop_gap }};
      }

      function buildDots() {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        const pageCount = Math.max(1, slides.length - getSlidesPerView() + 1);

        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'pureely-testimonials__dot';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          dot.addEventListener('click', function() {
            goTo(i);
          });
          dotsWrap.appendChild(dot);
        }
        updateDots();
      }

      function updateDots() {
        if (!dotsWrap) return;
        const dots = dotsWrap.querySelectorAll('.pureely-testimonials__dot');
        dots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === currentIndex);
        });
      }

      function updateSizes() {
        slidesPerView = getSlidesPerView();
        maxIndex = Math.max(0, slides.length - slidesPerView);
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        slideWidth = slides[0].getBoundingClientRect().width;
        gap = getGap();
        setPositionByIndex();
        buildDots();
      }

      function setSliderPosition() {
        track.style.transform = 'translateX(' + currentTranslate + 'px)';
      }

      function setPositionByIndex() {
        const offset = currentIndex * (slideWidth + gap);
        currentTranslate = -offset;
        prevTranslate = currentTranslate;
        setSliderPosition();
        updateDots();
      }

      function goTo(index) {
        currentIndex = Math.max(0, Math.min(index, maxIndex));
        setPositionByIndex();
        restartAutoplay();
      }

      function next() {
        if (currentIndex >= maxIndex) {
          if (autoPlay) {
            currentIndex = 0;
          }
        } else {
          currentIndex += 1;
        }
        setPositionByIndex();
      }

      function touchStart(index) {
        return function(event) {
          isDragging = true;
          track.classList.add('is-dragging');
          startX = getPositionX(event);
          prevTranslate = currentTranslate;
          cancelAnimationFrame(animationId);
          stopAutoplay();
        };
      }

      function touchMove(event) {
        if (!isDragging) return;
        const currentPosition = getPositionX(event);
        currentTranslate = prevTranslate + currentPosition - startX;
        animationId = requestAnimationFrame(setSliderPosition);
      }

      function touchEnd() {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove('is-dragging');

        const movedBy = currentTranslate - prevTranslate;
        const threshold = slideWidth * 0.15;

        if (movedBy < -threshold && currentIndex < maxIndex) {
          currentIndex += 1;
        } else if (movedBy > threshold && currentIndex > 0) {
          currentIndex -= 1;
        }

        setPositionByIndex();
        restartAutoplay();
      }

      function getPositionX(event) {
        return event.type.includes('mouse') ? event.pageX : event.touches[0].clientX;
      }

      slides.forEach((slide, index) => {
        slide.addEventListener('dragstart', function(e) {
          e.preventDefault();
        });

        slide.addEventListener('touchstart', touchStart(index), { passive: true });
        slide.addEventListener('touchmove', touchMove, { passive: true });
        slide.addEventListener('touchend', touchEnd);

        slide.addEventListener('mousedown', touchStart(index));
        slide.addEventListener('mousemove', touchMove);
        slide.addEventListener('mouseup', touchEnd);
        slide.addEventListener('mouseleave', function() {
          if (isDragging) touchEnd();
        });
      });

      function startAutoplay() {
        if (!autoPlay || slides.length <= getSlidesPerView()) return;
        stopAutoplay();
        autoPlayTimer = setInterval(function() {
          next();
        }, autoPlaySpeed);
      }

      function stopAutoplay() {
        if (autoPlayTimer) {
          clearInterval(autoPlayTimer);
          autoPlayTimer = null;
        }
      }

      function restartAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      section.addEventListener('mouseenter', stopAutoplay);
      section.addEventListener('mouseleave', startAutoplay);

      window.addEventListener('resize', function() {
        updateSizes();
      });

      function initTestimonialsSlider() {
        updateSizes();
        startAutoplay();
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(initTestimonialsSlider, { timeout: 1500 });
      } else {
        window.addEventListener('load', initTestimonialsSlider);
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "testimonials slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "label": "Page width",
      "default": "boxed",
      "options": [
        { "value": "boxed", "label": "Boxed" },
        { "value": "full", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Section max width",
      "default": 1400
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "REAL TALK"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "People <em>love</em> Elegity."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ECE6D4"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#183C2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#F26722"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Review text color",
      "default": "#5C483F"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Meta text color",
      "default": "#9A8B82"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#F4A51C"
    },
    {
      "type": "color",
      "id": "avatar_text_color",
      "label": "Avatar initials text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading size desktop",
      "default": 62
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "label": "Heading size mobile",
      "default": 38
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Review text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Name size",
      "default": 18
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Meta text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Section corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_min_height",
      "min": 260,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Card minimum height",
      "default": 300
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "tablet_gap",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Tablet gap",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_quote_icon",
      "label": "Show quote icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show stars",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
