    {%- liquid
      assign sticky_cart_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
      assign sticky_cart_image = sticky_cart_media.preview_image | default: product.featured_image
      assign sticky_cart_variant = product.selected_or_first_available_variant
      assign sticky_cart_sold_out = false
      assign sticky_cart_check_inventory = true
      if sticky_cart_variant.inventory_management != 'shopify' or sticky_cart_variant.inventory_policy == 'continue'
        assign sticky_cart_check_inventory = false
      endif
      if sticky_cart_variant.quantity_rule.min > sticky_cart_variant.inventory_quantity and sticky_cart_check_inventory
        assign sticky_cart_sold_out = true
      endif
      if sticky_cart_variant.available == false or sticky_cart_variant == null
        assign sticky_cart_sold_out = true
      endif
    -%}
    <div class="sticky-product-cart-{{ section.id }}" data-sticky-product-cart data-section-id="{{ section.id }}">
