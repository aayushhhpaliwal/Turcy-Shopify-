            {{
              sticky_cart_image
              | image_url: width: 120
              | image_tag:
                widths: '64, 96, 120',
                sizes: '(max-width: 749px) 44px, 52px',
                loading: 'lazy',
                class: 'sticky-product-cart__image',
                alt: product.title
            }}
          {%- endif -%}
          <p class="sticky-product-cart-{{ section.id }}__title">{{ product.title | escape }}</p>
        </div>
        <div class="sticky-product-cart-{{ section.id }}__price" data-sticky-product-cart-price>
