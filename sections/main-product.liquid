        const stickyButton = stickyCart?.querySelector('[data-sticky-product-cart-submit]');
        const stickyButtonText = stickyCart?.querySelector('[data-sticky-product-cart-submit-text]');
        const stickyPrice = stickyCart?.querySelector('[data-sticky-product-cart-price]');
        const stickyImage = stickyCart?.querySelector('.sticky-product-cart__image');
        const sectionId = '{{ section.id }}';

        if (!productRoot || !stickyCart || !stickyButton || stickyCart.dataset.bound === 'true') return;
        stickyCart.dataset.bound = 'true';

        const getMainButton = () => productRoot.querySelector(`#ProductSubmitButton-${sectionId}`);
        let hasSeenMainButton = false;

        const syncButtonState = () => {
          const mainButton = getMainButton();
          if (!mainButton) return;

          const isDisabled = mainButton.disabled || mainButton.getAttribute('aria-disabled') === 'true';
          stickyButton.toggleAttribute('disabled', isDisabled);
          stickyButton.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');

          const mainButtonText = mainButton.querySelector('span')?.textContent?.trim();
          if (mainButtonText && stickyButtonText) {
            stickyButtonText.textContent = mainButtonText;
          }
        };

        const setStickyVisibility = (isMainButtonVisible) => {
          if (isMainButtonVisible) hasSeenMainButton = true;
          stickyCart.classList.toggle('is-visible', hasSeenMainButton && !isMainButtonVisible);
        };

        const updateStickyMedia = (html, variant) => {
          if (!stickyImage || !html || !variant?.featured_media?.id) return;

          const updatedImage = html.querySelector(`[data-media-id="${sectionId}-${variant.featured_media.id}"] img`);
          if (!updatedImage) return;

          stickyImage.src = updatedImage.currentSrc || updatedImage.src;
          if (updatedImage.srcset) stickyImage.srcset = updatedImage.srcset;
          if (updatedImage.sizes) stickyImage.sizes = updatedImage.sizes;
          stickyImage.alt = updatedImage.alt || stickyImage.alt;
        };

        stickyButton.addEventListener('click', () => {
          const mainButton = getMainButton();
          const form = mainButton?.closest('form');
          if (!mainButton || !form || stickyButton.disabled) return;

          try {
            form.requestSubmit(mainButton);
          } catch (error) {
            mainButton.click();
          }

          syncButtonState();
        });

        const mainButton = getMainButton();
        if (mainButton) {
          new MutationObserver(syncButtonState).observe(mainButton, {
            attributes: true,
            attributeFilter: ['disabled', 'aria-disabled', 'class'],
            childList: true,
            subtree: true,
          });

          if ('IntersectionObserver' in window) {
            new IntersectionObserver(
              ([entry]) => {
                const isMainButtonVisible = Boolean(entry?.isIntersecting);
                if (!isMainButtonVisible && entry?.boundingClientRect?.bottom < 0) {
                  hasSeenMainButton = true;
                }
                setStickyVisibility(isMainButtonVisible);
              },
              {
                root: null,
                threshold: 0.01,
              }
            ).observe(mainButton);
          } else {
            hasSeenMainButton = true;
            stickyCart.classList.add('is-visible');
          }
        }

        if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          subscribe(PUB_SUB_EVENTS.variantChange, (event) => {
            if (event?.data?.sectionId !== sectionId) return;

            const updatedPrice = event.data.html?.getElementById(`price-${sectionId}`);
            if (updatedPrice && stickyPrice) {
              stickyPrice.innerHTML = updatedPrice.innerHTML;
            }

            updateStickyMedia(event.data.html, event.data.variant);
            window.requestAnimationFrame(syncButtonState);
          });
        }

        syncButtonState();
      })();

      (() => {
        const productRoot = document.getElementById('MainProduct-{{ section.id }}');
        if (!productRoot || productRoot.dataset.giftPopupBound === 'true') return;
        productRoot.dataset.giftPopupBound = 'true';

        document.querySelectorAll('[data-gift-popup-modal][data-section-id="{{ section.id }}"]').forEach((modal) => {
          const form = document.getElementById(modal.dataset.productFormId);
          const productForm = form?.closest('product-form');
          const cart = productForm?.cart;
          const mainSubmitButton = productForm?.querySelector('.product-form__submit');
          const submitButton = modal.querySelector('[data-gift-popup-submit]');
          const errorBox = modal.querySelector('[data-gift-popup-error]');
          const imageToggle = modal.querySelector('[data-gift-image-toggle]');
          const imageFields = modal.querySelector('[data-gift-image-fields]');
          const occasionInput = modal.querySelector('[data-gift-occasion]');
          const fileInput = modal.querySelector('[data-gift-image-file]');
          const uploadLabel = modal.querySelector('[data-gift-upload-label]');
          const defaultUploadLabel = uploadLabel?.textContent || '';
          const fileName = modal.querySelector('[data-gift-file-name]');
          const messageToggle = modal.querySelector('[data-gift-message-toggle]');
          const messageFields = modal.querySelector('[data-gift-message-fields]');
          const messageInputs = Array.from(modal.querySelectorAll('[data-gift-message-input]'));
          const openers = document.querySelectorAll(`[data-modal="#${modal.id}"] button`);

          const imageInputs = [occasionInput, fileInput].filter(Boolean);
          let popupSubmitPending = false;

          const clearError = () => {
            if (!errorBox) return;
            errorBox.textContent = '';
            errorBox.hidden = true;
          };

          const setError = (message) => {
            if (!errorBox) return;
            errorBox.textContent = message;
            errorBox.hidden = false;
          };

          const setSubmitState = (isSubmitting) => {
            if (!submitButton) return;
            submitButton.toggleAttribute('disabled', isSubmitting);
            submitButton.setAttribute('aria-disabled', isSubmitting ? 'true' : 'false');
            submitButton.setAttribute('aria-busy', isSubmitting ? 'true' : 'false');
          };

          const toggleGroup = (toggle, container, inputs) => {
            const isActive = Boolean(toggle?.checked);
            container?.classList.toggle('is-disabled', !isActive);

            inputs.forEach((input) => {
              input.disabled = !isActive;
              if (!isActive) {
                if (input.type === 'file') {
                  input.value = '';
                } else if (input.tagName === 'SELECT') {
                  input.selectedIndex = 0;
                } else {
                  input.value = '';
                }
              }
            });

            if (!isActive) {
              if (container === imageFields && uploadLabel) uploadLabel.textContent = defaultUploadLabel;
              if (container === imageFields && fileName) {
                fileName.textContent = '';
                fileName.hidden = true;
              }
            }
          };

          const resetSelections = () => {
            clearError();
            if (imageToggle) imageToggle.checked = false;
            toggleGroup(imageToggle, imageFields, imageInputs);

            if (messageToggle) messageToggle.checked = false;
            toggleGroup(messageToggle, messageFields, messageInputs);
          };

          const releaseSubmitState = () => {
            popupSubmitPending = false;
            setSubmitState(false);
          };

          resetSelections();
          setSubmitState(false);

          imageToggle?.addEventListener('change', () => {
            clearError();
            toggleGroup(imageToggle, imageFields, imageInputs);
          });

          messageToggle?.addEventListener('change', () => {
            clearError();
            toggleGroup(messageToggle, messageFields, messageInputs);
          });

          fileInput?.addEventListener('change', () => {
            const selectedFile = fileInput.files && fileInput.files[0] ? fileInput.files[0].name : '';
            if (uploadLabel) uploadLabel.textContent = selectedFile || defaultUploadLabel;
            if (fileName) {
              fileName.textContent = selectedFile;
              fileName.hidden = selectedFile === '';
            }
          });

          openers.forEach((button) => {
            button.addEventListener('click', () => {
              clearError();
              releaseSubmitState();
            });
          });

          document.body.addEventListener('modalClosed', () => {
            window.setTimeout(() => {
              if (!modal.hasAttribute('open')) {
                releaseSubmitState();
                resetSelections();
              }
            });
          });

          submitButton?.addEventListener('click', () => {
            if (popupSubmitPending) return;
            clearError();

            if (!form || !productForm || !mainSubmitButton || mainSubmitButton.disabled) {
              setError('Please select an available variant before adding this item to the cart.');
              return;
            }

            if (imageToggle?.checked) {
              if (!occasionInput?.value) {
                setError('Please choose an occasion for the gift image.');
                return;
              }

              if (!fileInput?.files || fileInput.files.length === 0) {
                setError('Please upload a gift image to continue.');
                return;
              }
            }

            if (messageToggle?.checked) {
              const hasMissingMessageField = messageInputs.some((input) => !input.value.trim());
              if (hasMissingMessageField) {
                setError('Please complete all gift message fields.');
                return;
              }
            }

            popupSubmitPending = true;
            setSubmitState(true);

            if (cart && mainSubmitButton) {
              cart.setActiveElement(mainSubmitButton);
            }

            try {
              mainSubmitButton.focus({ preventScroll: true });
            } catch (error) {
              mainSubmitButton.focus();
            }

            try {
              form.requestSubmit(mainSubmitButton);
            } catch (error) {
              form.requestSubmit();
            }
          });

          subscribe(PUB_SUB_EVENTS.cartError, (event) => {
            if (event?.source !== 'product-form' || !popupSubmitPending) return;

            releaseSubmitState();

            if (typeof event.errors === 'string' && event.errors !== '') {
              setError(event.errors);
              return;
            }

            if (event?.message) {
              setError(event.message);
            }
          });

          subscribe(PUB_SUB_EVENTS.cartUpdate, (event) => {
            if (event?.source !== 'product-form' || !popupSubmitPending) return;

            releaseSubmitState();
            resetSelections();
            modal.hide();
          });
        });
      })();
    </script>

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</product-info>

