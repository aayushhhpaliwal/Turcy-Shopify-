<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.mlp-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('.mlp-slider');
    const track = section.querySelector('.mlp-track');
    const cards = section.querySelectorAll('.mlp-card');
    const prev = section.querySelector('.mlp-prev');
    const next = section.querySelector('.mlp-next');

    let index = 0;

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function getVisibleCards() {
      if (window.innerWidth <= 749) return 1;
      if (window.innerWidth <= 1100) return 3;
      return 4;
    }

    function updateSlider() {
      if (!cards.length) return;

      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      const cardWidth = cards[0].offsetWidth + gap;
      const maxIndex = Math.max(cards.length - getVisibleCards(), 0);

      if (index > maxIndex) index = maxIndex;
      if (index < 0) index = 0;

      if (isMobile()) {
        slider.scrollTo({
          left: index * cardWidth,
          behavior: 'smooth'
        });
      } else {
        track.style.transform = `translateX(-${index * cardWidth}px)`;
      }
    }

    next.addEventListener('click', function () {
      const maxIndex = Math.max(cards.length - getVisibleCards(), 0);
      index = index >= maxIndex ? 0 : index + 1;
      updateSlider();
    });

    prev.addEventListener('click', function () {
      const maxIndex = Math.max(cards.length - getVisibleCards(), 0);
      index = index <= 0 ? maxIndex : index - 1;
      updateSlider();
    });

    slider.addEventListener('scroll', function () {
      if (!isMobile() || !cards.length) return;

      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      const cardWidth = cards[0].offsetWidth + gap;

      index = Math.round(slider.scrollLeft / cardWidth);
    });

    window.addEventListener('resize', function () {
      if (isMobile()) {
        track.style.transform = 'none';
      } else {
        slider.scrollLeft = 0;
      }

      updateSlider();
    });

    updateSlider();
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(initMostLovedProducts{{ section.id | replace: '-', '_' }}, { timeout: 1500 });
  } else {
    window.addEventListener('load', initMostLovedProducts{{ section.id | replace: '-', '_' }});
  }
</script>





