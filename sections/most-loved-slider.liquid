<section class="mlp-section mlp-{{ section.id }}">
  <div class="mlp-container">
    <div class="mlp-header">
      <h2>{{ section.settings.heading }}</h2>

      <div class="mlp-arrows">
        <button class="mlp-prev" aria-label="Previous">‹</button>
        <button class="mlp-next" aria-label="Next">›</button>
      </div>
    </div>

    <div class="mlp-slider">
      <div class="mlp-track">
        {% for block in section.blocks %}
          <div class="mlp-card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}" class="mlp-image-wrap">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 360 }} 360w,
                    {{ block.settings.image | image_url: width: 480 }} 480w,
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 800 }} 800w
                  "
                  sizes="(max-width: 749px) 82vw, (max-width: 1100px) 33vw, 25vw"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'mlp-placeholder' }}
              {% endif %}
            </a>

            <div class="mlp-info">
              {% if block.settings.badge != blank %}
                <span class="mlp-badge">{{ block.settings.badge }}</span>
              {% endif %}

              <h3>{{ block.settings.title }}</h3>

              {% if block.settings.button_text != blank %}
                <a href="{{ block.settings.link }}" class="mlp-link">
                  {{ block.settings.button_text }} ›
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .mlp-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  .mlp-{{ section.id }} .mlp-container {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .mlp-{{ section.id }} .mlp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .mlp-{{ section.id }} h2 {
    margin: 0;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .mlp-{{ section.id }} .mlp-arrows {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .mlp-{{ section.id }} .mlp-arrows button {
    border: 0;
    background: transparent;
    color: {{ section.settings.arrow_color }};
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: 0.25s ease;
  }

  .mlp-{{ section.id }} .mlp-arrows button:hover {
    color: {{ section.settings.arrow_hover_color }};
    transform: translateY(-1px);
  }

  .mlp-{{ section.id }} .mlp-slider {
    overflow: hidden;
  }

  .mlp-{{ section.id }} .mlp-track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .mlp-{{ section.id }} .mlp-card {
    min-width: calc((100% - ({{ section.settings.card_gap }}px * 3)) / 4);
    position: relative;
    border-radius: {{ section.settings.card_radius }}px;
  }

  .mlp-{{ section.id }} .mlp-image-wrap {
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
    background: #f7eee9;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .mlp-{{ section.id }} .mlp-image-wrap img,
  .mlp-{{ section.id }} .mlp-placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .mlp-{{ section.id }} .mlp-card:hover img {
    transform: scale(1.04);
  }

  .mlp-{{ section.id }} .mlp-info {
    background: {{ section.settings.info_bg }};
    width: 42%;
    min-width: 128px;
    padding: 12px 16px 16px;
    margin-top: -90px;
    position: relative;
    z-index: 2;
    border-top-right-radius: {{ section.settings.info_radius }}px;
  }

  .mlp-{{ section.id }} .mlp-badge {
    display: inline-block;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 9px;
    margin-bottom: 8px;
    line-height: 1;
  }

  .mlp-{{ section.id }} .mlp-info h3 {
    margin: 0 0 8px;
    font-size: {{ section.settings.product_title_size }}px;
    line-height: 1.2;
    color: {{ section.settings.product_title_color }};
    font-weight: 800;
  }

  .mlp-{{ section.id }} .mlp-link {
    display: inline-block;
    font-size: {{ section.settings.link_size }}px;
    color: {{ section.settings.link_color }};
    text-decoration: none;
    line-height: 1.3;
  }

  .mlp-{{ section.id }} .mlp-link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 1100px) {
    .mlp-{{ section.id }} .mlp-card {
      min-width: calc((100% - ({{ section.settings.card_gap }}px * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .mlp-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .mlp-{{ section.id }} .mlp-container {
      padding: 0 16px;
    }

    .mlp-{{ section.id }} .mlp-header {
      margin-bottom: 18px;
    }

    .mlp-{{ section.id }} h2 {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .mlp-{{ section.id }} .mlp-arrows button {
      font-size: 30px;
    }

    .mlp-{{ section.id }} .mlp-slider {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      scrollbar-color: {{ section.settings.scrollbar_color }} transparent;
    }

    .mlp-{{ section.id }} .mlp-slider::-webkit-scrollbar {
      height: 3px;
    }

    .mlp-{{ section.id }} .mlp-slider::-webkit-scrollbar-thumb {
      background: {{ section.settings.scrollbar_color }};
      border-radius: 20px;
    }

    {% comment %} .mlp-{{ section.id }} .mlp-track {
      gap: 14px;
      transition: none;
    } {% endcomment %}

    .mlp-{{ section.id }} .mlp-track {
  gap: 14px;
  transition: none;
  transform: none !important;
}



    .mlp-{{ section.id }} .mlp-card {
      min-width: 82%;
      scroll-snap-align: start;
    }

    .mlp-{{ section.id }} .mlp-info {
      width: 58%;
      margin-top: -76px;
      padding: 10px 13px 14px;
    }

    .mlp-{{ section.id }} .mlp-info h3 {
      font-size: {{ section.settings.mobile_product_title_size }}px;
    }
  }
</style>

