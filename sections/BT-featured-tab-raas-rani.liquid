                  <div
                    class="product-image-wrapper-{{ section.id }} card--media"
                    style=" {% if block.settings.product_image_orientation == 'square' %}
                      padding-top: 100%!important;
                    {% else %}
                      padding-top: 150%!important;  /* You can adjust this value for your desired portrait aspect ratio */
                    {% endif %}"
                  >
                    
                    <a href="{{ product.url }}" class="product-image-link-{{ section.id }}">
                      {% comment %} First image {% endcomment %}
                      {% assign image = product.selected_or_first_available_variant.featured_image
                        | default: product.featured_image
                        | default: product.images.first
                      %}
                      <img
                        class="product-image-{{ section.id }} card--media"
                        src="{{ image | image_url: width: 533 }}"
                        srcset="
                          {{ image | image_url: width: 360 }} 360w,
                          {{ image | image_url: width: 533 }} 533w,
                          {{ image | image_url: width: 720 }} 720w
                        "
                        sizes="(max-width: 749px) 100vw, 25vw"
                        alt="{{ image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="{{ image.width }}"
                        height="{{ image.height }}"
                      >
                        
                      {% comment %} Secondary/hover image: {% endcomment %}
                      {% assign image = product.images
                        | where: 'position', 2
                        | first
                      %}
                      {% if image != blank and section.settings.secondary_image_hover == true %}
                        <img
                          class="product-hover-image-{{ section.id }}"
                          src="{{ image | image_url: width: 533 }}"
                          srcset="
                            {{ image | image_url: width: 360 }} 360w,
                            {{ image | image_url: width: 533 }} 533w,
                            {{ image | image_url: width: 720 }} 720w
                          "
                          sizes="(max-width: 749px) 100vw, 25vw"
                          alt="{{ image.alt | default: product.title | escape }}"
                          loading="lazy"
                          width="{{ image.width }}"
                          height="{{ image.height }}"
                        >
                      {% endif %}
                    </a>

