      }
      .variant-thumb-{{ section.id }}:disabled {
        opacity: 0.35;
        cursor: not-allowed;
      }
      .price-has-compare-at-price-{{ section.id }} {}
      @media screen and (min-width: 750px) {
        .swiper.mobile-swiper-{{ section.id }} {
          display: none;
        }
      }
    </style>
    <div
      class=""
    >
      {% for block in section.blocks %}
