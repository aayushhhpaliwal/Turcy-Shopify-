<style>
  .section-{{ section.id }}-padding {
    max-width: var(--max-width);
    margin:  var(--mt) auto var(--mb) auto;
    padding: 0 {{ section.settings.padding_sides_mobile }}rem;
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    line-height: 1;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding: 0 {{ section.settings.padding_sides }}rem;
      padding-top: var(--pt-desktop);
      padding-bottom: var(--pb-desktop);
    }
  }
.ap-collection {
  flex-shrink: 0;
  width: 100%;
  height: 100%;
  position: relative;
  display: block;
  overflow: visible;

  /* Layout */
  padding: 0 0 1rem;
  border-radius: 16px;

  /* Glassmorphism base */
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  /* Subtle border */
  border: 1px solid rgba(255, 255, 255, 0.25);

  /* Soft blurred shadow */
  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.35);

  /* Smooth animation */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
@media screen and (min-width: 749px) {
/* Hover elevation - disabled */
{% comment %} .ap-collection:hover {
  transform: none;
  box-shadow: none;
} {% endcomment %}
.shop-now-btn {
  display: block;
  width: auto;
  padding: 14px 18px;
  border-radius: 999px;
  {% comment %} background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.35),
    rgba(255, 255, 255, 0.15)
  ); {% endcomment %}
  background: #5D4C45;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid #fff;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;

  /* Depth */
margin-top:15px;
border

  /* Animation */
  transition: all 0.3s ease;
}

.shop-now-btn:hover {
  transform: translateY(-2px);
  color: #000000ff;
  border: 1px solid black;
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.55),
    rgba(255, 255, 255, 0.25)
  );
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.shop-now-btn:active {
  transform: translateY(0);
  box-shadow:
    0 6px 16px rgba(0, 0, 0, 0.18),
    inset 0 2px 4px rgba(0, 0, 0, 0.12);
}

/* Add-to-cart button styles */
.add-to-cart-btn-{{ section.id }} {
  position: absolute;
  left: 50%;
  width:90%;
  transform: translateX(-50%) translateY(10px);
  bottom: 16px;
  display: inline-block;
  padding: 14px 18px;
  border-radius: 30px;
  background: #5D4C45;
  color: #fff;
  border: 1px solid #5D4C45;
  box-sizing: border-box;
  font-weight: 600;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.15s ease, transform 0.15s ease;
  z-index: 3;
}

/* keep simple hover transform but no shadow */
.add-to-cart-btn-{{ section.id }}:hover {
  transform: translateX(-50%) translateY(0);
}

.ap-collection:hover .add-to-cart-btn-{{ section.id }} {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.add-to-cart-btn-{{ section.id }}.add-to-cart-btn--below {
  display: none;
}
}
@media screen and (max-width: 749px) {
  .add-to-cart-btn-{{ section.id }} {
    position: static;
    transform: none;
    opacity: 1;
    pointer-events: auto;
    margin-top: 8px;
    width: 100%;
    text-align:center;
    background: #5D4C45;
    border: 1px solid #5D4C45;
    border-radius: 30px;
    color: #fff;
    padding:10px 0;
  }
  .add-to-cart-btn-{{ section.id }}.add-to-cart-btn--overlay {
    display: none;
  }
  .add-to-cart-btn-{{ section.id }}[disabled], .add-to-cart-btn-{{ section.id }}[aria-disabled="true"] {
    background: #ccc;
    border: 1px solid #ccc;
    color: #fff;
    cursor: not-allowed;
    opacity: 1;
    pointer-events: none;
  }
}

/* Disabled state for desktop */
.add-to-cart-btn-{{ section.id }}[disabled], .add-to-cart-btn-{{ section.id }}[aria-disabled="true"] {
  background: #ccc;
  border: 1px solid #ccc;
  color: #fff;
  cursor: not-allowed;
  opacity: 1;
  pointer-events: none;
}

</style>

<div class="BT-div"
  style="
