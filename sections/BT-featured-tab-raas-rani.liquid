                        <button type="submit" class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--overlay" aria-label="Add {{ product.title }} to cart">Add to cart</button>
                      </form>
                    {% else %}
                      <button class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--overlay" disabled aria-disabled="true">Sold out</button>
                    {% endif %}

                  </div>

                  <div style="margin:10px 10px;">
                    <a
                      class="product-title-{{ section.id }}"
                      href="{{ product.url }}"
                    >
                      {{ product.title }}
                    </a>
                    <div
                      style="font-size: {{ section.settings.product_price_size }}px; margin-top:10px;"
                    >
                      {% if product.variants != blank and product.price_min != product.price_max %}
                        <span
                          class="price-{{ section.id }}"
                          style="color: {{ section.settings.normal_price_color }};"
                        >
                          {{ product.price_min | money }}
                        </span>
                      {% else %}
                        {% comment %} Price and compare at price: {% endcomment %}
                        {% if product.compare_at_price_max > product.price %}
                          <span
                            class="price-{{ section.id }}"
                            style="color:{{ section.settings.discounted_price_color }};"
                          >
                            {{ product.price | money }}
                          </span>
                          <span
                            class="compare-at-price-{{ section.id }}"
                            style="color: {{ section.settings.normal_price_color }};"
                          >
                            {{ product.compare_at_price_max | money }}
                          </span>
                        {% else %}
                          <span
                            class="price-{{ section.id }}"
                            style="color: {{ section.settings.normal_price_color }};"
                          >
                            {{ product.price | money }}
                          </span>
                        {% endif %}
                      {% endif %}
