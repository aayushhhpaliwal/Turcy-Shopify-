          class="
            tab-content-{{ section.id }}
            {% if forloop.first %}
              tab-content--active-{{ section.id }}
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >
          {% assign slider_enabled = section.settings.show_products_slider %}
          {% capture content %}
