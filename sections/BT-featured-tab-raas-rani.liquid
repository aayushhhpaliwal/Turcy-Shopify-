                              {% assign seen_colors = seen_colors | append: color_key %}
                              {% assign variant_image = variant.featured_image | default: product.featured_image %}
                              <button
                                type="button"
                                class="variant-thumb-{{ section.id }} {% if variant.id == product.selected_or_first_available_variant.id %}is-active{% endif %}"
                                data-product-id="{{ product.id }}"
                                data-variant-id="{{ variant.id }}"
                                data-image="{{ variant_image | image_url: width: 533 }}"
                                data-alt="{{ variant_image.alt | default: product.title | escape }}"
                                aria-label="{{ color_value }}"
                              >
                                <img
                                  src="{{ variant_image | image_url: width: 80 }}"
                                  alt="{{ variant_image.alt | default: color_value | escape }}"
                                  loading="lazy"
                                  width="{{ variant_image.width }}"
                                  height="{{ variant_image.height }}"
                                >
                              </button>
                            {% endunless %}
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}

                    {% if product.selected_or_first_available_variant != blank %}
                      <form method="post" action="{{ routes.cart_add_url }}" class="add-to-cart-form-{{ section.id }}" style="display:block;">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="variant-id-input" data-product-id="{{ product.id }}">
                        <button type="submit" class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--below" aria-label="Add {{ product.title }} to cart">Add to cart</button>
                      </form>
                    {% else %}
                      <button class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--below" disabled aria-disabled="true">Sold out</button>
                    {% endif %}



                  </div>
                </div>
              {% endfor %}
            {% else %}
              {% comment %} Place holder grid and swiper: {% endcomment %}
              {% for i in (1..block.settings.product_limit) %}
                <div class="swiper-slide ap-collection">
                  <div
                    class="product-image-wrapper-{{ section.id }}"
                  >
                    <div
                      class="product-image-{{ section.id }} "
                      style="background-color: #f4f4f4;"
                    >
                      {{ 'product-1' | placeholder_svg_tag: '' }}
                    </div>
                    <button class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--overlay" disabled>Add to cart</button>
                  </div>
                  <div>
                    <div
                      class="product-title-{{ section.id }}"
                    >
                      Product title
                    </div>
                    <div
                      class="price-{{ section.id }}"
                    >
                      <span
                        class="compare-at-price-{{ section.id }}"
                        style="color: gray;"
                      >
                        $860.00
                      </span>
                      <span
                        class="price-{{ section.id }}"
                        style="color: #ff3451;"
                      >
                        $756.00
                      </span>
                    </div>
                    <button class="add-to-cart-btn-{{ section.id }} add-to-cart-btn--below" disabled>Add to cart</button>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          {% endcapture %}
          {% comment %} Mobile content: {% endcomment %}
          {% comment %} {% if block.settings.enable_swiper_on_mobile %}
            <div class="swiper mobile-swiper-{{ section.id }}">
              <div class="swiper-wrapper">
                {{ content }}
              </div>
            </div>
          {% endif %} {% endcomment %}

          {% comment %} Desktop content: {% endcomment %}
          {% if slider_enabled %}
            <div class="tab-slider-{{ section.id }}" data-desktop-columns="{{ block.settings.product_row_count }}" data-mobile-columns="{{ block.settings.mobile_product_row_count }}">
              <div
                class="tab-slider-track-{{ section.id }}"
                style="--slider-gap: {{ section.settings.image_gap }}px; --slider-columns-desktop: {{ block.settings.product_row_count }}; --slider-columns-mobile: {{ block.settings.mobile_product_row_count }};"
              >
                {{ content }}
              </div>
              <button type="button" class="tab-slider-btn-{{ section.id }} tab-slider-btn--prev" aria-label="Previous products">‹</button>
              <button type="button" class="tab-slider-btn-{{ section.id }} tab-slider-btn--next" aria-label="Next products">›</button>
            </div>
          {% else %}
            <div
              class="
                tab-content-grid-{{ section.id }}
                {% comment %} {% if block.settings.enable_swiper_on_mobile %}
                  tab-content-grid--desktop-only-{{ section.id }}
                {% endif %} {% endcomment %}
              "
              style="--desktop-product-row-count: {{ block.settings.product_row_count }};--mobile-product-row-count: {{ block.settings.mobile_product_row_count }};"
            >
              {{ content }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <style>
              .ug-collections-cta-button-{{ section.id }} {
                pointer-events: all;
                height: var(--button-height, 48px);
                display: flex;
                justify-content: center;
                align-items: center;
                width: var(--button-width);
                background-color: var(--button-bg);
                color: var(--button-color);
                font-size: var(--button-font-size);
                text-align: center;
                text-decoration: none;
                border-radius: var(--border-radius);
                border: var(--border);
                transition: all 0.3s ease-in-out;
              }
              .ug-collections-cta-button-{{ section.id }}:hover {
                background-color: var(--button-bg-hover);
                color: var(--button-color-hover);
              }
            </style>
            <a
              href="{{ block.settings.button_link }}"
              class="ug-collections-cta-button-{{ section.id }}"
              style="
                margin: {{ block.settings.button_mt }}px auto 0;
                --button-height: {{ section.settings.button_height }}px;
                --button-width: {{ section.settings.button_width }}px;
                --button-color: {{ section.settings.button_color }};
                --button-bg: {{ section.settings.button_background_color }};
                --button-color-hover: {{ section.settings.button_color_hover }};
                --button-bg-hover: {{ section.settings.button_background_color_hover }};
                --button-font-size: {{ section.settings.button_font_size | times: 0.85 }}px;
                --button-font-size-desktop: {{ section.settings.button_font_size }}px;
                --border-radius: {{ section.settings.button_border_radius }}px;
                --border: {{ section.settings.button_border_thickness }}px {{ block.settings.button_border_color }} solid;
              "
            >
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
