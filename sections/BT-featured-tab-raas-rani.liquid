        }
      }
    </style>
    <div class="overflow-container-{{ section.id }}">
      <style>
        .tabs-header-{{ section.id }} {
          display: flex;
          align-items: middle;
          justify-content: space-between;
          gap: 1rem;
          width: 100%;
          flex-direction:column
        }
        .section-title-{{ section.id }} {
          margin: auto;
          font-size: 2.5rem;
          font-weight: 600;
          margin-bottom: 20px;
        }
        @media screen and (max-width: 749px) {
          .tabs-header-{{ section.id }} {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
          }
          .tab-container-{{ section.id }} {
            width: 100%;
          }
            .section-title-{{ section.id }} {
          margin: 0;
          font-size: 2.5rem;
          font-weight: 600;
          margin:auto;
        }
        }
      </style>

      <div class="tabs-header-{{ section.id }}" style="--tabs-margin-bottom: {{ section.settings.tabs_margin_bottom }}px;">
        {% if section.settings.section_title != blank %}
          <h2 class="section-title-{{ section.id }}">{{ section.settings.section_title }}</h2>
        {% endif %}

        <div
          class="tab-container-{{ section.id }}"
          style="
            {% case section.settings.tabs_align %}
              {% when 'left' %}
                --justify-content: flex-start;
              {% when 'center' %}
                --justify-content: center;
              {% when 'right' %}
                --justify-content: flex-end;
            {% endcase %}
            margin-bottom: var(--tabs-margin-bottom);
            --gap: {{ section.settings.tabs_spacing }}px;
            --gap-mobile: {{ section.settings.tabs_spacing_mobile }}px;
          "
        >
        <style>
          .tab-{{ section.id }} {
            cursor: pointer;
            text-align: center;
            font-size: var(--font-size-mobile);
            white-space: nowrap;
            color: var(--inactive-color);
          }
          .ap-custom-tab:hover{
            color:grey;
            border-bottom: 4px solid grey;
          }
          @media (min-width: 750px) {
            .tab-{{ section.id }} {
              font-size: var(--font-size);
            }
          }
          .tab--active-{{ section.id }} {
            cursor: default;
            color: var(--active-color);
            border-bottom: 4px solid #BC0202;
            font-weight: 600;
          }
        </style>
        {% for block in section.blocks %}
          {% if block.settings.title != blank %}
            <div
              class="
                tab-{{ section.id }}
                {% if forloop.first %}
                tab--active-{{ section.id }}
                {% endif %} ap-custom-tab
              "
              style="
                --inactive-color: {{ section.settings.tabs_color }};
                --active-color: {{ section.settings.tabs_color_active }};
                --font-size: {{ section.settings.tabs_size }}px;
                --font-size-mobile: {{ section.settings.tabs_size_mobile }}px;
                padding-bottom: {{ section.settings.tabs_padding_bottom }}px;
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <style>
      .tab-content-{{ section.id }} {
        display: none;
      }
      .tab-content--active-{{ section.id }} {
        display: block;
      }
      .tab-content-grid-{{ section.id }} {
        display: grid;
        gap: {{section.settings.image_gap}}px;
        grid-template-columns: repeat(var(--mobile-product-row-count), minmax(0, 1fr));
      }
      .tab-content-grid--desktop-only-{{ section.id }} {
        display: none;
      }

      .price-template--18538638016605__bt_featured_tabs_arp7mW{
        font-weight: 600;
      }
      .tab-slider-{{ section.id }} {
        position: relative;
      }
      .tab-slider-track-{{ section.id }} {
        display: grid;
        grid-auto-flow: column;
        gap: var(--slider-gap);
        grid-auto-columns: calc((100% - (var(--slider-gap) * (var(--slider-columns-mobile) - 1))) / var(--slider-columns-mobile));
        overflow-x: auto;
        padding: 0 4px 10px;
        scroll-snap-type: x mandatory;
        scrollbar-width: none; /* hide scrollbar in Firefox */
        -ms-overflow-style: none; /* hide scrollbar in IE/Edge */
      }
      .tab-slider-track-{{ section.id }}::-webkit-scrollbar {
        display: none; /* hide scrollbar in WebKit */
      }
      .tab-slider-track-{{ section.id }} > * {
        scroll-snap-align: start;
      }
      .tab-slider-btn-{{ section.id }} {
        position: absolute;
        top: 45%;
        transform: translateY(-50%);
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.75);
        color: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
        transition: opacity 0.2s ease;
      }
      .tab-slider-btn--prev {
        left: -14px;
      }
      .tab-slider-btn--next {
        right: -14px;
      }
      .tab-slider-btn-{{ section.id }}.is-disabled {
        opacity: 0.35;
        pointer-events: none;
      }
      
      @media screen and (min-width: 750px) {
          .tab-content-grid--desktop-only-{{ section.id }} {
            display: grid;
          }
        .tab-content-grid-{{ section.id }} {
          grid-template-columns: repeat(var(--desktop-product-row-count), minmax(0, 1fr));
        }
        .tab-slider-track-{{ section.id }} {
          grid-auto-columns: calc((100% - (var(--slider-gap) * (var(--slider-columns-desktop) - 1))) / var(--slider-columns-desktop));
        }
        .tab-slider-btn-{{ section.id }} {
          display: grid;
        }
      }
      .product-image-wrapper-{{ section.id }} {
        border-radius: {{section.settings.image_roundness}}px;
        position: relative;
        display: block;
        width: 100%;
        padding-top: 100%;
        overflow: hidden;
      }
      .product-image-{{ section.id }},
      .product-hover-image-{{ section.id }} {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .product-hover-image-{{ section.id }} {
        object-fit: cover;
      }
      .product-hover-image-{{ section.id }} {
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
      }
      .product-image-wrapper-{{ section.id }}:hover .product-hover-image-{{ section.id }} {
        opacity: 1;
      }
      .product-title-{{ section.id }} {
        display: block;
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
        text-decoration: none;
        font-size: var(--product-title-size);
        color: var(--product-title-color);
        line-height: {{section.settings.product_title_line_height}};
        font-size: 1.8rem;
      }
      @media screen and (max-width: 749px) {
        .product-title-{{ section.id }} {
          font-size: 1.3rem;
        }
        /* jayesh */
        .product-title-{{ section.id }} {
          -webkit-line-clamp: 1;
          -webkit-box-orient: vertical;
          display: -webkit-box;
          overflow: hidden;
        }
        .tab-content-grid-{{ section.id }} {
          grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
        .tab-slider-btn-{{ section.id }} {
          display: none;
        }
      }
      .price-{{ section.id }} {
        font-size: {{ section.settings.product_price_size }}px;
        margin-top:10px;
      }
      .compare-at-price-{{ section.id }} {
