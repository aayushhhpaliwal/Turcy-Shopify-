{% comment %} <link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
>
<script
  defer
  src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"
></script> {% endcomment %}

<script>
  (function () {
    function sectionSetup() {
      // get all tab elements using .tab-{{ section.id }}
      const tabs = document.querySelectorAll('.tab-{{ section.id }}');
      const tabActiveClass = 'tab--active-{{ section.id }}';
      // get all tab content using .tab-content-{{ section.id }}
      const tabContents = document.querySelectorAll(
        '.tab-content-{{ section.id }}'
      );
      const tabContentActiveClass = 'tab-content--active-{{ section.id }}';
      const tabContainerSelector = '.tab-container-{{ section.id }}';

      const scrollTabToLeft = (tab) => {
        const tabContainer = tab.closest(tabContainerSelector);
        if (!tabContainer) return;

        const maxScrollLeft = tabContainer.scrollWidth - tabContainer.clientWidth;
        if (maxScrollLeft <= 0) return;

        const containerStyles = window.getComputedStyle(tabContainer);
        const paddingLeft = parseFloat(containerStyles.paddingLeft) || 0;
        const nextScrollLeft = Math.max(
          0,
          Math.min(tab.offsetLeft - paddingLeft, maxScrollLeft)
        );

        tabContainer.scrollTo({
          left: nextScrollLeft,
          behavior: 'smooth',
        });
      };

      // listen for click event on each tab
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          // remove active class from all tabs
          tabs.forEach((tab) => {
            tab.classList.remove(tabActiveClass);
          });
          // add active class to clicked tab
          tab.classList.add(tabActiveClass);

          // remove active class from all tab contents
          tabContents.forEach((tabContent) => {
            tabContent.classList.remove(tabContentActiveClass);
          });
          // add active class to corresponding tab content
          tabContents[index].classList.add(tabContentActiveClass);

          // Shift the tab row so clicked tab moves to the left and other tabs remain visible.
          scrollTabToLeft(tab);
        });
      });

      const sliderEnabled = {{ section.settings.show_products_slider | json }};
      if (sliderEnabled) {
        const sliders = document.querySelectorAll('.tab-slider-{{ section.id }}');
        sliders.forEach((slider) => {
          if (slider.dataset.sliderBound === 'true') return;
          slider.dataset.sliderBound = 'true';

          const track = slider.querySelector('.tab-slider-track-{{ section.id }}');
          const prev = slider.querySelector('.tab-slider-btn--prev');
          const next = slider.querySelector('.tab-slider-btn--next');

          const updateButtons = () => {
            if (!track) return;
            const maxScroll = track.scrollWidth - track.clientWidth - 1;
            const atStart = track.scrollLeft <= 0;
            const atEnd = track.scrollLeft >= maxScroll;
            prev?.classList.toggle('is-disabled', atStart);
            next?.classList.toggle('is-disabled', atEnd);
          };

          const scrollByViewport = (direction) => {
            if (!track) return;
            const amount = track.clientWidth || 0;
            track.scrollBy({ left: direction * amount, behavior: 'smooth' });
          };

          prev?.addEventListener('click', () => scrollByViewport(-1));
          next?.addEventListener('click', () => scrollByViewport(1));
          track?.addEventListener('scroll', updateButtons, { passive: true });
          window.addEventListener('resize', updateButtons);
          updateButtons();
        });
      }

      // Variant selector: update ATC inputs + main image per card (thumbnail buttons)
      const bindVariantThumbs = () => {
        const thumbs = document.querySelectorAll('.variant-thumb-{{ section.id }}');
        thumbs.forEach((thumb) => {
          if (thumb.dataset.variantBound === 'true') return;
          thumb.dataset.variantBound = 'true';

          thumb.addEventListener('click', () => {
            if (thumb.disabled) return;
            const card = thumb.closest('.ap-collection');
            const productId = thumb.dataset.productId;
            const variantId = thumb.dataset.variantId;
            if (!card || !variantId) return;

            // toggle active thumb within same group
            const group = card.querySelectorAll(`.variant-thumb-{{ section.id }}[data-product-id=\"${productId}\"]`);
            group.forEach((btn) => btn.classList.remove('is-active'));
            thumb.classList.add('is-active');

            // Update hidden variant inputs for both ATC buttons
            card.querySelectorAll('.variant-id-input').forEach((input) => {
              input.value = variantId;
            });

            // Swap main product image to selected variant image
            const newSrc = thumb.dataset.image;
            if (newSrc) {
              const mainImg = card.querySelector('.product-image-{{ section.id }}');
              if (mainImg) {
                mainImg.src = newSrc;
                if (thumb.dataset.alt) mainImg.alt = thumb.dataset.alt;
              }
              const hoverImg = card.querySelector('.product-hover-image-{{ section.id }}');
              if (hoverImg) {
                hoverImg.src = newSrc;
                if (thumb.dataset.alt) hoverImg.alt = thumb.dataset.alt;
              }
            }
          });
        });
      };

      bindVariantThumbs();

      // Mobile swiper init:
      {% comment %} new Swiper('.mobile-swiper-{{ section.id }}', { {% endcomment %}
        {% comment %} slidesPerView: 1.2, {% endcomment %}
        {% comment %} spaceBetween: 20, {% endcomment %}
        //pagination: {
        //  el: '.swiper-pagination',
        //  clickable: true,
        //},
      {% comment %} }); {% endcomment %}

      // Bind add-to-cart AJAX for the section forms
      const addToCartForms = document.querySelectorAll('.add-to-cart-form-{{ section.id }}');
      addToCartForms.forEach((form) => {
        // avoid binding twice
        if (form.dataset.atcBound === 'true') return;
        form.dataset.atcBound = 'true';

        form.addEventListener('submit', function (evt) {
          evt.preventDefault();
          const submitButton = form.querySelector('button[type="submit"]');
          if (!submitButton || submitButton.getAttribute('aria-disabled') === 'true' || submitButton.disabled) return;

          submitButton.setAttribute('aria-disabled', true);
          submitButton.classList.add('loading');

          const cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');

          const config = fetchConfig('javascript');
          config.headers['X-Requested-With'] = 'XMLHttpRequest';
          delete config.headers['Content-Type'];

          const formData = new FormData(form);

          if (cart) {
            formData.append(
              'sections',
              cart.getSectionsToRender().map((section) => section.id)
            );
            formData.append('sections_url', window.location.pathname);
            cart.setActiveElement(document.activeElement);
          }

          config.body = formData;

          fetch(`${routes.cart_add_url}`, config)
            .then((response) => response.json())
            .then((response) => {
              if (response.status) {
                // simple error handling
                console.error('Add to cart error', response);
                return;
              }

              if (!cart) {
                window.location = window.routes.cart_url;
                return;
              }

              // Update drawer contents and open it
              cart.renderContents(response);
            })
            .catch((e) => {
              console.error(e);
            })
            .finally(() => {
              submitButton.classList.remove('loading');
              if (cart && cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
              submitButton.removeAttribute('aria-disabled');
            });
        });
      });
    }

    //sectionSetup();
    document.addEventListener('DOMContentLoaded', sectionSetup);

    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail.sectionId !== '{{ section.id }}') return;
        sectionSetup();
      });
    }
  })(); 
</script>

