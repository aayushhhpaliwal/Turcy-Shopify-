        cursor: pointer;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .variant-thumb-{{ section.id }} img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .variant-thumb-{{ section.id }}:hover:not(:disabled) {
        border-color: #111;
      }
      .variant-thumb-{{ section.id }}.is-active {
