{% comment %} 
                    Custom Apart Slider Section
                    Compatible with Shopify Dawn theme 
{% endcomment %}

<section
  id="custom-apart-{{ section.id }}"
  class="custom-apart-section"
  style="
    --section-bg: {{ section.settings.section_bg }};
    --heading-color: {{ section.settings.heading_color }};
    --card-bg: {{ section.settings.card_bg }};
    --text-color: {{ section.settings.text_color }};
    --subtext-color: {{ section.settings.subtext_color }};
    --icon-bg: {{ section.settings.icon_bg }};
    --icon-color: {{ section.settings.icon_color }};
    --arrow-bg: {{ section.settings.arrow_bg }};
    --arrow-color: {{ section.settings.arrow_color }};
    --section-width: {{ section.settings.section_width }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --card-height: {{ section.settings.card_height }}px;
    --card-gap: {{ section.settings.card_gap }}px;
    --desktop-columns: {{ section.settings.desktop_columns }};
    --tablet-columns: {{ section.settings.tablet_columns }};
    --mobile-columns: {{ section.settings.mobile_columns }};
  ">
  <div class="custom-apart-container">
    {% if section.settings.heading != blank %}
      <h2 class="custom-apart-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="custom-apart-slider-wrap">
      {% if section.settings.show_arrows %}
        <button class="custom-apart-arrow custom-apart-prev" aria-label="Previous">
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22">
            <path
              d="M15 18L9 12L15 6"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </button>
      {% endif %}

      <div class="custom-apart-slider" data-slider>
        {% for block in section.blocks %}
          <div class="custom-apart-card" {{ block.shopify_attributes }}>
            <div class="custom-apart-icon">
              {% if block.settings.icon_image != blank %}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 120 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="60"
                  height="60">
              {% else %}
                <span>{{ block.settings.icon_text }}</span>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button class="custom-apart-arrow custom-apart-next" aria-label="Next">
          <svg
            viewBox="0 0 24 24"
            width="22"
            height="22">
            <path
              d="M9 6L15 12L9 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #custom-apart-{{ section.id }} {
    background: var(--section-bg);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-container {
    max-width: var(--section-width);
    margin: 0 auto;
    padding: 0 32px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-heading {
    margin: 0 0 38px;
    text-align: center;
    color: var(--heading-color);
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 1px;
    word-break: break-word;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-slider-wrap {
    position: relative;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-slider {
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 0;
    scroll-padding-left: 0;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-slider::-webkit-scrollbar {
    display: none;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-card {
    flex: 0 0 calc((100% - (var(--card-gap) * (var(--desktop-columns) - 1))) / var(--desktop-columns));
    min-height: var(--card-height);
    background: var(--card-bg);
    color: var(--text-color);
    box-sizing: border-box;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 42px 34px;
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: {% if section.settings.enable_shadow %}0 12px 35px rgba(0,0,0,0.08){% else %}none{% endif %};
    min-width: 0;
}

#custom-apart-{{ section.id }}
.custom-apart-icon {
  width: {{ section.settings.icon_circle_size }}px;
  height: {{ section.settings.icon_circle_size }}px;
  border-radius: 50%;
  background: var(--icon-bg);
  color: var(--icon-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  font-size: {{ section.settings.icon_text_size }}px;
  font-weight: 700;
}

#custom-apart-{{ section.id }}
.custom-apart-icon img {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  object-fit: contain;
  display: block;
}

#custom-apart-{{ section.id }}
.custom-apart-card h3 {
  margin: 0 0 14px;
  font-size: {{ section.settings.card_title_size }}px;
  line-height: 1.35;
  font-weight: 700;
  color: var(--text-color);
  overflow-wrap: anywhere;
}

#custom-apart-{{ section.id }}
.custom-apart-card p {
  margin: 0;
  max-width: 280px;
  font-size: {{ section.settings.card_text_size }}px;
  line-height: 1.55;
  color: var(--subtext-color);
  overflow-wrap: anywhere;
}

#custom-apart-{{ section.id }}
.custom-apart-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: {{ section.settings.arrow_size }}px;
  height: {{ section.settings.arrow_size }}px;
  border-radius: 50%;
  border: none;
  background: var(--arrow-bg);
  color: var(--arrow-color);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 3;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  transition: 0.25s ease;
}

#custom-apart-{{ section.id }} .custom-apart-arrow:hover:not(:disabled) {
  transform: translateY(-50%) scale(1.06);
}

#custom-apart-{{ section.id }} .custom-apart-arrow:disabled {
  opacity: .45;
  cursor: default;
}

#custom-apart-{{ section.id }}
.custom-apart-prev {
  left: -52px;
}

#custom-apart-{{ section.id }}
.custom-apart-next {
  right: -52px;
}

@media screen and (max-width: 1200px) {
  #custom-apart-{{ section.id }} .custom-apart-slider {
    padding-left: 46px;
    padding-right: 46px;
    scroll-padding-left: 46px;
  }

  #custom-apart-{{ section.id }} .custom-apart-prev {
    left: 8px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-next {
    right: 8px;
  }
}

@media screen and (max-width: 989px) {
  #custom-apart-{{ section.id }} {
    padding-top: calc(var(--padding-top) * .72);
    padding-bottom: calc(var(--padding-bottom) * .72);
  }

  #custom-apart-{{ section.id }} .custom-apart-container {
    padding: 0 24px;
  }

  #custom-apart-{{ section.id }} .custom-apart-heading {
    margin-bottom: 30px;
    font-size: {{ section.settings.tablet_heading_size }}px;
  }

  #custom-apart-{{ section.id }} .custom-apart-card {
    flex-basis: calc((100% - (var(--card-gap) * (var(--tablet-columns) - 1))) / var(--tablet-columns));
    min-height: {{ section.settings.tablet_card_height }}px;
    padding: 36px 26px;
  }

  #custom-apart-{{ section.id }} .custom-apart-card h3 {
    font-size: {{ section.settings.tablet_card_title_size }}px;
  }

  #custom-apart-{{ section.id }} .custom-apart-card p {
    font-size: {{ section.settings.tablet_card_text_size }}px;
  }
}

@media screen and (max-width: 749px) {
  #custom-apart-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-container {
    padding: 0 16px;
  }

  #custom-apart-{{ section.id }} .custom-apart-slider {
    padding-left: 40px;
    padding-right: 40px;
    scroll-padding-left: 40px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-heading {
    margin-bottom: 24px;
    font-size: {{ section.settings.mobile_heading_size }}px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-card {
    flex-basis: calc((100% - (var(--card-gap) * (var(--mobile-columns) - 1))) / var(--mobile-columns));
    min-height: {{ section.settings.mobile_card_height }}px;
    padding: 30px 20px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-card h3 {
    font-size: {{ section.settings.mobile_card_title_size }}px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-card p {
    font-size: {{ section.settings.mobile_card_text_size }}px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-arrow {
    width: 34px;
    height: 34px;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-prev {
    left: 0;
  }

  #custom-apart-{{ section.id }}
  .custom-apart-next {
    right: 0;
  }
}

@media screen and (max-width: 479px) {
  #custom-apart-{{ section.id }} .custom-apart-container {
    padding: 0 12px;
  }

  #custom-apart-{{ section.id }} .custom-apart-slider {
    gap: 14px;
    padding-left: 38px;
    padding-right: 38px;
    scroll-padding-left: 38px;
  }

  #custom-apart-{{ section.id }} .custom-apart-card {
    flex-basis: 100%;
    min-height: {{ section.settings.mobile_card_height | minus: 30 | at_least: 220 }}px;
    padding: 26px 18px;
  }

  #custom-apart-{{ section.id }} .custom-apart-icon {
    width: {{ section.settings.icon_circle_size | times: 0.78 | round }}px;
    height: {{ section.settings.icon_circle_size | times: 0.78 | round }}px;
    margin-bottom: 16px;
    font-size: {{ section.settings.icon_text_size | times: 0.82 | round }}px;
  }

  #custom-apart-{{ section.id }} .custom-apart-icon img {
    width: {{ section.settings.icon_size | times: 0.82 | round }}px;
    height: {{ section.settings.icon_size | times: 0.82 | round }}px;
  }

  #custom-apart-{{ section.id }} .custom-apart-arrow {
    width: 32px;
    height: 32px;
  }
}
</style>

<script>
  (function () {
    const section = document.querySelector('#custom-apart-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('[data-slider]');
    const prev = section.querySelector('.custom-apart-prev');
    const next = section.querySelector('.custom-apart-next');

    if (!slider) return;

    function getScrollAmount() {
      const card = slider.querySelector('.custom-apart-card');
      if (!card) return 320;
      const gap = parseInt(getComputedStyle(slider).gap) || 24;
      return card.offsetWidth + gap;
    }

    function updateArrowState() {
      const maxScrollLeft = Math.max(0, slider.scrollWidth - slider.clientWidth);
      const atStart = slider.scrollLeft <= 2;
      const atEnd = slider.scrollLeft >= maxScrollLeft - 2;

      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd || maxScrollLeft <= 0;
    }

    function scrollByCard(direction) {
      slider.scrollBy({
        left: getScrollAmount() * direction,
        behavior: 'smooth'
      });
    }

    if (prev) {
      prev.addEventListener('click', function () {
        scrollByCard(-1);
      });
    }

    if (next) {
      next.addEventListener('click', function () {
        scrollByCard(1);
      });
    }

    slider.addEventListener('scroll', updateArrowState);
    window.addEventListener('resize', updateArrowState);
    updateArrowState();

    {% if section.settings.enable_autoplay %}
      let autoplayTimer = setInterval(function () {
        const maxScrollLeft = slider.scrollWidth - slider.clientWidth;

        if (slider.scrollLeft >= maxScrollLeft - 10) {
          slider.scrollTo({
            left: 0,
            behavior: 'smooth'
          });
        } else {
          slider.scrollBy({
            left: getScrollAmount(),
            behavior: 'smooth'
          });
        }
      }, {{ section.settings.autoplay_speed | times: 1000 }});

      slider.addEventListener('mouseenter', function () {
        clearInterval(autoplayTimer);
      });
    {% endif %}

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === {{ section.id | json }}) updateArrowState();
    });
  })();
</script>

