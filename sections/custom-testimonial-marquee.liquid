
{% style %}
.laavan-marquee {
  width: 100%;
  overflow: hidden;
  padding: 24px 0;
  background: #F9F9F9;
}

.marquee-track {
  display: flex;
  gap: 50px;
  width: fit-content;
  will-change: transform;
}

.marquee-track.top {
  animation: scrollLeft 28s linear infinite;
  margin-bottom: 16px;
}

.marquee-track.bottom {
  animation: scrollRight 32s linear infinite;
}

.laavan-marquee:hover .marquee-track {
  animation-play-state: paused;
}

@keyframes scrollLeft {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@keyframes scrollRight {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.review-pill {
  flex-shrink: 0;
  background: #fff;
  padding: 10px 16px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 310px;
  color: #111;
}

.review-avatar {
  width: 50px;
  height: 50px;
  border-radius: 100%;
  object-fit: cover;
  flex-shrink: 0;
}

.review-content {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.review-name {
  font-size: 15px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
}

.stars {
  color: #ffb700;
  font-size: 10px;
}

.review-text {
  font-size: 12px;
  color: #444;
  line-height: 1.3;
  margin: 0;
}

@media screen and (max-width: 768px) {
  .review-pill {
    padding: 9px 14px;
    max-width: 260px;
    gap: 8px;
  }
  .review-avatar {
    width: 24px;
    height: 24px;
  }
  .review-name {
    font-size: 12px;
  }
  .review-text {
    font-size: 11px;
  }
  .marquee-track {
    gap: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .marquee-track {
    animation: none !important;
  }
}

{% endstyle %}

<div class="laavan-marquee">

  <div class="marquee-track top">
    {% for block in section.blocks %}
    <div class="review-pill">
      {% if block.settings.image %}
      <img class="review-avatar" src="{{ block.settings.image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% endif %}
      <div class="review-content">
        <div class="review-name">
          {{ block.settings.name }}
          <span class="stars">⭐⭐⭐⭐⭐</span>
        </div>
        <div class="review-text">{{ block.settings.review }}</div>
      </div>
    </div>
    {% endfor %}
    {% for block in section.blocks %}
    <div class="review-pill">
      {% if block.settings.image %}
      <img class="review-avatar" src="{{ block.settings.image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% endif %}
      <div class="review-content">
        <div class="review-name">
          {{ block.settings.name }}
          <span class="stars">⭐⭐⭐⭐⭐</span>
        </div>
        <div class="review-text">{{ block.settings.review }}</div>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="marquee-track bottom">
    {% for block in section.blocks %}
    <div class="review-pill">
      {% if block.settings.image %}
      <img class="review-avatar" src="{{ block.settings.image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% endif %}
      <div class="review-content">
        <div class="review-name">
          {{ block.settings.name }}
          <span class="stars">⭐⭐⭐⭐⭐</span>
        </div>
        <div class="review-text">{{ block.settings.review }}</div>
      </div>
    </div>
    {% endfor %}
    {% for block in section.blocks %}
    <div class="review-pill">
      {% if block.settings.image %}
      <img class="review-avatar" src="{{ block.settings.image | image_url: width: 64 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% endif %}
      <div class="review-content">
        <div class="review-name">
          {{ block.settings.name }}
          <span class="stars">⭐⭐⭐⭐⭐</span>
        </div>
        <div class="review-text">{{ block.settings.review }}</div>
      </div>
    </div>
    {% endfor %}
  </div>

</div>


{% schema %}
{
  "name": "Infinite Testimonial",
  "tag": "section",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer Name",
          "default": "Priya"
        },
        {
          "type": "text",
          "id": "review",
          "label": "Review Text",
          "default": "Way better than I expected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Infinite Testimonial"
    }
  ]
}
{% endschema %}
