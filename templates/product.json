        "custom_liquid_mqqMQr": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"turcy-deals\">\n  <div class=\"turcy-deals__heading\">\n    <span class=\"turcy-deals__icon\">%</span>\n    <span>Deals</span>\n  </div>\n\n  <div class=\"turcy-deals__list\">\n\n    <div class=\"turcy-deal-card\">\n      <div class=\"turcy-deal-card__ribbon\">\n        OFFER ENDING SOON\n      </div>\n\n      <div class=\"turcy-deal-card__content\">\n        <div class=\"turcy-deal-card__top\">\n          <div class=\"turcy-deal-card__info\">\n            <div class=\"turcy-deal-card__offer\">\n              Get <span>10% OFF</span>\n            </div>\n\n            <div class=\"turcy-deal-card__condition\">\n              On your first order\n            </div>\n          </div>\n\n          <button\n            class=\"turcy-coupon\"\n            type=\"button\"\n            onclick=\"copyTurcyCoupon(this, 'first10')\"\n          >\n            <span>first10</span>\n\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <rect x=\"8\" y=\"8\" width=\"10\" height=\"11\" rx=\"1\"></rect>\n              <path d=\"M6 16H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1\"></path>\n            </svg>\n          </button>\n        </div>\n\n        <p class=\"turcy-deal-card__note\">\n          Note: Apply code at checkout to claim your first order discount.\n        </p>\n      </div>\n    </div>\n\n    <div class=\"turcy-deal-card\">\n      <div class=\"turcy-deal-card__ribbon\">\n        OFFER ENDING SOON\n      </div>\n\n      <div class=\"turcy-deal-card__content\">\n        <div class=\"turcy-deal-card__top\">\n          <div class=\"turcy-deal-card__info\">\n            <div class=\"turcy-deal-card__offer\">\n              Free <span>Shipping</span>\n            </div>\n\n            <div class=\"turcy-deal-card__condition\">\n              Order above ₹999\n            </div>\n          </div>\n\n          <div\n            class=\"turcy-coupon turcy-coupon--plain\"\n            aria-label=\"No coupon code required\"\n          >\n            <span>NO CODE</span>\n\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n              <path d=\"M3 6h11v11H3V6Z\"></path>\n              <path d=\"M14 10h4l3 3v4h-7v-7Z\"></path>\n              <circle cx=\"7\" cy=\"18\" r=\"2\"></circle>\n              <circle cx=\"18\" cy=\"18\" r=\"2\"></circle>\n            </svg>\n          </div>\n        </div>\n\n        <p class=\"turcy-deal-card__note\">\n          Note: Free shipping automatically applies on orders above ₹999.\n        </p>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.turcy-deals,\n.turcy-deals * {\n  box-sizing: border-box;\n}\n\n.turcy-deals {\n  width: 100%;\n  max-width: 1200px;\n  margin: 12px auto;\n  font-family: inherit;\n  background: #f3fbf5;\n}\n\n.turcy-deals__heading {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 34px;\n  padding: 5px 12px;\n  background: #ffffff;\n  border-radius: 0 0 16px 0;\n  color: #073f24;\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.turcy-deals__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #00a859, #dce84f);\n  color: #ffffff;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n/* Cards wrapper */\n.turcy-deals__list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n  padding: 20px 10px 10px;\n}\n\n/* Card */\n.turcy-deal-card {\n  position: relative;\n  min-width: 0;\n  background: #ffffff;\n  border: 1px solid #d9eadf;\n  border-radius: 7px;\n}\n\n/* Ribbon */\n.turcy-deal-card__ribbon {\n  position: absolute;\n  top: -11px;\n  left: -1px;\n  z-index: 2;\n\n  display: inline-flex;\n  align-items: center;\n  min-height: 20px;\n  padding: 4px 12px 4px 7px;\n\n  background: #008c49;\n  color: #ffffff;\n\n  font-size: 8px;\n  font-weight: 700;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.turcy-deal-card__ribbon::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  right: -9px;\n\n  width: 0;\n  height: 0;\n\n  border-top: 10px solid #008c49;\n  border-bottom: 10px solid #008c49;\n  border-right: 9px solid transparent;\n}\n\n/* Inner spacing */\n.turcy-deal-card__content {\n  padding: 11px 11px 9px;\n}\n\n.turcy-deal-card__top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.turcy-deal-card__info {\n  min-width: 0;\n}\n\n.turcy-deal-card__offer {\n  margin: 0 0 7px;\n  color: #073f24;\n  font-size: 12px;\n  line-height: 1.25;\n  font-weight: 500;\n}\n\n.turcy-deal-card__offer span {\n  font-weight: 600;\n}\n\n.turcy-deal-card__condition {\n  color: #4c6d58;\n  font-size: 10px;\n  line-height: 1.25;\n}\n\n.turcy-deal-card__note {\n  margin: 3px 0 0;\n  color: #6d8977;\n  font-size: 8px;\n  line-height: 1.3;\n}\n\n/* Coupon */\n.turcy-coupon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n\n  min-width: 88px;\n  min-height: 24px;\n  padding: 4px 7px;\n\n  border: 1px dashed #00a859;\n  background: #ffffff;\n  color: #008c49;\n\n  font-family: inherit;\n  font-size: 8px;\n  font-weight: 600;\n  line-height: 1;\n\n  cursor: pointer;\n}\n\n.turcy-coupon svg {\n  width: 11px;\n  height: 11px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.5;\n}\n\n.turcy-coupon:hover {\n  background: #f1fff6;\n}\n\n.turcy-coupon.is-copied {\n  background: #00a859;\n  color: #ffffff;\n}\n\n.turcy-coupon--plain {\n  cursor: default;\n  border-color: #dce84f;\n  color: #073f24;\n  background: #fbffe8;\n}\n\n/* Tablet */\n@media screen and (max-width: 749px) {\n  .turcy-deals {\n    margin: 8px 0;\n  }\n\n  .turcy-deals__heading {\n    padding: 6px 10px;\n  }\n\n  .turcy-deals__list {\n    display: flex;\n    gap: 8px;\n    padding: 19px 10px 10px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scrollbar-width: none;\n  }\n\n  .turcy-deals__list::-webkit-scrollbar {\n    display: none;\n  }\n\n  .turcy-deal-card {\n    flex: 0 0 86%;\n    scroll-snap-align: start;\n  }\n\n  .turcy-deal-card__content {\n    padding: 11px 10px 9px;\n  }\n}\n\n@media screen and (max-width: 380px) {\n  .turcy-deal-card {\n    flex-basis: 92%;\n  }\n\n  .turcy-deal-card__top {\n    gap: 6px;\n  }\n\n  .turcy-coupon {\n    min-width: 80px;\n    font-size: 7.5px;\n  }\n}\n</style>\n\n<script>\nfunction copyTurcyCoupon(button, code) {\n  if (!navigator.clipboard) return;\n\n  navigator.clipboard.writeText(code).then(function () {\n    const label = button.querySelector('span');\n    const original = label.textContent;\n\n    button.classList.add('is-copied');\n    label.textContent = 'COPIED';\n\n    setTimeout(function () {\n      button.classList.remove('is-copied');\n      label.textContent = original;\n    }, 1500);\n  });\n}\n</script>"
