er-spacing: 0.3px;\n  }\n\n  @media (max-width: 767px) {\n    .offer-section {\n      max-width: 100%;\n    }\n\n    .offer-heading {\n      font-size: 13px;\n      margin-bottom: 8px;\n    }\n\n    .offer-main {\n      gap: 10px;\n      padding: 12px 12px 10px;\n    }\n\n    .offer-icon {\n      font-size: 18px;\n    }\n\n    .offer-line {\n      font-size: 13px;\n    }\n\n    .offer-footer {\n      font-size: 12px;\n      padding: 10px 12px;\n    }\n\n    .offer-top-tag {\n      font-size: 11px;\n      padding: 4px 8px;\n    }\n  }\n</style>"
