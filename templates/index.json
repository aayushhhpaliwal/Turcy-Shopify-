    "turcy_premium_faq_PnG7q6": {
      "type": "turcy-premium-faq",
      "blocks": {
        "faq_6pXHtE": {
          "type": "faq",
          "settings": {
            "question": "How should I choose my first Turcy product?",
            "answer": "<p>Start with your primary need. Choose a cleanser for daily maintenance, salicylic acid for oil and congestion, Vitamin C and niacinamide for a glow-focused routine, moisturiser or aloe for hydration, sunscreen for morning protection, or rosemary spray for scalp care.</p>",
            "open_by_default": true
          }
        },
        "faq_naPkyC": {
          "type": "faq",
          "settings": {
            "question": "Can I use every active product together?",
            "answer": "<p>Introduce active products gradually rather than using several new formulas at once. Patch test where appropriate and follow the usage instructions printed on the final product packaging.</p>",
            "open_by_default": false
          }
        },
        "faq_KiHteh": {
          "type": "faq",
          "settings": {
            "question": "What is the correct skincare order?",
            "answer": "<p>A simple order is cleanser, treatment or serum, moisturiser and sunscreen in the morning. Aloe vera gel may be added as a lightweight soothing layer depending on your routine.</p>",
            "open_by_default": false
          }
        },
        "faq_wiQbcC": {
          "type": "faq",
          "settings": {
            "question": "Are the product images shown here final?",
            "answer": "<p>Use final, accurate and high-resolution product photography before publishing the storefront. Stock or concept images should be replaced with official Turcy packaging images.</p>",
            "open_by_default": false
          }
        },
        "faq_hrqpPx": {
          "type": "faq",
          "settings": {
            "question": "Where should final safety information appear?",
            "answer": "<p>Display the complete ingredient list, usage directions, warnings, net quantity, manufacturer details, batch information and expiry information on the product page and packaging as required.</p>",
            "open_by_default": false
          }
        }
      },
      "block_order": [
        "faq_6pXHtE",
        "faq_naPkyC",
